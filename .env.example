# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─────────────────────────────────────────────────────────
# FIREBASE (obligatorio)
# ─────────────────────────────────────────────────────────
# Se leen en src/lib/firebase.ts. Se pueden pegar tal cual desde
# Firebase Console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────
# LOGIN CON GITHUB (opcional)
# ─────────────────────────────────────────────────────────
# Client id de la GitHub App (Settings → General). Sin esto,
# el botón de GitHub avisa de que no está configurado.
VITE_GITHUB_CLIENT_ID=

# ─────────────────────────────────────────────────────────
# IMÁGENES (opcional)
# ─────────────────────────────────────────────────────────
# Proveedor por defecto de las imágenes de la comunidad
# (comentarios, hilos, wiki). Si no se pone ninguna, se usa
# Firebase Storage, que es lo recomendado: aquí no hay ninguna
# clave secreta expuesta en el navegador.
#   storage -> Firebase Storage (gratis, recomendado)
#   imgbb   -> ImgBB (gratis, pero la clave acaba en el bundle)
VITE_IMGBB_API_KEY=

# ─────────────────────────────────────────────────────────
# GIFs EN LOS COMENTARIOS (opcional)
# ─────────────────────────────────────────────────────────
# Sin ninguna de estas tres, el botón "GIF" avisa de que la
# web todavía no tiene proveedor configurado en vez de fingir
# que no hay resultados.
#
# Opción A (RECOMENDADA): la Cloud Function como intermedia.
# La clave se queda en el servidor y nunca llega al navegador.
#   1. Pon TENOR_API_KEY=... en functions/.env (no se versiona)
#   2. VITE_TENOR_PROXY=1
#   3. npm --prefix functions run deploy
#
# Opción B: GIPHY directo desde el navegador. La clave pública
# de GIPHY está pensada para ir en el cliente, pero quien la
# tenga ve la consola de Firebase de tu proyecto.
# VITE_GIPHY_API_KEY=
#
# Opción C: Tenor directo (hay que registrar la app para sacar
# la clave).
# VITE_TENOR_API_KEY=
VITE_GIPHY_API_KEY=
VITE_TENOR_API_KEY=
VITE_TENOR_PROXY=
