node_modules/
build/
dist/
coverage/
_DS_Store
*.log
.env*
!.env.example

# Salida compilada de las Cloud Functions. El codigo si se versiona
# (functions/src), lo que genera tsc no.
functions/lib/

# Reglas sin comentarios que genera scripts/build-reglas.mjs. El
# compilador de Firestore cuenta los comentarios y firestore.rules
# supera el limite de 256 KiB; se regenera antes de cada despliegue.
firestore.deploy.rules

# Copias locales de migraciones de datos (contienen uids reales).
docs/auditoria/backups/

# Cache local del emulador y del CLI (la crea `npm run test:rules`).
.firebase/

# Respuestas cacheadas de la API de AniList. Se regeneran solas y
# caducan a las 24 horas (ver `scripts/anilist.mjs`).
scripts/.cache-anilist/

# Lo mismo para `scripts/rellenar-alias.mjs` (TTL de 7 días).
scripts/.cache-alias/

# Miniaturas de capitulo bajadas para revisarlas a ojo. Se regeneran
# solas con scripts/mirar-miniaturas.mjs y no se suben.
scripts/.miniaturas/

# Índice de búsqueda generado en `prebuild` a partir del catálogo
# público. Se sirve como archivo estático, pero no se versiona: en
# cada build se regenera con los datos actuales.
public/busqueda/indice.json
public/busqueda/animes.json
public/busqueda/temporadas.json
public/busqueda/streaming.json

# Copia de seguridad local de src/ (creada antes de migrar a Firestore)
_backup/
