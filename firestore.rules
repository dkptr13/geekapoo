rules_version = '2';

// Forzar redespliegue: incluye chatApariencia.
service cloud.firestore {
  match /databases/{database}/documents {

    // ======================================================
    // FUNCIONES AUXILIARES
    // ======================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Perfil del usuario autenticado (null si no existe documento)
    function myDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return hasProfile() ? myDoc().data.role : null;
    }

    // Forma mínima de una fila de disponibilidad regional. El
    // catálogo es público, pero solo el equipo puede escribir en
    // él. La comprobación evita que una escritura accidental deje
    // una fila sin obra, plataforma, región o estado.
    function disponibilidadRegionalValida() {
      return request.resource.data.animeId is string
             && request.resource.data.animeId.size() > 0
             && request.resource.data.platformId is string
             && request.resource.data.platformId.size() > 0
             && request.resource.data.region is string
             && request.resource.data.region.size() >= 2
             && request.resource.data.status in
                ['available', 'unavailable', 'unverified'];
    }

    function plataformaStreamingValida() {
      return request.resource.data.name is string
             && request.resource.data.name.size() >= 2
             && request.resource.data.name.size() <= 80;
    }

    function regionStreamingValida() {
      return request.resource.data.name is string
             && request.resource.data.name.size() >= 2
             && request.resource.data.name.size() <= 80;
    }

    // ── BANEOS: DOS FUENTES Y UNA SOLA VERDAD ──────────────
    //
    // El estado de sanción vive en DOS sitios, a propósito:
    //
    //   1. `users/{uid}.isBanned` es la COPIA VISIBLE: la pinta el
    //      panel y la lee la app para enseñar el aviso.
    //   2. `accountRestrictions/{uid}` es el REGISTRO DURADERO.
    //      Solo lo escriben las Cloud Functions con el Admin SDK;
    //      el cliente no puede crearlo, editarlo ni borrarlo.
    //
    // El registro es el que manda en las reglas. Sin él, a un
    // baneado le bastaba con borrar su documento de `users/{uid}`
    // y volver a entrar: la app le creaba un perfil nuevo con
    // `isBanned: false` y el baneo desaparecía. Ahora el registro
    // sobrevive al perfil y la cuenta sigue sin poder escribir.
    //
    // Importante: hay que comparar con "== true" y no con "!= true".
    // Un campo ausente vale null, y en las reglas de seguridad
    // "null != true" es false (no true), así que un usuario sin campo
    // isBanned quedaría bloqueado por error.
    //
    // Y además hay que comprobar que la clave exista antes de
    // leerla con punto. El comentario de arriba daba a entender que
    // leer un campo que no existe devuelve null, y no es así: en las
    // reglas de seguridad, acceder a una clave ausente de un mapa
    // lanza un error de evaluación ("Property isBanned is undefined
    // on object") y la regla entera falla con PERMISSION_DENIED.
    //
    // No se puede usar "data.get('isBanned', false)" para sortearlo:
    // el "get" de las reglas solo acepta la clave, sin valor por
    // defecto, así que pasaría dos argumentos y es un error de
    // sintaxis. La forma buena es comprobar antes con "in".
    function miRestriccion() {
      return get(/databases/$(database)/documents/accountRestrictions/$(request.auth.uid));
    }

    // ¿Hay un baneo VIGENTE en el registro duradero?
    //
    // `activo` lo pone y lo quita la Cloud Function. El `tipo` deja
    // sitio a otras restricciones futuras (por ejemplo, un silencio
    // global) sin que bloqueen todo como un baneo.
    function restriccionActiva() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/accountRestrictions/$(request.auth.uid))
             && 'activo' in miRestriccion().data
             && miRestriccion().data.activo == true
             && 'tipo' in miRestriccion().data
             && miRestriccion().data.tipo == 'ban';
    }

    function tieneRestriccion() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/accountRestrictions/$(request.auth.uid));
    }

    function isBanned() {
      // Si existe registro duradero, manda él, aunque esté
      // levantado. La bandera pública solo cubre cuentas que aún
      // no se han migrado. Si no, un desbaneo dejaría de funcionar
      // en cuanto el perfil antiguo conservara `isBanned: true`.
      return tieneRestriccion()
             ? restriccionActiva()
             : (hasProfile()
                && 'isBanned' in myDoc().data
                && myDoc().data.isBanned == true);
    }

    // Un usuario baneado puede leer, pero no escribir contenido.
    //
    // Además de no estar baneado, TIENE QUE EXISTIR su perfil: una
    // cuenta de Firebase Auth sin documento en `users` no es un
    // usuario de la comunidad y no puede publicar nada. Antes esta
    // función solo miraba "no está baneado", e `isBanned()` daba
    // false cuando el perfil no existía, así que una cuenta sin
    // perfil podía escribir hilos, comentarios, follows y demás.
    function isActive() {
      return isSignedIn() && hasProfile() && !isBanned();
    }

    // El rol NO basta: una cuenta baneada conserva su documento y su
    // `role`, así que sin `isActive()` un admin o moderador baneado
    // seguía leyendo datos privados y cambiando roles. Las Cloud
    // Functions ya lo comprobaban (`exigirAdmin`); las reglas no.
    function isAdmin() {
      return isActive() && myRole() == 'admin';
    }

    function isModerator() {
      return isActive() && (myRole() == 'admin' || myRole() == 'moderator');
    }

    // Código NUEVO de invitación a un grupo.
    //
    // El formato lo garantiza la regla; la aleatoriedad, el cliente,
    // que lo genera con `crypto.getRandomValues` (48 bits). Un código
    // antiguo de dos bloques (`GRP-XXXX-XXXX`) se sigue pudiendo
    // consultar, pero no se acepta al crear: así no se pueden colar
    // códigos cortos o fáciles de adivinar.
    function codigoDeGrupoNuevoValido(c) {
      return c is string
             && c.matches('^GRP-[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{4}$');
    }

    // Datos del chat PADRE.
    //
    // Imprescindible para las subcolecciones: dentro de
    // "chats/{id}/messages/{id}", la variable "resource" es el
    // MENSAJE, que no tiene campo memberIds. Si isChatMember()
    // mirara resource, daría false en todos los mensajes y no se
    // podría ni leer ni enviar nada. Hay que leer el documento
    // del chat, que es quien guarda la lista de miembros.
    function chatData(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    function chatExiste(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId));
    }

    /**
     * Miembro del chat Y, si es un chat de club, del club.
     *
     * La lista `memberIds` del chat se limpia al salir o ser
     * expulsado, pero hasta que el trigger termina (o si alguien
     * escribe el documento del club a mano) podía quedar acceso
     * residual. Las subcolecciones de un chat conocen su `chatId`
     * por la ruta, así que este `get` es seguro también en las
     * consultas `list` de mensajes.
     */
    function isChatMember(chatId) {
      return isSignedIn()
             && request.auth.uid in chatData(chatId).memberIds
             && (chatData(chatId).type != 'club'
                 || (chatData(chatId).slug is string
                     && exists(/databases/$(database)/documents/clubs/$(chatData(chatId).slug))
                     && request.auth.uid in
                          get(/databases/$(database)/documents/clubs/$(chatData(chatId).slug))
                            .data.memberIds));
    }

    function isChatOwner(chatId) {
      return isSignedIn() && chatData(chatId).ownerId == request.auth.uid;
    }

    /**
     * Moderador del club cuyo chat grupal es este.
     *
     * Hace falta porque un moderador que no es el dueño del
     * chat (el chat lo crea el propietario del club) tiene
     * que poder aceptar solicitudes y expulsar miembros, y
     * las dos cosas se hacen tocando `chat.memberIds`.
     *
     * Se busca el club por el `slug` que guarda el chat y no
     * por el id: así un chat privado o un grupo normal nunca
     * entra por aquí. Si el chat no es de tipo 'club' la
     * función da false sin más.
     */
    function esModeradorClubDeChat(chatId) {
      // Sin `let` ni retornos tempranos a propósito: dentro de una
      // ruta Firestore solo se interpola un CAMPO del recurso
      // (`$(chatData(chatId).slug)`), nunca una variable de
      // reglas. Por eso el club se busca siempre por su slug
      // completo en vez de por una variable intermedia.
      return isSignedIn()
             && chatData(chatId).type == 'club'
             && chatData(chatId).slug is string
             && exists(/databases/$(database)/documents/clubs/$(chatData(chatId).slug))
             && request.auth.uid in
                  get(/databases/$(database)/documents/clubs/$(chatData(chatId).slug))
                    .data.memberIds
             // Igual que `esModeradorClub`: el admin también
             // modera el chat, y sin esta rama no podría borrar ni
             // un mensaje molesto.
             && (get(/databases/$(database)/documents/clubs/$(chatData(chatId).slug))
                   .data.ownerId == request.auth.uid
                 || request.auth.uid in
                    get(/databases/$(database)/documents/clubs/$(chatData(chatId).slug))
                      .data.moderatorIds
                 || ('adminIds' in
                        get(/databases/$(database)/documents/clubs/$(chatData(chatId).slug))
                          .data
                     && get(/databases/$(database)/documents/clubs/$(chatData(chatId).slug))
                          .data.adminIds is list
                     && request.auth.uid in
                          get(/databases/$(database)/documents/clubs/$(chatData(chatId).slug))
                            .data.adminIds));
    }

    // Los contadores de "me gusta" y de comentarios los mantiene
    // SOLO la Cloud Function con el Admin SDK. Ningún cliente
    // (tampoco el equipo) puede escribirlos: si el mismo que pinta
    // el número puede cambiarlo, el número no vale nada.
    //
    // En la creación sí se aceptan los valores iniciales en cero,
    // para que un cliente antiguo que aún los mande no se rompa.
    // Lo que no se acepta nunca es un valor distinto de cero.
    function sinContadoresDeEngagement() {
      return !request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasAny(['likedBy', 'likesCount', 'commentsCount']);
    }

    // En el catálogo los "me gusta" siguen siendo del cliente (no
    // tienen subcolección), pero `commentsCount` también es del
    // servidor: lo mueve `onCommentCreated`/`onCommentDeleted`.
    function sinContadorDeComentarios() {
      return !request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasAny(['commentsCount']);
    }

    /**
     * Los agregados de la wiki (visitas y puntuacion) no se pueden
     * tocar desde ningun cliente, ni siquiera con rol de admin. Los
     * actualizan solo las Cloud Functions con el Admin SDK.
     */
    function sinEstadisticasWiki() {
      return !request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasAny(['viewsCount', 'communityRatingSum',
                        'communityRatingCount', 'communityRatingAvg']);
    }

    /**
     * Un anime nuevo puede nacer con las estadisticas a cero para que
     * los rankings no lo dejen fuera, pero nunca con valores
     * inventados.
     */
    function estadisticasWikiEnCero() {
      return (!('viewsCount' in request.resource.data)
              || (request.resource.data.viewsCount is number
                  && request.resource.data.viewsCount == 0))
             && (!('communityRatingSum' in request.resource.data)
                 || (request.resource.data.communityRatingSum is number
                     && request.resource.data.communityRatingSum == 0))
             && (!('communityRatingCount' in request.resource.data)
                 || (request.resource.data.communityRatingCount is number
                     && request.resource.data.communityRatingCount == 0))
             && (!('communityRatingAvg' in request.resource.data)
                 || (request.resource.data.communityRatingAvg is number
                     && request.resource.data.communityRatingAvg == 0));
    }

    // Un "me gusta" del catálogo es un cambio de UN solo uid: el de
    // quien escribe. No se puede añadir ni quitar a otra persona, y
    // el contador tiene que ser exactamente el tamaño de la lista.
    //
    // Es la misma garantía que da la subcolección de hilos y
    // comentarios, pero sin subcolección: el catálogo guarda el
    // agregado en el propio documento porque la wiki lo lee al
    // pintar la ficha.
    function cambioDeUnSoloLike() {
      return (request.resource.data.likedBy
                == resource.data.get('likedBy', []).concat([request.auth.uid])
              && !(request.auth.uid in resource.data.get('likedBy', [])))
             ||
             (request.resource.data.likedBy
                == resource.data.get('likedBy', []).removeAll([request.auth.uid])
              && request.auth.uid in resource.data.get('likedBy', []));
    }

    // Animes, episodios y personajes: contador `likesCount`.
    function likeDelCatalogoValido() {
      return isActive()
             && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['likedBy', 'likesCount'])
             && request.resource.data.likedBy is list
             && request.resource.data.likedBy.size() <= 100000
             && request.resource.data.likesCount is number
             && request.resource.data.likesCount
                  == request.resource.data.likedBy.size()
             && cambioDeUnSoloLike();
    }

    // La trivia llama `likes` a su contador, no `likesCount`.
    function likeDeTriviaValido() {
      return isActive()
             && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['likedBy', 'likes'])
             && request.resource.data.likedBy is list
             && request.resource.data.likedBy.size() <= 100000
             && request.resource.data.likes is number
             && request.resource.data.likes
                  == request.resource.data.likedBy.size()
             && cambioDeUnSoloLike();
    }

    // ======================================================
    // ENCUESTAS
    // ======================================================
    //
    // La configuración de la encuesta vive DENTRO del hilo
    // ("threads/{id}.poll"), sin contadores. Los votos van en
    // "threads/{id}/pollVotes/{uid}", un documento por persona.
    //
    // Que las opciones sean un MAPA (id → texto) y no una lista
    // es lo que permite comprobarlas aquí: con un mapa, un `in`
    // dice si el id del voto es una opción de verdad. Con una
    // lista, el cliente tendría que escribir los votos de cada
    // opción y las reglas no pueden contrastar ese número con el
    // voto que se está creando.
    //
    // Lo que queda fuera del alcance del cliente:
    //
    //   - Los contadores. No hay ninguno que escribir: se cuentan
    //     los documentos de `pollVotes`. El resumen agregado
    //     (`pollStats/{threadId}`) lo calcula la Cloud Function y
    //     aquí está bloqueado con `allow write: if false`. La
    //     tarjeta ya NO cuenta los votos en el cliente: solo puede
    //     leer el suyo y el resumen.
    //
    //   - Votar dos veces. El id del voto es el uid, así que el
    //     segundo intento choca contra el documento existente, y
    //     no hay `allow delete`: nadie puede deshacer su voto ni
    //     liberating el sitio para volver a usarlo.
    //
    //   - Cambiar de opinión sin permiso. El `update` solo se
    //     concede si el autor activó `allowChangeVote`.
    //
    //   - Votar en una encuesta cerrada o caducada. Se mira
    //     `isClosed` y `expiresAt` contra la hora del servidor
    //     (`request.time`), no contra la del navegador.

    function pollDelHilo(threadId) {
      return get(/databases/$(database)/documents/threads/$(threadId)).data.poll;
    }

    function hayPoll(threadId) {
      return 'poll' in get(/databases/$(database)/documents/threads/$(threadId)).data
             && pollDelHilo(threadId) is map;
    }

    /**
     * Una encuesta abierta: existe, no está cerrada y no ha caducado.
     *
     * `expiresAt` y `allowChangeVote` se miran con la forma
     * `('campo' in mapa)` porque EN LAS REGLAS leer una clave que
     * no existe LANZA un error de evaluación ("Property
     * expiresAt is undefined on object") y la regla entera falla
     * con PERMISSION_DENIED. Y no se puede escribir
     * `data.get('expiresAt', ...)` para esquivarlo: el `get` de
     * las reglas solo acepta la clave, sin valor por defecto.
     *
     * Esto no es un caso rarísimo: las encuestas creadas antes de
     * que existiera la caducidad (y las que seedea el panel) no
     * tienen `expiresAt`, y con la comprobación ingenua no se
     * podría ni votar en ellas.
     */
    function pollAbierto(threadId) {
      return hayPoll(threadId)
             && pollDelHilo(threadId).isClosed == false
             && (!('expiresAt' in pollDelHilo(threadId))
                 || pollDelHilo(threadId).expiresAt == null
                 || pollDelHilo(threadId).expiresAt > request.time);
    }

    /** Permite cambiar de opinión (solo se mira si ya hay voto). */
    function pollCambiaVotos(threadId) {
      return hayPoll(threadId)
             && ('allowChangeVote' in pollDelHilo(threadId))
             && pollDelHilo(threadId).allowChangeVote == true;
    }

    /**
     * Que lo único que cambia al editar un hilo sea el cierre de
     * su encuesta.
     *
     * Necesario porque `affectedKeys()` no siempre informa igual:
     * según cómo se escriba, un `poll.isClosed` puede aparecer
     * como "poll.isClosed" o como "poll" entero. Aceptar "poll"
     * sin más dejaría que el autor reescribiera las opciones
     * (y con ellas los ids que ya tienen votos apuntando), así
     * que aquí se compara el resto de la encuesta campo a campo.
     */
    function pollSoloCambiaIsClosed(threadId) {
      return hayPoll(threadId)
             && request.resource.data.poll is map
             && request.resource.data.poll.question == pollDelHilo(threadId).question
             && request.resource.data.poll.options == pollDelHilo(threadId).options
             && (('allowChangeVote' in request.resource.data.poll)
                 == ('allowChangeVote' in pollDelHilo(threadId)))
             && (!('allowChangeVote' in request.resource.data.poll)
                 || request.resource.data.poll.allowChangeVote
                    == pollDelHilo(threadId).allowChangeVote)
             && (('expiresAt' in request.resource.data.poll)
                 == ('expiresAt' in pollDelHilo(threadId)))
             && (!('expiresAt' in request.resource.data.poll)
                 || request.resource.data.poll.expiresAt
                    == pollDelHilo(threadId).expiresAt)
             && request.resource.data.poll.isClosed is bool
             && request.resource.data.poll.isClosed
                != pollDelHilo(threadId).isClosed;
    }

    /**
     * Forma válida de una encuesta al CREAR el hilo.
     *
     * No se puede comprobar el tamaño de cada texto del mapa (las
     * reglas no recorren mapas), pero sí el número de opciones, que
     * es lo que de verdad protege: sin tope, un mapa con mil
     * entradas se colaría en el documento.
     */
    function pollValido(p) {
      return p is map
             && p.question is string
             && p.question.size() > 0
             && p.question.size() <= 160
             && p.options is map
             && p.options.size() >= 2
             && p.options.size() <= 10
             && p.isClosed == false
             && (!('allowChangeVote' in p)
                 || p.allowChangeVote is bool)
             && (!('expiresAt' in p)
                 || p.expiresAt == null
                 || p.expiresAt is timestamp);
    }

    /**
     * Forma válida de una tier list al CREARLA o EDITARLA.
     *
     * Como en `pollValido`, no se comprueba el texto de cada
     * nivel o elemento (las reglas no recorren mapas), pero sí
     * los tamaños y los campos que deciden permisos: sin tope
     * o sin `visibility` válida, el documento serviría para
     * colar datos arbitrarios o para exponer contenido de club.
     */
    function tierValido(t) {
      return t.title is string
             && t.title.size() > 0
             && t.title.size() <= 80
             && t.description is string
             && t.description.size() <= 500
             && t.category in ['anime-manga', 'videojuegos', 'cosplay-fanart',
                               'cultura-japonesa', 'tecnologia-programacion', 'otros']
             && t.tiers is map
             && t.tiers.size() >= 1
             && t.tiers.size() <= 12
             && t.items is map
             && t.items.size() >= 1
             && t.items.size() <= 100
             && t.placement is map
             && t.poolOrder is map
             && t.visibility in ['public', 'club']
             && (t.visibility == 'public'
                 || (('clubId' in t) && t.clubId is string && t.clubId.size() > 0))
             && t.voting is map
             && t.voting.enabled is bool
             && t.voting.allowChange is bool
             && (!('coverUrl' in t)
                 || (t.coverUrl is string && t.coverUrl.size() <= 1000))
             && (!('originId' in t)
                 || (t.originId is string && t.originId.size() <= 150))
             && (!('originTitle' in t)
                 || (t.originTitle is string && t.originTitle.size() <= 80))
             && (!('threadId' in t)
                 || (t.threadId is string && t.threadId.size() <= 150));
    }

    /**
     * Referencia compacta que viaja en hilos y mensajes.
     *
     * Solo forma (id y título acotados): que la tier list
     * exista y se pueda leer lo comprueba el cliente al
     * pintarla, enseñando "ya no disponible" si no.
     */
    function tierRefValida(r) {
      return r is map
             && r.tierListId is string
             && r.tierListId.size() > 0
             && r.tierListId.size() <= 150
             && (!('title' in r)
                 || (r.title is string && r.title.size() <= 160));
    }

    function tierExiste(tierId) {
      return exists(/databases/$(database)/documents/tierlists/$(tierId));
    }

    function datosTier(tierId) {
      return get(/databases/$(database)/documents/tierlists/$(tierId)).data;
    }

    /** Niveles de la tier list (mapa id → definición). */
    function tiersDeTier(tierId) {
      return datosTier(tierId).tiers;
    }

    /** Se puede votar: existe y el autor activó la votación. */
    function tierVotable(tierId) {
      return tierExiste(tierId)
             && 'voting' in datosTier(tierId)
             && datosTier(tierId).voting.enabled == true;
    }

    /** Se puede cambiar de nivel (solo se mira si ya hay voto). */
    function tierPermiteCambio(tierId) {
      return tierVotable(tierId)
             && 'allowChange' in datosTier(tierId).voting
             && datosTier(tierId).voting.allowChange == true;
    }

    /**
     * Quién puede ver una tier list (y sus votos).
     *
     * Pública para cualquiera; de club solo para sus
     * miembros; las propias siempre para su autor. Un
     * documento que no existe o sin `visibility` no lo ve
     * nadie: el error de evaluación deniega, que es lo seguro.
     */
    function tierLegible(tierId) {
      return tierExiste(tierId)
             && (datosTier(tierId).visibility == 'public'
                 || (isSignedIn() && datosTier(tierId).authorId == request.auth.uid)
                 || (isSignedIn() && datosTier(tierId).visibility == 'club'
                     && 'clubId' in datosTier(tierId)
                     && esMiembroClub(datosTier(tierId).clubId)));
    }

    // ======================================================
    // ENCUESTAS EN LOS CHATS
    // ======================================================
    //
    // El mismo modelo que las encuestas de los hilos, pero
    // colgando de un mensaje: la configuración viaja dentro
    // del documento (`messages/{id}.poll`) y los votos van en
    // `messages/{id}/pollVotes/{uid}`, un documento por
    // persona. Sin contadores y sin resumen del servidor: los
    // votos se cuentan en el cliente, que es la verdad.
    //
    // Solo vota quien es miembro del chat, y solo cierra el
    // autor del mensaje (o un moderador del club, en chats de
    // club). Todo lo demás sigue igual: el autor NO puede
    // editar el texto de su mensaje desde el cliente.
    // ======================================================

    function pollDelMensaje(chatId, messageId) {
      return get(/databases/$(database)/documents/chats/$(chatId)/messages/$(messageId)).data.poll;
    }

    function hayPollMensaje(chatId, messageId) {
      return exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(messageId))
             && 'poll' in get(/databases/$(database)/documents/chats/$(chatId)/messages/$(messageId)).data
             && pollDelMensaje(chatId, messageId) is map;
    }

    /**
     * Una encuesta abierta: existe, no está cerrada y no ha caducado.
     *
     * Igual que `pollAbierto` de los hilos: se comprueba que la
     * clave exista antes de leerla, porque leer una clave ausente
     * lanza un error de evaluación y deniega la operación entera.
     */
    function pollMensajeAbierto(chatId, messageId) {
      return hayPollMensaje(chatId, messageId)
             && pollDelMensaje(chatId, messageId).isClosed == false
             && (!('expiresAt' in pollDelMensaje(chatId, messageId))
                 || pollDelMensaje(chatId, messageId).expiresAt == null
                 || pollDelMensaje(chatId, messageId).expiresAt > request.time);
    }

    /** Permite cambiar de opción (solo se mira si ya hay voto). */
    function pollMensajeCambiaVotos(chatId, messageId) {
      return hayPollMensaje(chatId, messageId)
             && ('allowChangeVote' in pollDelMensaje(chatId, messageId))
             && pollDelMensaje(chatId, messageId).allowChangeVote == true;
    }

    /**
     * Que lo único que cambia al cerrar una encuesta sea su cierre.
     *
     * Igual que `pollSoloCambiaIsClosed` de los hilos pero leyendo
     * el mensaje: el resto de la encuesta (pregunta, opciones,
     * caducidad, cambio de voto) tiene que quedar idéntico, o el
     * autor podría reescribir las opciones dejando los votos
     * apuntando a otro lado.
     */
    function pollMensajeSoloCambiaIsClosed() {
      // La actualización ES el mensaje: `resource.data` ya trae la
      // encuesta anterior. Antes se volvía a leer el documento con
      // `get()` hasta diez veces, y una simple actualización de
      // `poll.isClosed` agotaba el límite de expresiones.
      let r = resource.data;
      return 'poll' in r
             && r.poll is map
             && request.resource.data.poll is map
             && request.resource.data.poll.question == r.poll.question
             && request.resource.data.poll.options == r.poll.options
             && (('allowChangeVote' in request.resource.data.poll)
                 == ('allowChangeVote' in r.poll))
             && (!('allowChangeVote' in request.resource.data.poll)
                 || request.resource.data.poll.allowChangeVote
                    == r.poll.allowChangeVote)
             && (('expiresAt' in request.resource.data.poll)
                 == ('expiresAt' in r.poll))
             && (!('expiresAt' in request.resource.data.poll)
                 || request.resource.data.poll.expiresAt
                    == r.poll.expiresAt)
             && request.resource.data.poll.isClosed is bool
             && request.resource.data.poll.isClosed != r.poll.isClosed;
    }

    // ======================================================
    // REACCIONES
    // ======================================================
    //
    // Cada reacción es un documento con un id DETERMINISTA:
    // "reac_<tipo>_<id>_<uid>". Como el documento se llama así
    // siempre, una persona no puede tener dos reacciones a la vez
    // sobre el mismo contenido:(second write crearía el mismo
    // documento y por tanto no sería un segundo voto, sino el
    // mismo. Cambiar de 🔥 a 😂 es un `update`, y quitarlo es un
    // `delete` de ese mismo documento.
    //
    // La comprobación del sufijo (`path.endsWith`) es la que
    // impide falsear el sistema escribiendo con el id de otra
    // persona: sin ella se podrían crear 400 documentos con el
    // mismo `userId` y inflar cualquier recuento.
    //
    // Los contadores (`reactionCounts` del hilo o del comentario)
    // los escribe la Cloud Function con el Admin SDK. Aquí no hay
    // ninguna rama que los incluya en `hasOnly`, así que el
    // cliente no puede tocarlos: ver `onReactionChanged`.

    // El id del documento tiene que ser EXACTAMENTE el que compone
    // el servicio: "reac_<tipo>_<id del objetivo>_<uid>".
    //
    // Comprobar solo que acabe en el uid no bastaría: alguien
    // podría crear "basura_<uid>" apuntando al mismo contenido y
    // salirse con dos reacciones suyas en el recuento. Con el
    // sufijo entero no hay forma de inventarse un id propio para
    // un objetivo que ya tiene reacción.
    //
    // OJO: se compara con el id del documento que captura el
    // comodín `{reactionId}`, NO con la variable global `path`.
    // `path` no existe en el lenguaje de reglas (el emulador la
    // evalúa como null y TODA la regla falla), y se comprobó
    // aquí mismo antes de dar por buena la comprobación.
    function reactionDocDeUid(docId, uid, tipo, objetivoId) {
      return docId == 'reac_' + tipo + '_' + objetivoId + '_' + uid;
    }

    /**
     * El contenido al que se reacciona tiene que existir de verdad.
     *
     * Los mensajes de chat llevan su `chatId` en el documento de la
     * reacción: sin él, las reglas no podrían comprobar que quien
     * reacciona es miembro de ese chat, y cualquiera podría
     * reaccionar a un mensaje de una conversación ajena.
     */
    function objetivoExiste(tipo, objetivoId) {
      return (tipo == 'thread'
              && exists(/databases/$(database)/documents/threads/$(objetivoId)))
          || (tipo == 'comment'
              && exists(/databases/$(database)/documents/comments/$(objetivoId)))
          || (tipo == 'chat_message'
              && existeMensajeDeChat(request.resource.data.chatId, objetivoId));
    }

    /**
     * El objetivo de un comentario existe de verdad.
     *
     * `targetType` es singular ('thread', 'anime', 'episode',
     * 'character') y la colección es plural. Sin esta comprobación,
     * un comentario podía apuntar a un objetivo inventado: no se veía
     * en ninguna parte, pero el trigger pagaba igualmente 5 XP y
     * contaba para las medallas. Era farmeo invisible.
     */
    function objetivoDeComentarioExiste(tipo, objetivoId) {
      return tipo is string
             && objetivoId is string
             && objetivoId.size() > 0
             && ((tipo == 'thread'
                  && exists(/databases/$(database)/documents/threads/$(objetivoId)))
                 || (tipo == 'anime'
                     && exists(/databases/$(database)/documents/animes/$(objetivoId)))
                 || (tipo == 'episode'
                     && exists(/databases/$(database)/documents/episodes/$(objetivoId)))
                 || (tipo == 'character'
                     && exists(/databases/$(database)/documents/characters/$(objetivoId))));
    }

    /** El mensaje existe Y quien escribe es del chat. */
    function existeMensajeDeChat(chatId, messageId) {
      return chatId is string
             && chatId.size() > 0
             && messageId is string
             && messageId.size() > 0
             && isChatMember(chatId)
             && exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(messageId));
    }

    /**
     * ¿Es una reacción a contenido público?
     *
     * Hilos y comentarios se leen sin sesión, igual que el contenido
     * al que reaccionan. Los mensajes de chat NO: una reacción a un
     * mensaje privado también revela que existe una conversación y
     * quién participa en ella.
     */
    function reaccionPublica(d) {
      return 'targetType' in d
             && (d.targetType == 'thread' || d.targetType == 'comment');
    }

    /**
     * Una reacción a un mensaje SOLO la lee quien puede leer el chat.
     *
     * `chatId` no es decorativo: sin él no se puede saber a qué
     * conversación pertenece el mensaje. El `targetId` tiene que ser
     * un mensaje que exista DENTRO de ese chat; así no vale cambiar
     * el chat de una reacción para colarla en otro.
     *
     * No se pide `isActive()`: el chat también deja leer a un
     * miembro baneado (puede seguir leyendo, pero no escribir). Lo
     * que no se puede es leer desde fuera.
     *
     * Cada mensaje comprobado en un listado gasta una lectura de
     * reglas. El cliente consulta como máximo 8 mensajes por vez
     * (`MAX_POR_CONSULTA_CHAT`), que junto con la lectura del chat
     * deja margen bajo el límite de 10 de Firestore.
     */
    function reaccionDeChatAutorizada(d) {
      return 'targetType' in d
             && d.targetType == 'chat_message'
             && 'chatId' in d
             && d.chatId is string
             && d.chatId.size() > 0
             && 'targetId' in d
             && d.targetId is string
             && d.targetId.size() > 0
             && isChatMember(d.chatId)
             && exists(/databases/$(database)/documents/chats/$(d.chatId)/messages/$(d.targetId));
    }

    /**
     * Forma del `chatId` según el tipo de reacción.
     *
     * En hilos y comentarios NO debe existir: son públicos y no
     * tienen por qué llevar pegado el id de una conversación
     * privada. En mensajes es OBLIGATORIO.
     */
    function reaccionTieneChatIdCoherente(d) {
      return (d.targetType == 'chat_message'
              && 'chatId' in d
              && d.chatId is string
              && d.chatId.size() > 0)
          || ((d.targetType == 'thread' || d.targetType == 'comment')
              && !('chatId' in d));
    }

    /**
     * Formato de la clave de reacción.
     *
     * Son más de doscientos emojis (el catálogo está en
     * `src/data/emojis.ts`), así que una lista de literales en un
     * `in [...]` sería ilegible y no se podría mantener. Lo que se
     * exige aquí es el FORMATO: minúsculas, números y guiones
     * bajos, y nada más.
     *
     * Es una comprobación de forma, no de contenido: alguien
     * podría inventarse la clave "inventada" y la regla la
     * aceptaría. Qué pasa entonces es que el cliente no la sabe
     * pintar (no está en el catálogo) y la reacción se descarta
     * al contar, así que una clave inventada ni se ve ni falsea
     * ningún número. El catálogo es el que decide qué emojis
     * existen; las reglas solo se assures de que no se cuela
     * basura.
     */
    function reactionTypeValido(tipo) {
      return tipo is string
             && tipo.size() > 0
             && tipo.size() <= 24
             && tipo.matches('^[a-z0-9_]+$');
    }

    // ======================================================
    // GIFs EN COMENTARIOS
    // ======================================================
    //
    // El GIF no es un archivo: son cuatro datos. Y como el
    // campo `gif.url` lo escribe el cliente, se comprueba que la
    // URL sea de verdad del CDN de GIPHY o de Tenor. Sin esto,
    // el campo serviría para meter cualquier URL (una de
    // rastreo, una de contenido ilegal...) con solo cuatro
    // líneas en la consola. `matches()` es una coincidencia
    // COMPLETA de la expresión regular, no una búsqueda: por eso
    // la URL entera tiene que encajar, y por eso no vale un
    // "https://giphy.com/..." disfrazado.

    function gifValido(g) {
      return g is map
             && g.provider in ['giphy', 'tenor']
             && g.id is string
             && g.id.size() > 0
             && g.id.size() <= 120
             && (!('title' in g)
                 || (g.title is string && g.title.size() <= 200))
             && g.url is string
             && g.url.matches('https://media[0-9]*\\.(giphy|tenor)\\.com/.*')
             && ('previewUrl' in g
                 ? (g.previewUrl is string
                    && g.previewUrl.matches('https://media[0-9]*\\.(giphy|tenor)\\.com/.*'))
                 : true);
    }

    // ======================================================
    // UBICACIONES EN LOS CHATS
    // ======================================================
    //
    // Las coordenadas las escribe el cliente, así que sin comprobar
    // nada el campo serviría para inventarse la posición: alguien
    // podría mandar "estoy en el norte" desde donde quiera y el que
    // lo viera se lo creería.
    //
    // Qué se comprueba:
    //
    //   · Que sean números, no texto. Un "lat: 'no sé'" tiene que
    //     fallar, o el mapa se rompe al pintarlo.
    //   · Que estén en rango: la latitud entre -90 y 90, y la
    //     longitud entre -180 y 180. Cualquier valor fuera es
    //     imposible de verdad, no una posición rara.
    //   · Que la precisión, si viene, no sea absurda. No hace
    //     falta Limitarla a cero.
    //   · Que el nombre del sitio no sea enorme. Es texto libre
    //     que pone el navegador según el sitio donde estés, y sin
    //     tope un campo de 50 KB por mensaje.
    //
    // Lo que NO se comprueba es que la posición sea real. Eso no se
    // puede saber desde una regla, y no se intenta: la marca es de
    // quien la envía, y la interfaz la muestra como tal.
    function ubicacionValida(u) {
      return u is map
             && u.lat is number
             && u.lat >= -90 && u.lat <= 90
             && u.lng is number
             && u.lng >= -180 && u.lng <= 180
             && (!('accuracy' in u)
                 ? true
                 : (u.accuracy is number && u.accuracy >= 0))
             && (!('place' in u)
                 ? true
                 : (u.place is string && u.place.size() <= 200));
    }

    // ======================================================
    // ADJUNTOS EN LOS CHATS
    // ======================================================
    //
    // Qué tiene que llevar un mensaje para no estar vacío. Antes de
    // esto era una condición en línea dentro de la regla del chat,
    // y con tres tipos de adjunto la línea ocupaba media pantalla.
    function tieneAlgo(m) {
      return m.body.size() > 0
             || ('gif' in m)
             || ('location' in m)
             || ('imageUrl' in m)
             || ('poll' in m)
             || ('tierList' in m);
    }

    /**
     * Texto canónico de un mensaje, sin recortar.
     *
     * Es la misma elección que `textoParaCita` en
     * `src/utils/chatCita.ts`: primero el cuerpo (sin espacios en los
     * extremos) y, si no hay, una descripción del adjunto. La cita
     * guarda este texto COMPLETO porque las reglas no pueden recortar
     * cadenas y necesitan compararlo exacto con el mensaje real.
     *
     * Los `is map` no son adorno: un documento antiguo podría tener
     * `poll` o `tierList` con otra forma, y leer `.question` de algo
     * que no es mapa sería un error de evaluación.
     */
    function textoCanonicoDeMensaje(m) {
      let cuerpo = ('body' in m && m.body is string) ? m.body.trim() : '';
      return cuerpo.size() > 0
             ? cuerpo
             : (('imageUrl' in m && m.imageUrl is string && m.imageUrl.size() > 0)
                 ? '[Foto]'
                 : (('gif' in m && m.gif is map)
                     ? 'GIF'
                     : (('location' in m && m.location is map)
                         ? 'Ubicación'
                         : (('poll' in m && m.poll is map)
                             ? (('question' in m.poll
                                 && m.poll.question is string
                                 && m.poll.question.trim().size() > 0)
                                 ? '📊 ' + m.poll.question.trim()
                                 : '📊 Encuesta')
                             : (('tierList' in m && m.tierList is map)
                                 ? (('title' in m.tierList
                                     && m.tierList.title is string
                                     && m.tierList.title.trim().size() > 0)
                                     ? '🏆 ' + m.tierList.title.trim()
                                     : '🏆 Tier list')
                                 : '')))));
    }

    /**
     * La cita copia un mensaje REAL de ESTE chat.
     *
     * Antes `replyTo` solo se validaba como mapa con tres strings: se
     * podía citar un mensaje que nunca existió, atribuírselo a un
     * administrador y ponerle el texto que quisieras. Ahora se lee el
     * mensaje citado y se comparan el autor y el texto canónico.
     *
     * Solo se admiten los tres campos nuevos. `snippet` era el
     * recorte de la vista de las citas antiguas; ya no se escribe.
     */
    function citaCoincideConMensaje(chatId, cita) {
      let m = get(/databases/$(database)/documents/chats/$(chatId)/messages/$(cita.messageId)).data;
      let nombre = ('senderName' in m && m.senderName is string) ? m.senderName : '';

      return cita.messageId is string
             && cita.messageId.size() > 0
             && cita.messageId.size() <= 100
             && cita.keys().hasOnly(['messageId', 'senderName', 'texto'])
             && cita.senderName is string
             && cita.senderName == nombre
             && cita.texto is string
             && cita.texto.size() <= 4000
             && cita.texto == textoCanonicoDeMensaje(m);
    }

    // ======================================================
    // PRIVACIDAD DE LAS SOLICITUDES DE CONVERSACIÓN
    // ======================================================
    // Una cuenta puede estar en "privado" o con las solicitudes
    // apagadas. Se lee del documento de QUIEN RECIBE la solicitud,
    // no del de quien la manda: si se mirara el propio documento,
    // bastaría con no marcar el campo para saltárselo.
    //
    // Para una solicitud de grupo, "toId" es el dueño del grupo,
    // que es quien la acepta, así que es su privacidad la que decide.
    //
    // ── LO QUE FALLA AL LEER UN CAMPO QUE NO ESTÁ ───────────
    //
    // Antes este comentario decía: "Un campo que no está vale null,
    // y en las reglas 'null != private' es true, es decir, se respeta
    // el ajuste por defecto".
    //
    // Eso es FALSO, y por eso no se podía añadir a nadie. En las
    // reglas de Firestore leer un campo que el documento no tiene no
    // devuelve null ni false: lanza un error de evaluación, y el
    // error de evaluación deniega la operación entera. El emulador lo
    // dice con todas las letras:
    //
    //     evaluation error at L867:24 for 'create'
    //     Property profileVisibility is undefined on object.
    //
    // NINGUNA cuenta tenía el campo escrito, así que NINGUNA podía
    // recibir una solicitud. La cuenta que se crea hoy tampoco lo
    // tiene: los ajustes de privacidad no se guardan al crear el
    // usuario, solo cuando alguien los cambia en su perfil.
    //
    // Por eso aquí se comprueba si el campo EXISTE antes de leerlo, con
    // el operador `in`. Es la forma que no falla:
    //
    //     if ('profileVisibility' in d) { ... }
    //
    // Y el resultado es el mismo que en el cliente: `readPrivacy`, en
    // `src/services/accountSettings.ts`, pone 'public' cuando falta
    // el campo y true cuando no es false. Las dos mitades tienen que
    // decir lo mismo, porque si el cliente dice "puedes" y las reglas
    // dicen "no", el usuario ve un botón que no sirve de nada.
    //
    // ── POR QUÉ NO SE COMPRUEBA EL DOCUMENTO PROPIO ───────────
    //
    // Porque entonces bastaría con no marcar el campo para saltarse
    // la privacidad. Se lee el de QUIEN RECIBE, que no puede tocarlo
    // el emisor.
    function acceptsChatRequests(uid) {
      // `get()` solo, no `exists()` + `get()`. Son dos funciones
      // distintas y cada una cuenta como un acceso; con seis accesos
      // aquí, una solicitud de grupo se quedaba sin presupuesto para
      // el chat, el bloqueo y el cupo (el límite es 10 por
      // operación). `get()` devuelve null si el documento no existe.
      let docPerfil = get(/databases/$(database)/documents/users/$(uid));
      let existePerfil = docPerfil != null;
      let perfil = existePerfil ? docPerfil.data : {};

      // El documento privado puede no existir todavía: es el caso
      // de las cuentas anteriores a esta migración. En ese caso se
      // usan las señales públicas antiguas, si las hubiera.
      let docPrivada = get(/databases/$(database)/documents/userPrivate/$(uid));
      let privada = docPrivada != null ? docPrivada.data : {};
      // Un documento privado puede existir antes de la migración
      // porque el usuario guardó solo su apariencia del chat. En ese
      // caso NO tiene mapa `privacy`: hay que seguir usando la copia
      // pública antigua, no ignorarla y dejar todo abierto.
      let tienePrivacidad = 'privacy' in privada && privada.privacy is map;
      let privacidad = tienePrivacidad ? privada.privacy : {};

      let docRestriccion = get(/databases/$(database)/documents/accountRestrictions/$(uid));
      let existeRestriccion = docRestriccion != null;
      let restriccion = existeRestriccion ? docRestriccion.data : {};

      // El destinatario tiene que existir y estar activo. Sin esto,
      // se podían dejar solicitudes contra uids inventados o contra
      // cuentas baneadas que nunca podrían aceptarlas.
      return existePerfil
          // El registro duradero manda desde que existe. La
          // bandera pública solo cubre perfiles aún sin migrar.
          && (existeRestriccion
              ? !(('activo' in restriccion)
                  && restriccion.activo == true
                  && 'tipo' in restriccion
                  && restriccion.tipo == 'ban')
              : !(('isBanned' in perfil) && perfil.isBanned == true))
          // Lo que decide de verdad es el documento privado. El
          // emisor no puede escribirlo: solo su dueño.
          && !(('profileVisibility' in privacidad)
               && privacidad.profileVisibility == 'private')
          && !(('allowChatRequests' in privacidad)
               && privacidad.allowChatRequests == false)
          // Compatibilidad con cuentas sin migrar. Cuando el
          // documento privado tenga ya el mapa `privacy`, los campos
          // públicos viejos se ignoran para que no puedan saltarse
          // la privacidad. Si solo existe por la apariencia del
          // chat, todavía mandan los campos públicos.
          && (tienePrivacidad
              || (!(('profileVisibility' in perfil)
                    && perfil.profileVisibility == 'private')
                  && !(('allowChatRequests' in perfil)
                       && perfil.allowChatRequests == false)));
    }

    /**
     * Nombre visible de un perfil, con la MISMA elección que `nameOf`
     * en el cliente: `displayName || username`.
     *
     * `acceptsChatRequests` ya ha comprobado que el documento del
     * destinatario existe antes de que se llame a esto. Para el
     * emisor, `isActive()` garantiza su perfil.
     */
    function nombreDePerfil(uid) {
      let p = get(/databases/$(database)/documents/users/$(uid)).data;
      return (('displayName' in p
               && p.displayName is string
               && p.displayName.size() > 0)
              ? p.displayName
              : (('username' in p && p.username is string) ? p.username : ''));
    }

    /** Avatar del perfil, tal cual lo copia la solicitud. */
    function avatarDePerfil(uid) {
      let p = get(/databases/$(database)/documents/users/$(uid)).data;
      return ('avatarUrl' in p && p.avatarUrl is string) ? p.avatarUrl : '';
    }

    /**
     * Id determinista de una solicitud.
     *
     * Las reglas lo reconstruyen con los campos del documento. Sin
     * esto, el cliente podía elegir un id nuevo por cada intento y
     * llenar la bandeja del destinatario con documentos distintos.
     */
    function idDeSolicitudCorrecto(requestId) {
      let d = request.resource.data;
      return (d.type == 'direct'
              && requestId == 'direct_' + d.fromId + '_' + d.toId)
             || (d.type == 'group'
                 && requestId == 'group_' + d.groupId + '_' + d.fromId)
             || (d.type == 'invite'
                 && requestId == 'invite_' + d.groupId + '_' + d.fromId + '_' + d.toId);
    }

    /**
     * El nombre y el avatar de una solicitud salen del perfil real.
     *
     * Antes los escribía el cliente y solo se miraba que fueran
     * strings: una solicitud se podía presentar como "Soporte
     * oficial de Geekapoo" con el avatar que quisieras.
     */
    function nombreYAvatarCoinciden(uid, nombre, avatar) {
      return nombre is string
             && nombre.size() <= 60
             && nombre == nombreDePerfil(uid)
             && avatar is string
             && avatar.size() <= 500
             && avatar == avatarDePerfil(uid);
    }

    /**
     * ¿Hay un bloqueo entre quien escribe y otra persona?
     *
     * Se mira en los DOS sentidos. Da igual quién bloqueó a quién:
     * si una de las dos partes no quiere saber nada de la otra, no
     * se puede abrir una solicitud nueva entre ellas. Las solicitudes
     * que ya estuvieran pendientes se pueden rechazar o, en el caso
     * directo, aceptar (que desbloquea); lo que no se puede es
     * seguir creando nuevas.
     *
     * Las listas de bloqueados viven en una subcolección de quien
     * bloquea (`users/{yo}/blocked/{otro}`), así que solo su dueño
     * las escribe. Aquí solo se consultan.
     */
    function hayBloqueoCon(otro) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(otro))
          || exists(/databases/$(database)/documents/users/$(otro)/blocked/$(request.auth.uid));
    }

    /**
     * Un chat DIRECTO entre dos personas donde una bloqueó a la otra.
     *
     * Los bloqueos ya impedían crear o reabrir solicitudes; faltaba
     * el chat que ya existía. En un directo, si hay bloqueo en
     * cualquier sentido, ninguno de los dos puede enviar mensajes
     * nuevos. En grupos y clubes no se aplica: bloquear a una persona
     * no debe silenciar la conversación de todos.
     */
    function bloqueoEnDirecto(chatId) {
      let c = chatData(chatId);
      return c.type == 'direct'
             && c.memberIds is list
             && c.memberIds.size() == 2
             && request.auth.uid in c.memberIds
             && hayBloqueoCon(
                  c.memberIds[0] == request.auth.uid
                    ? c.memberIds[1]
                    : c.memberIds[0]);
    }

    /**
     * ¿Esta transacción consume un hueco del cupo de solicitudes?
     *
     * El cupo es un libro mayor (`rateLimits/{uid}`) con una ventana
     * de 24 h y 20 solicitudes. La gracia de mirar `getAfter()` es
     * que la solicitud y el incremento tienen que ir en la MISMA
     * transacción: si bastara con leer el libro, dos pestañas
     * podrían mandar solicitudes a la vez viendo el mismo contador
     * y el límite no serviría de nada.
     *
     * Aquí NO se lee el estado anterior con `get()`: el emulador (y
     * el servicio real) no sirven un `get()` sobre un documento que
     * la misma transacción está escribiendo; solo `getAfter()`. Por
     * eso la prueba de frescura es `ultimaSolicitud == request.time`:
     * el cliente escribe ese campo con `serverTimestamp()` en la
     * misma transacción, así que si no ha tocado el libro conserva
     * la hora de la solicitud anterior y no coincide.
     *
     * Las transiciones (sumar uno, reiniciar una ventana caducada)
     * las valida la regla de `rateLimits` más abajo. Aquí solo se
     * comprueba el estado resultante.
     */
    function cupoDeSolicitudesConsumido() {
      let ruta = /databases/$(database)/documents/rateLimits/$(request.auth.uid);
      let libro = getAfter(ruta);

      return libro != null
             && libro.data.count is int
             && libro.data.count >= 1
             && libro.data.count <= 20
             && libro.data.windowStart is timestamp
             && libro.data.windowStart <= request.time
             && libro.data.windowStart > request.time - duration.value(24, 'h')
             && libro.data.ultimaSolicitud is timestamp
             && libro.data.ultimaSolicitud == request.time
             // El hueco queda atado a ESTE documento. Sin esto, una
             // transacción podría crear varias solicitudes con un
             // único incremento del libro: todas verían el mismo
             // `getAfter()` y el mismo contador.
             && libro.data.ultimaSolicitudId is string
             && libro.data.ultimaSolicitudId == request.resource.id;
    }

    // ======================================================
    // USERS
    // El usuario puede leer el directorio y editar su propio
    // perfil público. NUNCA puede auto-asignarse el rol admin.
    //
    // Los datos privados (correo, privacidad, apariencia del chat,
    // región) no se escriben aquí: viven en `userPrivate/{uid}`.
    // El estado de sanción tampoco: la fuente de verdad es
    // `accountRestrictions/{uid}` y solo la tocan las callables.
    // Las reglas rechazan esas claves aunque lleguen mezcladas en
    // un update por otro motivo.
    // ======================================================

    // Campos de la gamificacion.
    //
    // Son los que escriben las Cloud Functions con el Admin SDK,
    // que es lo unico que se salta estas reglas. El cliente los
    // LEE, pero no puede escribirlos ni borrarlos.
    //
    //   - xp / level / xpEnNivel / xpParaSiguienteNivel: el progreso
    //   - stats: los contadores que alimentan las medallas
    //   - medals: lo que se ha desbloqueado y cuando
    //   - xpActualizadoAt / lastLevelUpAt / lastLevelUpLevel: las
    //     marcas que usa la interfaz para el aviso de subida
    //
    // Sin esta lista, un usuario podria abrir la consola del
    // navegador y escribirse 999999 XP en su propio documento: las
    // reglas que hay antes solo quitan 'role', 'isBanned',
    // 'chatId' y 'uid', asi que cualquier otro campo pasaria.
    //
    // Los campos de gamificacion que se citan abajo en el 'update'
    // ('xp', 'level', 'xpEnNivel', 'xpParaSiguienteNivel',
    // 'stats', 'medals', 'xpActualizadoAt', 'lastLevelUpAt' y
    // 'lastLevelUpLevel') estan escritos a mano en lugar de usar
    // una funcion, porque "hasAny" exige una lista literal y no
    // acepta una variable.

    // Un titulo equipado solo vale si la medalla esta de verdad
    // desbloqueada en 'medals'.
    //
    // Se compara contra "resource" (el documento ANTES del
    // update) y no contra "request.resource": si se comparara
    // contra el nuevo, bastaria con escribir a la vez
    // "equippedTitle" y "medals" inventando una medalla propia.
    // Leyendo el estado anterior, solo se puede equipar un
    // titulo que ya estaba ganado antes de esta escritura.
    //
    // El campo puede ir en null o desaparecer para quitarse.
    function tituloValido() {
      let yaEsta = resource.data.medals;

      return !('equippedTitle' in request.resource.data)
             || request.resource.data.equippedTitle == null
             || (yaEsta != null
                 && request.resource.data.equippedTitle in yaEsta);
    }

    // ── Personalizacion del perfil ────────────────────
    //
    // Los ids y formatos salen de `src/data/profileCustomization.ts`.
    // Ademas de validar la lista, se comprueba el nivel guardado en
    // el documento (`resource.data.level`, del servidor): un cliente
    // manipulado no puede equiparse un marco o color que aun no ha
    // desbloqueado. El nivel no puede escribirlo el usuario.
    function nivelPerfil() {
      return 'level' in resource.data && resource.data.level is number
        ? resource.data.level
        : 1;
    }

    function colorPermitido(valor) {
      return (valor == '#38bdf8' && nivelPerfil() >= 1)
          || (valor == '#8b5cf6' && nivelPerfil() >= 1)
          || (valor == '#ec4899' && nivelPerfil() >= 3)
          || (valor == '#22d3ee' && nivelPerfil() >= 1)
          || (valor == '#ef4444' && nivelPerfil() >= 8)
          || (valor == '#10b981' && nivelPerfil() >= 5)
          || (valor == '#f59e0b' && nivelPerfil() >= 3)
          || (valor == '#4338ca' && nivelPerfil() >= 12)
          || (valor == '#eab308' && nivelPerfil() >= 10)
          || (valor == '#0284c7' && nivelPerfil() >= 6)
          || (valor == '#71717a' && nivelPerfil() >= 1)
          || (valor == '#7dd3fc' && nivelPerfil() >= 15);
    }

    function marcoPermitido(valor) {
      return (valor == 'ninguno' && nivelPerfil() >= 1)
          || (valor == 'neon' && nivelPerfil() >= 5)
          || (valor == 'dorado' && nivelPerfil() >= 10)
          || (valor == 'oro-imperial' && nivelPerfil() >= 30)
          || (valor == 'plata-celestial' && nivelPerfil() >= 18)
          || (valor == 'cristal-real' && nivelPerfil() >= 12)
          || (valor == 'obsidiana' && nivelPerfil() >= 15)
          || (valor == 'sakura' && nivelPerfil() >= 8)
          || (valor == 'aura-magica' && nivelPerfil() >= 10)
          || (valor == 'dragon' && nivelPerfil() >= 22)
          || (valor == 'celestial' && nivelPerfil() >= 25)
          || (valor == 'llamas' && nivelPerfil() >= 14)
          || (valor == 'espiritu' && nivelPerfil() >= 20)
          || (valor == 'cyberpunk' && nivelPerfil() >= 6)
          || (valor == 'holografico' && nivelPerfil() >= 16)
          || (valor == 'circuito-digital' && nivelPerfil() >= 9)
          || (valor == 'nucleo-energetico' && nivelPerfil() >= 18)
          || (valor == 'galaxia' && nivelPerfil() >= 28)
          || (valor == 'dimensional' && nivelPerfil() >= 32)
          || (valor == 'cristales-flotantes' && nivelPerfil() >= 40)
          || (valor == 'eclipse' && nivelPerfil() >= 24)
          || (valor == 'fenix' && nivelPerfil() >= 35)
          || (valor == 'aura-violeta' && nivelPerfil() >= 26)
          || (valor == 'dorado-imperial' && nivelPerfil() >= 45);
    }

    function bannerPermitido(valor) {
      return (valor == 'preset:defecto' && nivelPerfil() >= 1)
          || (valor == 'preset:ocaso' && nivelPerfil() >= 1)
          || (valor == 'preset:abismo' && nivelPerfil() >= 3)
          || (valor == 'preset:neon' && nivelPerfil() >= 5)
          || (valor == 'preset:cosmos' && nivelPerfil() >= 8)
          || (valor == 'preset:leyenda' && nivelPerfil() >= 10)
          || (valor == 'preset:sakura' && nivelPerfil() >= 5)
          || (valor == 'preset:aurora' && nivelPerfil() >= 12)
          || (valor == 'preset:cyberpunk' && nivelPerfil() >= 14)
          || (valor == 'preset:imperio' && nivelPerfil() >= 25)
          || (valor == 'preset:oceano' && nivelPerfil() >= 9)
          || (valor == 'preset:eclipse' && nivelPerfil() >= 18)
          || (valor == 'preset:galaxia' && nivelPerfil() >= 30)
          || (valor == 'preset:fenix' && nivelPerfil() >= 35)
          || (valor == 'preset:hielo' && nivelPerfil() >= 20)
          || (valor == 'preset:dragon' && nivelPerfil() >= 16)
          || (valor == 'preset:atardecer' && nivelPerfil() >= 10);
    }

    function fondoPermitido(valor) {
      return (valor == 'defecto' && nivelPerfil() >= 1)
          || (valor == 'ocaso' && nivelPerfil() >= 1)
          || (valor == 'abismo' && nivelPerfil() >= 3)
          || (valor == 'neon' && nivelPerfil() >= 5)
          || (valor == 'cosmos' && nivelPerfil() >= 8)
          || (valor == 'leyenda' && nivelPerfil() >= 10)
          || (valor == 'sakura' && nivelPerfil() >= 5)
          || (valor == 'aurora' && nivelPerfil() >= 12)
          || (valor == 'cyberpunk' && nivelPerfil() >= 14)
          || (valor == 'imperio' && nivelPerfil() >= 25)
          || (valor == 'oceano' && nivelPerfil() >= 9)
          || (valor == 'eclipse' && nivelPerfil() >= 18)
          || (valor == 'galaxia' && nivelPerfil() >= 30)
          || (valor == 'fenix' && nivelPerfil() >= 35)
          || (valor == 'hielo' && nivelPerfil() >= 20)
          || (valor == 'dragon' && nivelPerfil() >= 16)
          || (valor == 'atardecer' && nivelPerfil() >= 10);
    }

    function personalizacionValida() {
      let d = request.resource.data;

      return (!('bannerUrl' in d)
              || (d.bannerUrl is string
                  && d.bannerUrl.size() <= 500
                  && (d.bannerUrl == ''
                      || bannerPermitido(d.bannerUrl)
                      || (d.bannerUrl.matches('https://.*') && nivelPerfil() >= 3))))
             && (!('profileColor' in d)
                 || (d.profileColor is string && colorPermitido(d.profileColor)))
             && (!('avatarFrame' in d)
                 || d.avatarFrame == null
                 || (d.avatarFrame is string && marcoPermitido(d.avatarFrame)))
             && (!('favoriteCharacter' in d)
                 || d.favoriteCharacter == null
                 || (d.favoriteCharacter is map
                     && d.favoriteCharacter.name is string
                     && d.favoriteCharacter.name.size() > 0
                     && d.favoriteCharacter.name.size() <= 60
                     && d.favoriteCharacter.imageUrl is string
                     && d.favoriteCharacter.imageUrl.size() <= 500
                     && (d.favoriteCharacter.imageUrl == ''
                         || d.favoriteCharacter.imageUrl.matches('https://.*'))
                     && (!('desc' in d.favoriteCharacter)
                         || (d.favoriteCharacter.desc is string
                             && d.favoriteCharacter.desc.size() <= 140))))
             && (!('favoriteCharacters' in d)
                 || (d.favoriteCharacters is list && d.favoriteCharacters.size() <= 6))
             && (!('profileBackground' in d)
                 || d.profileBackground == null
                 || (d.profileBackground is map
                     && (!('preset' in d.profileBackground)
                         || (d.profileBackground.preset is string
                             && fondoPermitido(d.profileBackground.preset)))
                     && (!('url' in d.profileBackground)
                         || (d.profileBackground.url is string
                             && d.profileBackground.url.size() <= 500
                             && (d.profileBackground.url == ''
                                 || (d.profileBackground.url.matches('https://.*')
                                     && nivelPerfil() >= 3))))
                     && (!('position' in d.profileBackground)
                         || (d.profileBackground.position is string
                             && d.profileBackground.position in ['center', 'top', 'bottom']))
                     && (!('dim' in d.profileBackground)
                         || (d.profileBackground.dim is number
                             && d.profileBackground.dim >= 0
                             && d.profileBackground.dim <= 80))))
             && (!('decorations' in d)
                 || (d.decorations is list && d.decorations.size() <= 6))
             && (!('showcases' in d)
                 || (d.showcases is list && d.showcases.size() <= 6))
             && (!('visibleBadgeIds' in d)
                 || d.visibleBadgeIds == null
                                || (d.visibleBadgeIds is list && d.visibleBadgeIds.size() <= 6))
             && (!('featuredPostIds' in d)
                 || (d.featuredPostIds is list && d.featuredPostIds.size() <= 3));
    }

                     // Edición propia del perfil con un solo `diff()`.
                     //
                     // El `allow update` llamaba a `diff()` cuatro veces y la
                     // evaluación rozaba el límite de 1000 expresiones. Con una
                     // sola llamada sobra presupuesto.
                     //
                     // La personalización solo se revalida si el update la toca:
                     // si no, se revalidaría el documento entero, incluidos datos
                     // heredados de reglas viejas, y un cambio de bio no pasaría
                     // por culpa de otro campo. Sin tocar esos campos no entra
                     // nada nuevo que validar, así que saltarlo no abre nada.
             // Apariencia del chat: validación detallada (ver
             // `data/chatApariencia.ts`).
             //
             // Vive en rama propia y no dentro de
             // `personalizacionValida()`: la evaluación completa
             // rozaba el límite de 1000 expresiones y con la
             // cláusula dentro abortaba hasta un guardado válido.
             function chatAparienciaValida() {
                 let c = request.resource.data.chatApariencia;
                 return c is map
                 && (!('tema' in c) || (c.tema in ['oscuro', 'negro', 'morado', 'claro', 'neon', 'personalizado']))
                 && (!('colorPropio' in c) || (c.colorPropio is string && c.colorPropio.size() == 7))
                 && (!('colorRecibido' in c) || (c.colorRecibido is string && c.colorRecibido.size() == 7))
                 && (!('textoPropio' in c) || (c.textoPropio is string && c.textoPropio.size() == 7))
                 && (!('textoRecibido' in c) || (c.textoRecibido is string && c.textoRecibido.size() == 7))
                 && (!('fondo' in c)
                     || c.fondo == null
                     || (c.fondo is map
                         && (!('preset' in c.fondo) || (c.fondo.preset is string))
                         && (!('url' in c.fondo)
                             || (c.fondo.url is string && c.fondo.url.size() <= 500 && (c.fondo.url == '' || c.fondo.url.matches('https://.*'))))
                         && (!('ajuste' in c.fondo) || (c.fondo.ajuste in ['cover', 'contain']))
                         && (!('position' in c.fondo) || (c.fondo.position in ['center', 'top', 'bottom']))
                         && (!('dim' in c.fondo) || (c.fondo.dim is number && c.fondo.dim >= 0 && c.fondo.dim <= 80))))
                 && (!('forma' in c) || (c.forma in ['redonda', 'suave', 'cuadrada']))
                 && (!('estilo' in c) || (c.estilo in ['moderno', 'compacto']))
                 && (!('letra' in c) || (c.letra in ['pequena', 'normal', 'grande']))
                 && (!('espaciado' in c) || (c.espaciado in ['compacto', 'normal', 'amplio']))
                 && (!('ancho' in c) || (c.ancho in ['estrecho', 'normal', 'ancho']))
                 && (!('reducirMovimiento' in c) || c.reducirMovimiento is bool);
             }

    // ── Documento privado del usuario ─────────────────
    //
    // `userPrivate/{uid}` guarda lo que NO debe estar en el perfil
    // público: correo, ajustes de privacidad, apariencia del chat y
    // región. Solo lo escribe su dueño; un admin puede leerlo para
    // el panel. Las reglas son por documento, así que esta
    // separación física es la que hace que `users/{uid}` pueda
    // seguir siendo legible por todo el mundo sin filtrar nada.
    function privacidadValida() {
      let p = request.resource.data.privacy;
      return p is map
          && p.keys().hasOnly(
               ['profileVisibility', 'allowChatRequests', 'showActivity'])
          && (!('profileVisibility' in p)
              || p.profileVisibility in ['public', 'private'])
          && (!('allowChatRequests' in p)
              || p.allowChatRequests is bool)
          && (!('showActivity' in p)
              || p.showActivity is bool);
    }

    function datosPrivadosValidos() {
      let d = request.resource.data;
      return d.keys().hasOnly(
               ['email', 'privacy', 'chatApariencia',
                'regionPreferida', 'updatedAt'])
          && (!('email' in d)
              || (d.email is string && d.email.size() <= 320))
          && (!('privacy' in d) || privacidadValida())
          && (!('chatApariencia' in d)
              || d.chatApariencia == null
              || chatAparienciaValida())
          && (!('regionPreferida' in d)
              || (d.regionPreferida is string
                  && d.regionPreferida.size() >= 2
                  && d.regionPreferida.size() <= 4))
          && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    // ======================================================
    // DATOS PRIVADOS DEL USUARIO
    // ======================================================
    //
    // `users/{uid}` es público (lo lee cualquiera con sesión para
    // pintar perfiles y directorios). Todo lo que no debe ver el
    // resto vive aquí, en un documento aparte:
    //
    //   email                 correo de contacto
    //   privacy               ajustes completos de privacidad
    //   chatApariencia        colores y fondo del chat
    //   regionPreferida       región de streaming
    //
    // Las reglas de Firestore son por DOCUMENTO, no por campo: si
    // estos datos siguieran dentro de `users`, cualquiera que
    // pudiera leer el perfil podría leerlos. Separarlos es lo que
    // permite mantener el perfil público.
    //
    //   · el dueño puede leer y escribir su documento;
    //   · un admin puede LEER todos (el panel enseña el correo);
    //   · un moderador NO puede leerlos;
    //   · nadie más puede leerlos.
    //
    // `isBanned` no vive aquí: la fuente de verdad es
    // `accountRestrictions/{uid}`.
    match /userPrivate/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isSelf(uid) && datosPrivadosValidos();
      allow delete: if isSelf(uid) || isAdmin();
    }

    // ======================================================
    // REGISTRO DURABLE DE RESTRICCIONES (BANEOS)
    // ======================================================
    //
    // Una colección plana, con el uid como id: un documento por
    // persona, igual que `users`. La escribe SOLO la Cloud Function
    // `banearUsuario` / `desbanearUsuario` con el Admin SDK; las
    // reglas de abajo no dejan escribirla desde el cliente ni
    // siquiera a un administrador.
    //
    // ¿Por qué no vale con `users/{uid}.isBanned`? Porque ese
    // documento lo puede borrar su dueño (es el borrado legítimo
    // de cuenta) y, al volver a entrar, la app se lo recrea. Si el
    // baneo viviera solo ahí, borrar y recrear sería la forma más
    // fácil de saltarse una sanción. Este registro no se borra con
    // el perfil.
    match /accountRestrictions/{uid} {
      // El propio usuario puede consultar su restricción (la app lo
      // hace al recrear un perfil); el equipo puede verla desde el
      // panel. Los demás no tienen por qué conocer las sanciones
      // ajenas.
      allow read: if isSignedIn()
                  && (request.auth.uid == uid || isAdmin() || isModerator());

      // Ni el usuario, ni un moderador, ni un administrador. Los
      // baneos se aplican con las callables, que comprueban el rol
      // en el servidor y escriben el registro con el Admin SDK.
      allow write: if false;
    }

    // Presencia: un documento mínimo por persona. Solo su dueño puede
    // escribir su estado y la fecha debe ser el reloj del servidor, no
    // una hora inventada por el cliente.
    match /presence/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(uid)
                            && request.resource.data.keys().hasOnly(['online', 'lastSeenAt'])
                            && request.resource.data.online is bool
                            && request.resource.data.lastSeenAt == request.time;
      allow delete: if false;
    }

    // ======================================================
    // RESERVA DE NOMBRES DE USUARIO
    // ======================================================
    //
    // El id del documento ES el identificador normalizado. Solo lo
    // escriben las Cloud Functions y la migración con el Admin SDK;
    // el cliente únicamente puede consultar si un nombre está libre.
    //
    // `get` y `list` cerrados: el formulario de registro consulta la
    // disponibilidad por la callable `comprobarUsername`, que no
    // revela el directorio de identificadores.
    match /usernames/{username} {
      allow get, list: if false;
      allow write: if false;
    }

    // Identificadores antiguos que la migración cambió. Se usan para
    // resolver menciones ya escritas. El cliente no los lee ni los
    // escribe.
    match /usernameAliases/{alias} {
      allow get, list: if false;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isSignedIn();

      // El 'create' tambien tiene que mirar los campos de
      // gamificacion, y es un agujero facil de dejar abierto:
      // 'update' no dice nada de un documento que aun no existe,
      // asi que sin esta comprobacion un usuario podria crearse su
      // cuenta YA con 999999 XP y todas las medallas puestas.
      //
      // En un 'create' no se puede usar diff() (no hay documento
      // anterior contra el que comparar), asi que lo que se mira son
      // las claves que trae el documento nuevo.
      allow create: if !request.resource.data.keys().hasAny(
                          // Datos privados: su sitio es
                          // `userPrivate/{uid}`. Si se permitiera
                          // crearlos aquí, el documento público los
                          // enseñaría a todo el mundo.
                          ['email', 'isBanned', 'chatApariencia',
                           'regionPreferida', 'profileVisibility',
                           'allowChatRequests', 'showActivity',
                           'usernameAliases'])
                    // La antigüedad alimenta la medalla de veterano
                    // (`antiguedadDias` en Functions). Si el cliente
                    // pudiera elegir la fecha, bastaría con nacer con
                    // `createdAt` de 2019 para llevársela. El único
                    // valor aceptado es el reloj del servidor.
                    && 'createdAt' in request.resource.data
                    && request.resource.data.createdAt == request.time
                    // Identidad: el nombre de usuario tiene que venir
                    // normalizado y con una reserva hecha por la
                    // Cloud Function para ESTE uid. La comprobación de
                    // disponibilidad del formulario no reserva nada.
                    && request.resource.data.username is string
                    && request.resource.data.username
                       == request.resource.data.username.lower()
                    && request.resource.data.username
                       .matches('^[a-z0-9_]{3,20}$')
                    && exists(/databases/$(database)/documents/usernames/$(request.resource.data.username))
                    && get(/databases/$(database)/documents/usernames/$(request.resource.data.username))
                         .data.uid == uid
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.trim().size() >= 2
                    && request.resource.data.displayName.size() <= 30
                    && (isAdmin()
                    || (isSelf(uid)
                        // El rol NUNCA se lo pone el cliente: si no
                        // es exactamente 'user', la creación falla.
                        // Así no hay forma de nacer admin ni
                        // moderador aunque se llame a setDoc a mano.
                        && request.resource.data.role == 'user'
                        && !request.resource.data.keys().hasAny(
                            ['xp', 'level', 'xpEnNivel', 'xpParaSiguienteNivel',
                             'stats', 'medals', 'equippedTitle',
                             'xpActualizadoAt', 'lastLevelUpAt',
                             'lastLevelUpLevel', 'trivia',
                             // Los contadores de seguimiento tampoco se
                             // pueden traer en una cuenta recién creada. Es
                             // el mismo agujero que el XP: si `followersCount`
                             // se pudiera escribir en el `create`, bastaría
                             // registrarse con 999999 seguidores para tener
                             // de golpe todas las medallas de comunidad.
                             'followersCount', 'followingCount'])));

      // ── Quién puede actualizar el perfil ───────────────
      //
      // El estado de sanción (`isBanned`) y los datos privados NO
      // se tocan desde aquí, ni siquiera con rol de admin o
      // moderador. El baneo solo lo cambian las callables
      // `banearUsuario` / `desbanearUsuario`, que escriben el
      // registro duradero `accountRestrictions/{uid}`. Los datos
      // privados viven en `userPrivate/{uid}` y los escribe su
      // dueño.
      allow update: if !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(
                            ['email', 'isBanned', 'chatApariencia',
                             'regionPreferida', 'profileVisibility',
                             'allowChatRequests', 'showActivity',
                             // El identificador es permanente. Ni el
                             // dueño ni un admin lo cambian desde el
                             // cliente: la migración lo hace con el
                             // Admin SDK.
                             'username',
                             // Los alias antiguos los escribe solo la
                             // migración; si el cliente pudiera
                             // tocarlos, podría secuestrar menciones.
                             'usernameAliases'])
                    // `createdAt` no se puede mover ni con rol de
                    // admin. Los perfiles antiguos que no lo tengan
                    // pueden rellenarlo, pero solo con la hora del
                    // servidor; una vez existe, queda congelado.
                    && (('createdAt' in resource.data
                         && 'createdAt' in request.resource.data
                         && request.resource.data.createdAt == resource.data.createdAt)
                        || (!('createdAt' in resource.data)
                            && (!('createdAt' in request.resource.data)
                                || request.resource.data.createdAt == request.time)))
                    // Nombre visible: libre y repetible, pero con un
                    // cambio cada 7 días (los admins pueden saltarse
                    // la espera). Si no cambia, tampoco se puede mover
                    // `displayNameChangedAt` para resetear el plazo.
                    && (request.resource.data.displayName == resource.data.displayName
                        || isAdmin()
                        || (request.resource.data.displayName is string
                            && request.resource.data.displayName.trim().size() >= 2
                            && request.resource.data.displayName.size() <= 30
                            && (!('displayNameChangedAt' in resource.data)
                                || resource.data.displayNameChangedAt
                                   + duration.value(7, 'd') <= request.time)
                            && 'displayNameChangedAt' in request.resource.data
                            && request.resource.data.displayNameChangedAt == request.time))
                    && (request.resource.data.displayName != resource.data.displayName
                        || (('displayNameChangedAt' in request.resource.data)
                            == ('displayNameChangedAt' in resource.data)
                            && (!('displayNameChangedAt' in request.resource.data)
                                || request.resource.data.displayNameChangedAt
                                   == resource.data.displayNameChangedAt)))
                    && ((isAdmin())
                    || (isSelf(uid)
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(['role', 'chatId', 'uid',
                                                     // La racha de la trivia la calcula la
                                                     // Cloud Function al corregir el
                                                     // resultado. Si el usuario pudiera
                                                     // escribirla, se fabricaría una racha
                                                     // de 30 días en dos clics y se
                                                     // llevaría la medalla sin jugar.
                                                     'trivia',
                                                      // Los dos contadores de seguimiento van aqui
                                                      // por el mismo motivo que el resto, y por uno
                                                      // mas grave: los escribe la Cloud Function
                                                      // `onFollowChanged` al contar los
                                                      // documentos de `following` y `followers`.
                                                      // Si un usuario pudiera escribirlos, se
                                                      // pondria 999999 seguidores para enseguida
                                                      // las medallas de comunidad (Primer Fan,
                                                      // Popular, Figura de la Comunidad, Icono
                                                      // Geekapoo) sin haber seguido nadie. O se
                                                      // los pondria a 0 para que no le cuadren con
                                                      // lo que de verdad se ve en su perfil.
                                                      //
                                                      // Esto protege el documento PROPIO, que es
                                                      // lo que gobierna esta regla. El de otra
                                                      // persona ya esta protegido por otra via:
                                                      // este `allow update` empieza por
                                                      // `isAdmin()`, asi que sin rol no se
                                                      // escribe en el documento de nadie mas.
                                                      'followersCount',
                                                      'followingCount'])
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(
                                 ['xp', 'level', 'xpEnNivel', 'xpParaSiguienteNivel',
                                  'stats', 'medals', 'xpActualizadoAt', 'lastLevelUpAt',
                                  'lastLevelUpLevel',
                                  // 'equippedTitle' va aqui TAMBIEN, y no
                                  // solo en la rama de abajo. Esta rama
                                  // general permite tocar cualquier campo
                                  // que no este en la lista, asi que si
                                  // 'equippedTitle' no estuviera aqui,
                                  // el usuario se pondria el titulo que
                                  // quisiera por aqui, sin pasar por
                                  // 'tituloValido' y sin comprobar que
                                  // tenga la medalla. La rama de abajo
                                  // solo seria entonces codigo muerto.
                                  //
                                  // Los dos contadores de seguimiento tambien
                                  // vienen aqui (ademas de en la lista de
                                  // arriba, que es la que protege de verdad):
                                  // son del servidor, igual que 'xp' o 'stats'.
                                  'equippedTitle']))
                         // La personalizacion (banner, color, marco,
                         // personaje, visibles y destacadas) pasa si
                         // cumple `personalizacionValida()`. Van de
                         // barato a caro: primero lo que evita evaluar
                         // la función en vano.
                         //
                         // Sin claves de personalización, todo es
                         // vacuamente cierto y no hay nada que comprobar.
                         && (!request.resource.data.keys().hasAny(['bannerUrl', 'profileColor', 'avatarFrame',
                                                      'favoriteCharacter', 'favoriteCharacters',
                                                      'profileBackground', 'decorations', 'showcases',
                                                      'visibleBadgeIds', 'featuredPostIds'])
                             || personalizacionValida())

                    
                    // La unica via para escribir 'equippedTitle' es esta:
                    // que no toque ningun otro campo, y que el titulo
                    // corresponda a una medalla ya desbloqueada.
                    || (isSelf(uid)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['equippedTitle'])
                        && tituloValido()));

      // Borrado: el admin, o el propio usuario.
      //
      // Lo segundo es lo que hace posible el apartado "Eliminar
      // cuenta" del perfil. Sin esta línea, una cuenta solo se
      // podía destruir desde la consola de Firebase, que para el
      // que está usando la web es lo mismo que no poder hacerlo.
      //
      // El borrado desde la web no toca solo este documento: pasa
      // antes por los hilos, los comentarios, las solicitudes y
      // los bloqueados, porque Firestore no borra en cascada (ver
      // services/accountSettings.ts).
      //
      // Lo que NO borra es `accountRestrictions/{uid}`: vive en
      // otra colección y el cliente no tiene escritura allí. Así,
      // borrar el perfil no sirve para quitarse un baneo; solo la
      // callable `desbanearUsuario` levanta la restricción.
      allow delete: if isAdmin() || isSelf(uid);

      // ── Libro mayor de XP ─────────────────────────────
      // Es la prueba de que una recompensa ya se concedio, y es
      // lo que impide cobrar dos veces por lo mismo.
      //
      // Ni el propio usuario ni un admin pueden escribirlo: solo
      // las Cloud Functions, que usan el Admin SDK. Si se pudiera
      // escribir, bastaria con no crear el documento para que la
      // recompensa volviera a pagarse en la siguiente accion.
      match /rewardLedger/{entryId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      // ── Lista de bloqueados ─────────────────────────
      // Guardada como subcolección de QUIEN bloquea, no de
      // quien es bloqueado. Al revés, cualquiera con sesión
      // (que puede leer todos los usuarios) vería a quién
      // tiene bloqueado cada uno.
      match /blocked/{blockedUid} {
        // Solo el dueño de la lista. Antes podía leerla cualquier
        // persona con sesión, y con ella se deducía a quién tiene
        // bloqueado cada uno. No es información pública.
        allow read: if isSelf(uid);
        allow create, delete: if isSelf(uid);
        allow update: if false;
      }

      // ── SEGUIMIENTOS ───────────────────────────────
      //
      // Dos subcolecciones, igual que los bloqueados:
      //
      //   following/{targetUid}   a quién sigo
      //   followers/{followerUid} quién me sigue
      //
      // El id del documento ES el uid de la otra persona, que es lo
      // que hace que un documento = una persona y que el mismo par no
      // se pueda duplicar.
      //
      // ── Por qué `followers` se puede escribir aunque sea la
      //    carpeta de otro ───────────────────────────────────────
      //
      // Es lo más raro de estas reglas y conviene explicarlo, porque
      // lo primero que parece es un agujero.
      //
      // Al seguir a alguien hay que escribir DOS documentos: el de
      // mi carpeta y el de la suya (`followers/{yo}`). El segundo
      // vive en el documento de otra persona, así que a primera
      // vista parecería que hay que abrirle la escritura entera. No
      // hace falta, porque se puede exigir algo mucho más fuerte que
      // "puede escribir aquí":
      //
      //   · el id del documento tiene que ser TU uid, así que solo
      //     puedes añadir un documento que diga "yo te sigo";
      //   · el campo `followerId` tiene que ser también tu uid;
      //   · no puede haber ningún otro campo (`hasOnly`), así que no
      //     hay forma de colar nada dentro: ni un contador, ni un
      //     nombre, ni un nivel.
      //
      // O sea: puedes crear exactamente un documento y solo uno, el
      // que dice que tú sigues a esa persona. No puedes crear el de
      // otra persona (el id no sería tu uid), ni tocar uno que ya
      // exista, ni escribir nada más dentro. Que es exactamente lo
      // que significa "seguir".
      //
      // Lo que NO sale de aquí es followers falsos: para poner a
      // alguien en la lista de seguidores de otra persona hay que
      // SER esa persona. Y los contadores no se tocan (ver el
      // `update` de `users/{uid}` más abajo).
      match /following/{targetUid} {
        // Se lee como los bloqueados: los perfiles son públicos y
        // `users/` ya es legible por cualquiera con sesión.
        allow read: if isSignedIn();

        allow create: if isActive()
                      && isSelf(uid)
                      // Nada de one's own. Sin esto, un self-follow
                      // sumaría un seguidor sin que haya nadie detrás
                      // y la Cloud Function lo pagaría como real.
                      && targetUid != uid
                      // El documento solo puede decir esto y cuándo.
                      // Con `hasOnly` no hay forma de meter nada más:
                      // si el cliente pudiera añadir campos, podría
                      // escribir datos dentro de esta subcolección
                      // sin que ninguna regla los mire.
                      && request.resource.data.keys().hasOnly(
                           ['followerId', 'followingId', 'createdAt'])
                      // Los dos uids tienen que ser los de verdad: el
                      // tuyo en `followerId`, y el del documento en
                      // `followingId`. Si `followerId` fuera de otro,
                      // el aviso le llegaría a la persona equivocada.
                      && request.resource.data.followerId == uid
                      && request.resource.data.followingId == targetUid;

        // No hay nada que editar: o sigues o no sigues. Un update
        // podría cambiar `createdAt` (cuándo empezó) o, peor,
        // `followingId` para decir que sigues a otra persona sin que
        // el contador de esa otra se entere.
        allow update: if false;

        // Solo se borra el propio, y solo si de verdad es el propio.
        // `resource` es el documento de ANTES de borrar, y comparar
        // su `followerId` con el id de la ruta impide que alguien
        // borre la relación de otro.
        allow delete: if isSelf(uid)
                      && (resource == null || resource.data.followerId == uid);
      }

      match /followers/{followerUid} {
        allow read: if isSignedIn();

        // Ver la explicación de arriba: solo se puede crear el
        // documento que dice "yo te sigo", y nada más.
        allow create: if isActive()
                      && isSelf(followerUid)
                      && followerUid != uid
                      && request.resource.data.keys().hasOnly(
                           ['followerId', 'followingId', 'createdAt'])
                      && request.resource.data.followerId == followerUid
                      && request.resource.data.followingId == uid;

        allow update: if false;

        // El `resource == null` no es un descuido: al borrar un documento
        // que YA no existe, `resource` llega nulo y
        // `resource.data.followerId` lanza un error de evaluacion
        // ("Property followerId is undefined on null"), que Firestore
        // traduce a PERMISSION_DENIED. Asi que un doble clic en
        // "dejar de seguir" fallaria con un error de permisos, que
        // es justo lo que hace parecer que las reglas estan mal
        // cuando lo unico que pasa es que ya no habia nada que
        // borrar.
        //
        // Y permitirlo no abre nada: borrar algo que no existe no
        // cambia nada, y si existiera, la comparacion de abajo se
        // sigue aplicando.
        allow delete: if isSignedIn()
                      && followerUid == request.auth.uid
                      && (resource == null || resource.data.followerId == followerUid);
      }

      // ── FAVORITOS: EMOJIS ──────────────────────────
      //
      // Los emojis que la persona usa siempre, para no buscarlos
      // cada vez en el selector. Un documento por emoji, con el
      // id igual a la clave del emoji (`fire`, `heart`...).
      //
      // ¿Por qué una subcolección y no un array en `users/{uid}`?
      // Porque en un array hay que LEER el documento entero y
      // reescribirlo para añadir o quitar una entrada, y dos
      // pulsaciones seguidas (quitar 🔥 y poner 😂) se pisan. Con
      // un documento por favorito, cada pulsación va a su sitio y
      // no se pisa con nadie. Además el nombre del documento ES el
      // emoji guardado: no hay ni que filtrar ni duplicados.
      match /favoriteEmojis/{emojiKey} {
        // Solo los ve quien los marcó: son sus ajustes.
        allow read: if isSelf(uid);

        // El id tiene que ser una clave de reacción válida
        // (mismo formato que comprueba `reactionTypeValido`), y
        // el documento no puede traer nada inventado: guardar
        // "comprado: 1" aquí no sirve de nada.
        allow create: if isSelf(uid)
                      && reactionTypeValido(emojiKey)
                      && request.resource.data.keys().hasOnly(
                           ['emojiKey', 'createdAt'])
                      && request.resource.data.emojiKey == emojiKey;

        // Marcar y desmarcar es todo lo que se hace. Un 'update'
        // no aporta nada y se deja cerrado.
        allow update: if false;

        allow delete: if isSelf(uid);
      }

      // ── FAVORITOS: GIFs ────────────────────────────
      //
      // Aquí sí se guarda el GIF entero (su ficha: proveedor,
      // id y URLs), no solo su clave. Es lo que permite volver a
      // insertarlo sin llamar a la API otra vez, que es justo lo
      // que se busca al guardar uno: no volver a buscar "el de
      // la risa que usé la semana pasada".
      match /favoriteGifs/{gifId} {
        allow read: if isSelf(uid);

        // Se comprueba que la URL sea del CDN del proveedor con
        // el MISMO `gifValido` que se usa en comentarios y en
        // mensajes de chat. Sin esta comprobación, el campo
        // `gif.url` sería un hueco para colgar cualquier URL.
        allow create: if isSelf(uid)
                      && gifId.size() > 0
                      && gifId.size() <= 120
                      && request.resource.data.keys().hasOnly(
                           ['gifId', 'gif', 'createdAt'])
                      && request.resource.data.gifId == gifId
                      && gifValido(request.resource.data.gif);

        allow update: if false;

        allow delete: if isSelf(uid);
      }

      // Fanarts guardados por la persona. El id es el del hilo.
      //
      // Se comprueba que el hilo exista y sea de la categoría fija
      // de Fanart: así no se puede usar la subcolección como una
      // lista de ids arbitrarios. Solo la lee y la escribe su dueño.
      match /favoriteFanarts/{threadId} {
        allow read: if isSelf(uid);

        allow create: if isSelf(uid)
                      && threadId.size() > 0
                      && threadId.size() <= 150
                      && request.resource.data.keys().hasOnly(
                           ['threadId', 'createdAt'])
                      && request.resource.data.threadId == threadId
                      && exists(/databases/$(database)/documents/threads/$(threadId))
                      && get(/databases/$(database)/documents/threads/$(threadId))
                           .data.categoryId == 'fanarts';

        allow update: if isSelf(uid)
                      && request.resource.data.keys().hasOnly(
                           ['threadId', 'createdAt'])
                      && request.resource.data.threadId == threadId;

        allow delete: if isSelf(uid);
      }

      // ── NOTIFICACIONES ──────────────────────────────
      //
      // Subcolección del usuario, y no una colección plana: con una
      // plana habría que filtrar por "recipientId" y traerse las
      // notificaciones de todo el mundo para enseñar las tuyas. Aquí
      // la ruta ya dice de quién son, y `isSelf` se encarga del
      // filtro sin que el cliente pueda quitarlo.
      //
      // ESTA SUBCOLECCIÓN TIENE QUE ESTAR AQUÍ, dentro de
      // `match /users/{uid}`, y no en la raíz del servicio. En la
      // raíz, `match /notifications/{id}` describe la ruta
      // `/notifications/{id}`, que NO es la que usa el cliente
      // (`/users/{uid}/notifications/{id}`): el `match` no casaría
      // y la consulta se iría al `match /{document=**}` de abajo,
      // que lo niega todo. El síntoma es el campana del Navbar
      // respondiendo "Missing or insufficient permissions", y las
      // reglas COMPILAN sin quejarse, que es lo que lo hace tan
      // difícil de ver. Está cubierto en
      // tests/firestore.notificaciones.rules.test.cjs.
      match /notifications/{notificationId} {
        // Solo las propias. Ni un admin puede leerlas desde el
        // cliente: no hay moderación que hacer sobre un aviso que
        // genera el servidor con datos que el usuario no eligió
        // enseñar (una mención revela que está en la conversación).
        allow get, list: if isSignedIn() && request.auth.uid == uid;

        // CREAR: NADIE desde el cliente, ni siquiera el propio
        // usuario, ni aunque sea para su propia carpeta.
        //
        // Es lo que impide el spam: si el navegador pudiera escribir
        // aquí, un `for` de mil iteraciones mandaría mil
        // notificaciones a otra persona. Quien las crea es la Cloud
        // Function con el Admin SDK, que ignora estas reglas y
        // además deduce el destinatario del contenido que ya existe
        // (una respuesta, un like, una mención), no de lo que le
        // digan.
        allow create: if false;

        // MODIFICAR: únicamente pasar a leída.
        //
        // `hasOnly` sobre los campos que cambian es lo que impide
        // tocar el `actorId`, el `type` o el `snippet`: si pudieras
        // reescribir el actor, el aviso parecería de otra persona.
        //
        // Y el `read == true` es lo que impide HACER MARCHA ATRÁS:
        // como `hasOnly` ya deja tocar 'read', sin esta comprobación
        // un update a `read: false` pasaría el filtro y el aviso
        // volvería al contador de sin leer cada vez que el usuario
        // quisiera: solo se puede pasar a leída, nunca al revés.
        allow update: if isSignedIn()
                      && request.auth.uid == uid
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['read', 'readAt'])
                      && request.resource.data.read == true;

        // El usuario puede borrar SUS avisos, uno a uno o todos.
        // La ruta ya lo limita a su carpeta: con otro `uid` la regla
        // no pasa. No se toca el contenido original, solo el aviso.
        allow delete: if isSignedIn() && request.auth.uid == uid;
      }

      // Mensajes ocultos solo para su dueño ("eliminar solo para
      // mí"). Cada documento es un mensaje que este usuario dejó de
      // ver; el mensaje original no se toca y los demás lo conservan.
      //
      // Solo los propios, como las notificaciones de lectura: con
      // `uid` distinto ni se leen, ni se crean, ni se deshacen.
      // El id del documento es el del mensaje, así que ocultar dos
      // veces no duplica nada.
      match /hiddenMessages/{messageId} {
        allow get, list: if isSignedIn() && request.auth.uid == uid;

        allow create: if isSignedIn()
                      && request.auth.uid == uid
                      && request.resource.data.messageId == messageId
                      && request.resource.data.chatId is string;

        // Re-ocultar actualiza la fecha y nada más: ni el chat ni el
        // mensaje pueden cambiar, así que un registro no puede
        // acabar apuntando a otro mensaje.
        allow update: if isSignedIn()
                      && request.auth.uid == uid
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['hiddenAt']);

        allow delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ======================================================
    // CUPO DE SOLICITUDES DE CHAT
    // ======================================================
    // Un libro mayor por usuario (`rateLimits/{uid}`) con cuatro
    // campos: `count`, `windowStart`, `ultimaSolicitud` y
    // `ultimaSolicitudId`. El cliente lo escribe en la MISMA
    // transacción que la solicitud; la regla de `chatRequests`
    // comprueba con `getAfter()` que el incremento está ahí, que
    // `ultimaSolicitud` es la hora del servidor de ESTA escritura y
    // que `ultimaSolicitudId` es el id de la solicitud. Así una
    // transacción no puede crear varias solicitudes con un solo
    // incremento.
    //
    // Estas reglas son las que impiden reiniciar la ventana antes de
    // tiempo o bajar el contador para saltarse el límite de 20
    // solicitudes cada 24 h. El libro solo lo puede leer y escribir
    // su dueño; para los demás la colección no existe.
    match /rateLimits/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;

      allow create: if isSelf(uid)
                    && request.resource.data.keys().hasOnly(
                         ['count', 'windowStart', 'ultimaSolicitud',
                          'ultimaSolicitudId'])
                    && request.resource.data.count == 1
                    && request.resource.data.windowStart == request.time
                    // La marca de frescura: solo puede venir de
                    // `serverTimestamp()` en esta misma transacción.
                    && request.resource.data.ultimaSolicitud == request.time
                    && request.resource.data.ultimaSolicitudId is string
                    && request.resource.data.ultimaSolicitudId.size() > 0
                    && request.resource.data.ultimaSolicitudId.size() <= 200;

      allow update: if isSelf(uid)
                    && request.resource.data.keys().hasOnly(
                         ['count', 'windowStart', 'ultimaSolicitud',
                          'ultimaSolicitudId'])
                    && request.resource.data.count is int
                    && request.resource.data.count >= 1
                    && request.resource.data.count <= 20
                    && request.resource.data.windowStart is timestamp
                    && request.resource.data.ultimaSolicitud == request.time
                    && request.resource.data.ultimaSolicitudId is string
                    && request.resource.data.ultimaSolicitudId.size() > 0
                    && request.resource.data.ultimaSolicitudId.size() <= 200
                    && (
                      // Consumir un hueco de la ventana actual.
                      (request.resource.data.count == resource.data.count + 1
                       && request.resource.data.windowStart == resource.data.windowStart
                       && resource.data.windowStart > request.time - duration.value(24, 'h'))
                      // La ventana caducó: se reinicia una sola vez.
                      || (request.resource.data.count == 1
                          && request.resource.data.windowStart == request.time
                          && resource.data.windowStart <= request.time - duration.value(24, 'h'))
                    );

      // Borrarlo permitiría reiniciar el cupo a voluntad.
      allow delete: if false;
    }

    // ======================================================
    // SOLICITUDES DE CONVERSACIÓN Y DE ENTRADA A GRUPOS
    // ======================================================
    // El chat NO se crea al pedirlo: se crea al aceptarse.
    // Así el documento de conversación solo existe entre
    // personas que ya se han aceptado mutuamente, y la
    // consulta de la lista de chats (que filtra por
    // memberIds) nunca muestra conversaciones pendientes.
    match /chatRequests/{requestId} {
      // Solo se ven las tuyas: las que has enviado y las que
      // te han enviado.
      allow read: if isSignedIn()
                  && (resource.data.fromId == request.auth.uid
                      || resource.data.toId == request.auth.uid);

      // Crear una solicitud. Hay tres formas legítimas:
      //
      //   · direct  → quiero hablar contigo.
      //   · group   → quiero entrar en tu grupo (lo pide el
      //               interesado y lo acepta el dueño).
      //   · invite  → el dueño te invita a su grupo. Es el
      //               camino que sustituye a "añadir a alguien
      //               al grupo": la persona tiene que aceptar.
      //
      // En los tres casos el estado inicial es `pending` y el
      // `fromId` es SIEMPRE quien escribe. Aceptar no se hace
      // aquí: lo hace una Cloud Function con el Admin SDK, que
      // es la única que puede tocar `status: 'accepted'` y
      // `resultingChatId`.
      allow create: if isActive()
                    && request.resource.data.fromId == request.auth.uid
                    && request.resource.data.toId is string
                    && request.resource.data.toId != request.auth.uid
                    && request.resource.data.status == 'pending'
                    // La fecha la pone el servidor, no el cliente.
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.type in ['direct', 'group', 'invite']
                    // Quién firma la solicitud sale de SU perfil, y el
                    // destinatario del suyo. El cliente ya no elige
                    // cómo se presenta.
                    && nombreYAvatarCoinciden(
                         request.auth.uid,
                         request.resource.data.fromName,
                         request.resource.data.fromAvatar)
                    && request.resource.data.keys().hasOnly(
                         ['type', 'fromId', 'fromName', 'fromAvatar',
                          'toId', 'toName', 'toAvatar',
                          'groupId', 'groupName', 'status', 'createdAt'])
                    // El id se reconstruye con los campos del
                    // documento: una sola ruta por par o por grupo y
                    // persona.
                    && idDeSolicitudCorrecto(requestId)
                    // El destinatario puede tener la privacidad en
                    // "privado" o con las solicitudes apagadas. Se
                    // comprueba contra SU documento, no contra el
                    // nuestro, para que no se pueda esquivar.
                    && acceptsChatRequests(request.resource.data.toId)
                    // Si una de las dos partes tiene bloqueada a la
                    // otra, no se puede abrir una solicitud nueva.
                    && !hayBloqueoCon(request.resource.data.toId)
                    // Y la escritura tiene que consumir un hueco del
                    // libro en la misma transacción.
                    && cupoDeSolicitudesConsumido()
                    && (
                      // Chat privado: no lleva grupo y el nombre/foto
                      // del destinatario también salen de su perfil.
                      (request.resource.data.type == 'direct'
                        && !('groupId' in request.resource.data)
                        && !('groupName' in request.resource.data)
                        && nombreYAvatarCoinciden(
                             request.resource.data.toId,
                             request.resource.data.toName,
                             request.resource.data.toAvatar))
                      // Pedir entrar en un grupo: el destinatario
                      // tiene que ser su dueño, y quien pide no
                      // puede ser ya miembro.
                      || (request.resource.data.type == 'group'
                        && request.resource.data.groupId is string
                        && chatData(request.resource.data.groupId).type == 'group'
                        && request.resource.data.toId
                             == chatData(request.resource.data.groupId).ownerId
                        && request.resource.data.groupName is string
                        && request.resource.data.groupName
                             == chatData(request.resource.data.groupId).name
                        && !('toName' in request.resource.data)
                        && !('toAvatar' in request.resource.data)
                        && !(request.auth.uid
                             in chatData(request.resource.data.groupId).memberIds))
                      // Invitación: solo la manda el dueño, y el
                      // invitado no puede ser ya miembro.
                      || (request.resource.data.type == 'invite'
                        && request.resource.data.groupId is string
                        && chatData(request.resource.data.groupId).type == 'group'
                        && chatData(request.resource.data.groupId).ownerId
                             == request.auth.uid
                        && request.resource.data.groupName is string
                        && request.resource.data.groupName
                             == chatData(request.resource.data.groupId).name
                        && !(request.resource.data.toId
                             in chatData(request.resource.data.groupId).memberIds)
                        && nombreYAvatarCoinciden(
                             request.resource.data.toId,
                             request.resource.data.toName,
                             request.resource.data.toAvatar))
                    );

      // El cliente solo puede CANCELAR (quien la envió) o
      // RECHAZAR (quien la recibió). Aceptar es cosa de la Cloud
      // Function: si se permitiera escribir `accepted` desde el
      // cliente, el estado podría decir "aceptada" sin que exista
      // el chat, o se podría aceptar una solicitud propia.
      //
      // `affectedKeys().hasOnly()` es la barrera que mantiene
      // inmutables fromId, toId, type, groupId, createdAt y
      // resultingChatId: el cliente solo puede tocar los tres
      // campos que usa la interfaz al cancelar o rechazar.
      //
      // `respondedBy` y `respondedAt` no son libres: el primero
      // tiene que ser quien hace la operación y el segundo, la
      // hora del servidor. Así nadie puede falsificar la autoría
      // ni la fecha de la respuesta.
      //
      // También exige `isActive()`: una cuenta baneada no puede
      // seguir cambiando el estado de solicitudes ni borrarlas.
      // No es contenido, pero sí estado compartido del chat.
      allow update: if isActive()
                    && resource.data.status == 'pending'
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(
                           ['status', 'respondedAt', 'respondedBy'])
                    && request.resource.data.respondedBy == request.auth.uid
                    && request.resource.data.respondedAt == request.time
                    && (
                      (resource.data.fromId == request.auth.uid
                        && request.resource.data.status == 'cancelled')
                      || (resource.data.toId == request.auth.uid
                        && request.resource.data.status == 'rejected')
                    );

      // Reabrir una solicitud que ya existe en su id determinista.
      //
      // No se puede crear otra ruta para el mismo par, así que la
      // única forma de volver a pedirlo es reutilizar el documento:
      //
      //   · cancelada  → se puede reabrir enseguida;
      //   · rechazada  → tras 24 h, para que rechazar sirva de algo;
      //   · aceptada   → solo en grupo/invitación y solo si la
      //                  persona ya no es miembro (si sigue dentro,
      //                  no hay nada que pedir).
      //
      // Solo se tocan `status` y la limpieza de la respuesta. El id,
      // el emisor, el destinatario y `createdAt` siguen intactos.
      allow update: if isActive()
                    && resource.data.fromId == request.auth.uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(
                           ['status', 'respondedAt', 'respondedBy'])
                    && request.resource.data.status == 'pending'
                    && !('respondedAt' in request.resource.data)
                    && !('respondedBy' in request.resource.data)
                    && acceptsChatRequests(resource.data.toId)
                    // Reabrir también cuenta para el cupo y respeta
                    // los bloqueos: si la otra persona te bloqueó
                    // mientras la solicitud estaba cancelada, no
                    // puedes reabrirla.
                    && !hayBloqueoCon(resource.data.toId)
                    && cupoDeSolicitudesConsumido()
                    && (
                      resource.data.status == 'cancelled'
                      || (resource.data.status == 'rejected'
                          && resource.data.respondedAt is timestamp
                          && request.time
                             >= resource.data.respondedAt
                                + duration.value(24, 'h'))
                      || (resource.data.status == 'accepted'
                          && resource.data.type == 'group'
                          && chatData(resource.data.groupId).type == 'group'
                          && chatData(resource.data.groupId).ownerId
                               == resource.data.toId
                          && !(resource.data.fromId
                               in chatData(resource.data.groupId).memberIds))
                      || (resource.data.status == 'accepted'
                          && resource.data.type == 'invite'
                          && chatData(resource.data.groupId).type == 'group'
                          && chatData(resource.data.groupId).ownerId
                               == resource.data.fromId
                          && !(resource.data.toId
                               in chatData(resource.data.groupId).memberIds))
                    );

      allow delete: if isActive()
                    && (resource.data.fromId == request.auth.uid
                        || resource.data.toId == request.auth.uid);
    }

    // ======================================================
    // ÍNDICE DE GRUPOS POR CÓDIGO
    // ======================================================
    // Un grupo se entra presentando su código (GRP-XXXX-XXXX-XXXX),
    // no su nombre, porque los nombres se repiten.
    //
    // El código es una INVITACIÓN SECRETA, no un identificador
    // público. Quien lo conoce puede localizar el grupo y PEDIR
    // entrada; no entra por su cuenta. Por eso:
    //
    //   · `get` exige el código exacto y una cuenta activa;
    //   · `list` está prohibido. Sin esto, cualquiera podía
    //     enumerar la colección y llevarse TODOS los códigos, que
    //     es justo lo que convierte una invitación en un listado.
    //
    // Hace falta porque alguien que NO es miembro no puede leer
    // chats/ (allí solo se lee lo propio), y sin este índice no
    // podría ni averiguar a quién pertenece el grupo para pedir
    // entrar. Los datos son mínimos: código, nombre y dueño. El
    // contenido de la conversación sigue en chats/, con sus reglas.
    match /groupCodes/{code} {
      allow get: if isActive();
      allow list: if false;

      // El índice tiene que apuntar a un grupo REAL y del que
      // quien lo crea es dueño. Antes bastaba con escribir
      // cualquier `groupId`: se podía anunciar el grupo de otra
      // persona con un código propio, o crear un índice que no
      // llevaba a ninguna parte.
      //
      // El código se genera en el cliente con Web Crypto (48 bits)
      // y aquí se comprueba el formato. `createdAt` tiene que ser
      // la hora del servidor y el contador, el real del chat: no
      // se puede anunciar un grupo más grande de lo que es.
      allow create: if isActive()
                    && request.resource.data.code == code
                    && codigoDeGrupoNuevoValido(request.resource.data.code)
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.groupId is string
                    && chatExiste(request.resource.data.groupId)
                    && chatData(request.resource.data.groupId).type == 'group'
                    && chatData(request.resource.data.groupId).ownerId
                         == request.auth.uid
                    && chatData(request.resource.data.groupId).memberIds is list
                    && request.resource.data.memberCount is int
                    && request.resource.data.memberCount
                         == chatData(request.resource.data.groupId).memberIds.size()
                    && request.resource.data.memberCount >= 1
                    && request.resource.data.memberCount <= 50
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.ownerName is string
                    && request.resource.data.ownerName.size() <= 60
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.keys().hasOnly(
                         ['code', 'groupId', 'name', 'ownerId',
                          'ownerName', 'memberCount', 'createdAt']);

      // Se actualiza el contador y, al traspasar el grupo, el
      // dueño del índice. El código y `groupId` NO se pueden
      // tocar nunca: el primero es la invitación y el segundo,
      // el puntero al grupo.
      //
      // El traspaso lo puede hacer el dueño viejo (que sigue
      // siendo `resource.data.ownerId`) o el dueño NUEVO del
      // chat (para reparar índices antiguos), pero en ambos
      // casos el `ownerId` resultante tiene que ser el dueño
      // REAL del grupo. Así nadie puede regalar el índice a un
      // tercero.
      allow update: if isActive()
                    && (
                      (
                        (isAdmin() || isSelf(resource.data.ownerId))
                        && (
                          (request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['memberCount'])
                           && request.resource.data.memberCount is int
                           && request.resource.data.memberCount >= 0
                           && request.resource.data.memberCount <= 50)
                          || (request.resource.data.diff(resource.data)
                                .affectedKeys().hasOnly(['ownerId', 'ownerName'])
                              && request.resource.data.ownerId is string
                              && request.resource.data.ownerId.size() > 0
                              && request.resource.data.ownerId
                                   != resource.data.ownerId
                              && chatExiste(resource.data.groupId)
                              && chatData(resource.data.groupId).ownerId
                                   == request.resource.data.ownerId
                              && request.resource.data.ownerName is string
                              && request.resource.data.ownerName.size() <= 60)
                        )
                      )
                      || (
                        // Reparación: el dueño actual del grupo
                        // puede reclamar un índice que se quedó
                        // apuntando al dueño anterior.
                        chatExiste(resource.data.groupId)
                        && chatData(resource.data.groupId).ownerId
                             == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['ownerId', 'ownerName'])
                        && request.resource.data.ownerId == request.auth.uid
                        && request.resource.data.ownerName is string
                        && request.resource.data.ownerName.size() <= 60
                      )
                    );

      // Borrar un código es cosa de su dueño. El admin puede
      // hacerlo como parte de la moderación, pero un tercero no.
      allow delete: if isActive()
                    && (isAdmin() || isSelf(resource.data.ownerId));
    }

    // ======================================================
    // CATALOGO DE CONTENIDO - escritura de admin y moderador
    // ======================================================
    match /animes/{animeId} {
      allow read: if true;
      allow create: if (isAdmin() || isModerator())
                    && estadisticasWikiEnCero()
                    && (!('commentsCount' in request.resource.data)
                        || (request.resource.data.commentsCount is number
                            && request.resource.data.commentsCount == 0));
      allow update: if ((isAdmin() || isModerator())
                        && sinContadorDeComentarios()
                        && sinEstadisticasWiki())
                    || likeDelCatalogoValido();
      allow delete: if isAdmin() || isModerator();
    }

    // ======================================================
    // VOTOS DE LA COMUNIDAD Y VISITAS DE LA WIKI
    // ======================================================
    //
    // Los votos individuales solo los lee su dueño; el agregado
    // público vive en el documento del anime. Las visitas y los
    // votos los escriben las Cloud Functions con el Admin SDK.
    match /animeRatings/{animeId}/votes/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /animeViewLogs/{logId} {
      allow read, write: if false;
    }

    // ======================================================
    // DISPONIBILIDAD REGIONAL DE STREAMING
    // ======================================================
    // Los tres catálogos son públicos: la wiki se puede leer sin
    // sesión. Solo el equipo (admin o moderador) los modifica.
    //
    // La disponibilidad va en su propia colección plana, no dentro
    // del anime, para que la wiki consulte únicamente la obra y la
    // región elegidas.
    match /streamingAvailability/{availabilityId} {
      allow read: if true;
      allow create, update: if (isAdmin() || isModerator())
                              && disponibilidadRegionalValida();
      allow delete: if isAdmin() || isModerator();
    }

    match /streamingPlatforms/{platformId} {
      allow read: if true;
      allow create, update: if (isAdmin() || isModerator())
                              && plataformaStreamingValida();
      allow delete: if isAdmin() || isModerator();
    }

    match /streamingRegions/{regionCode} {
      allow read: if true;
      allow create, update: if (isAdmin() || isModerator())
                              && regionStreamingValida();
      allow delete: if isAdmin() || isModerator();
    }

    // TEMPORADAS
    //
    // Van en su propia colección y no como subcolección de
    // animes porque la wiki las consulta todas de una vez para
    // pintar el selector de temporada, y un get() por anime
    // sería una latencia por cada serie abierta.
    match /seasons/{seasonId} {
      allow read: if true;
      allow write: if isAdmin() || isModerator();
    }

    match /episodes/{episodeId} {
      allow read: if true;
      allow create, delete: if isAdmin() || isModerator();
      allow update: if isAdmin() || isModerator() || likeDelCatalogoValido();
    }

    match /characters/{characterId} {
      allow read: if true;
      allow create, delete: if isAdmin() || isModerator();
      allow update: if isAdmin() || isModerator() || likeDelCatalogoValido();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, delete: if isAdmin() || isModerator();
      // El contenido de la categoría es cosa del admin, pero el
      // contador de hilos lo ajusta automáticamente el propio
      // usuario al publicar o borrar, así que se le permite tocar
      // ese campo y solo ese.
      allow update: if isAdmin() || isModerator()
                    || (isActive()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['threadsCount']));
    }

    match /trivia_extras/{triviaId} {
      allow read: if true;
      allow create, delete: if isAdmin() || isModerator();
      allow update: if isAdmin() || isModerator() || likeDeTriviaValido();
    }

    match /mascot_dialogues/{dialogueId} {
      allow read: if true;
      allow write: if isAdmin() || isModerator();
    }

    // ======================================================
    // NOTICIAS (RSS)
    // ======================================================
    //
    // Lo rellena la Cloud Function `syncRssNews` cada dos horas a
    // partir de los feeds RSS, y no lo toca nadie más.
    //
    // Aquí hay dos decisiones que conviene no dar por supuestas:
    //
    //   1. SE LEE SIN SESIÓN INICIADA. No es un descuido. Las noticias
    //      son contenido público de otra web, se muestran en la barra
    //      lateral de la portada, y quien no ha entrado todavía tiene
    //      que verlas igual que ve los animes o las categorías, que
    //      también se leen sin sesión. Si se exigiera estar
    //      identificado, el hueco se vería en la portada y solo
    //      aparecería al registrarse, que es justo cuando ya no
    //      interesa.
    //
    //   2. NO HAY NINGUNA ESCRITURA, NI PARA ADMIN NI PARA NADIE.
    //      Ni `allow write` a secas, ni `isAdmin()`, ni una operación
    //      suelta de creación. No hay rama de escritura en este bloque,
    //      y a propósito: las reglas niegan por defecto, así que
    //      mientras no exista una línea de escritura aquí, nadie puede
    //      crear, cambiar ni borrar una noticia desde el navegador con
    //      la consola abierta, ni aunque sea el administrador.
    //
    // Lo único que puede escribir aquí es la Cloud Function, que no
    // pasa por estas reglas: usa el Admin SDK, que va con permisos de
    // servicio y se los salta. Por eso esta colección es un buen
    // ejemplo de por qué los datos de fuera se traen al servidor en
    // lugar de pedirse desde el navegador: el cliente solo lee.
    match /news/{newsId} {
      allow read: if true;
    }

    // ======================================================
    // TRIVIA DIARIA
    // ======================================================
    //
    // OJO: esto NO es lo mismo que `trivia_extras` de arriba, que
    // son las curiosidades de la wiki. Aquí hay una trivia al día,
    // la misma para todo el mundo, y la prepara el equipo.
    //
    // El reparto en tres sitios es lo que hace que no se pueda
    // hacer trampa:
    //
    //   questions/  público: enunciado y opciones. Las reglas
    //                comprueban que el documento NO traiga ninguna
    //                clave de las privadas, que es lo que
    //                impide colar la respuesta correcta aquí.
    //
    //   answers/    PRIVADO: la correcta y la explicación. Ni una
    //                sola rama de lectura o escritura para el
    //                cliente; solo la Cloud Function (Admin SDK).
    //
    //   triviaResults/  lo escribe el jugador, pero SOLO con sus
    //                respuestas, y una sola vez por trivia: el id
    //                del documento lleva su uid dentro, así que un
    //                segundo intento choca contra el primero.
    match /dailyQuizzes/{quizDate} {
      // Los metadatos (activa, etiqueta, cuántas preguntas) son
      // públicos: el cliente los necesita para saber si hay trivia
      // hoy y si está cerrada.
      allow read: if true;

      // Preparar la trivia es cosa del EQUIPO: admin o
      // moderador. Antes era solo admin, pero preparar tres
      // preguntas de anime es trabajo de contenido y no hace
      // falta que dependa de una sola persona.
      //
      // Lo que sigue siendo del servidor (y no se abre a
      // moderadores) son las respuestas correctas, que están en
      // el bloque `answers/` de más abajo, sin ninguna rama de
      // escritura para el cliente: eso lo pone la Cloud Function
      // `gestionarTriviaDiaria`, que comprueba el rol.
      allow write: if isAdmin() || isModerator();

      // OJO con los paréntesis: en el lenguaje de reglas `&&` tiene
      // MÁS precedencia que `||`. Escrito sin ellos,
      //
      //     if isAdmin() || isModerator() && formaCorrecta()
      //
      // se leería como `isAdmin() || (isModerator() && ...)`, es
      // decir: el admin podría escribir CUALQUIER cosa y saltarse
      // la comprobación de forma. Con los paréntesis, los dos
      // roles pasan por las mismas comprobaciones.
      match /questions/{questionId} {
        allow read: if true;

        // Con la FORMA CONTROLADA: si el documento trae
        // `correctAnswer` o `explanation`, la trivia quedaría
        // trucada para todo el mundo y la regla lo rechaza.
        // Esta comprobación vale igual para el admin que para el
        // moderador, y es la que garantiza que nadie, con el rol
        // que tenga, pueda dejar la respuesta buena a la vista.
        allow create: if (isAdmin() || isModerator())
                      && request.resource.data.keys().hasOnly(
                           ['question', 'options', 'category', 'difficulty'])
                      && request.resource.data.question is string
                      && request.resource.data.question.size() > 0
                      && request.resource.data.question.size() <= 300
                      && request.resource.data.options is list
                      && request.resource.data.options.size() >= 2
                      && request.resource.data.options.size() <= 6;

        allow update: if (isAdmin() || isModerator())
                      && request.resource.data.keys().hasOnly(
                           ['question', 'options', 'category', 'difficulty'])
                      && request.resource.data.question is string
                      && request.resource.data.options is list
                      && request.resource.data.options.size() >= 2;

        // Borrar una pregunta es cosa del equipo. El bloque
        // `answers/` correspondiente NO lo borra el cliente (no
        // tiene ninguna rama de escritura): eso lo hace la
        // función `gestionarTriviaDiaria`, que va con Admin SDK y
        // comprueba el rol. Aquí solo se retira la parte pública.
        allow delete: if isAdmin() || isModerator();
      }

      // Las respuestas correctas. Aquí no hay `allow` que conceda
      // nada al cliente: ni lectura (si la hubiera, se ganarían la
      // trivia desde la consola) ni escritura (si la hubiera,
      // cada uno se pondría su propia respuesta correcta).
      //
      // El comodín `allow read, write: if false;` es
      // explícito a propósito: sin él, este bloque seería
      // heredaría el `allow read, write: if false` del
      // `match /{document=**}` del final, que ya lo negaría, y
      // el efecto sería el mismo. Se deja escrito para que quien
      // lea las reglas sepa que es deliberado.
      match /answers/{questionId} {
        allow read, write: if false;
      }
    }

    // ======================================================
    // RESULTADO DE LA TRIVIA DE UN USUARIO
    // ======================================================
    //
    // El jugador escribe aquí sus respuestas y NADA más.
    //
    // Lo que NO puede escribir, y por tanto no puede falsear:
    //
    //   - Las notas. `correct` y `points` los pone la Cloud
    //     Function al corregir; el `hasOnly` de abajo lo impide
    //     aunque Inventase el campo.
    //   - Repetir la trivia. El id es `{uid}_{fecha}`, así que
    //     un segundo envío choca contra el documento existente y
    //     no hay forma de tener dos resultados del mismo día.
    //   - Corregirse a sí mismo. `update` y `delete` están
    //     cerrados para el cliente: la respuesta que se envió es
    //     la que cuenta.
    //   - Jugar una trivia que no existe o está cerrada: se
    //     comprueba que el documento de la trivia exista y esté
    //     activa.
    match /triviaResults/{resultId} {
      // Cada quien solo ve su propio resultado.
      //
      // La comparación es contra el ID del documento, no contra
      // `resource.data.userId`. No es un detalle: cuando el documento
      // TODAVIA NO EXISTE —que es justo cuando la web monta el
      // `onSnapshot`, antes de enviar— `resource` es null, y
      // `resource.data.userId` lanza un error de evaluación. La regla
      // entera falla con "permission denied", el `onSnapshot` recibe ese
      // error en vez de los datos, y se queda muerto: nunca vuelve a
      // entregar nada.
      //
      // El efecto era que la trivia se quedaba en "corrigiendo…" para
      // siempre, y hacia falta recargar la página para ver el
      // resultado. Al recargar, el documento ya existe, `resource` sí
      // está, la regla pasa y las notas aparecen. Por eso parecía un
      // fallo de la Cloud Function y no lo era.
      //
      // El id lleva el uid dentro porque así el cliente no puede
      // escribir el resultado de otro (se comprueba en el `create` de
      // abajo). Mirar solo el id no abre nada: un usuario solo puede
      // leer los documentos cuyo id empiece por su propio uid, que son
      // exactamente los suyos.
      allow read: if isSignedIn()
                  && resultId.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$');

      allow create: if isActive()
                    && request.resource.data.userId == request.auth.uid
                    // El id tiene que llevar su uid y la fecha del
                    // documento: sin esto, un jugador podría
                    // escribir el resultado de otro (con su uid
                    // puesto) o sobre una trivia que no ha
                    // jugado.
                    && resultId ==
                       request.resource.data.userId + '_' + request.resource.data.date
                    && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.quizId == request.resource.data.date
                    && request.resource.data.answers is map
                    && request.resource.data.answers.size() > 0
                    && request.resource.data.answers.size() <= 10
                    // Ni una clave más: esto es lo que impide
                    // mandar `correct: 3` o `points: 9999`.
                    && request.resource.data.keys().hasOnly(
                         ['userId', 'date', 'quizId', 'answers', 'createdAt'])
                    // Y la trivia tiene que existir y estar
                    // abierta, que es lo que impide inventarse
                    // XP con una fecha que no existe. OJO: la
                    // función se llama `exists` (en inglés, la
                    // del lenguaje de reglas); escribirla como
                    // `existe` hace que el analizador no la
                    // encuentre y la regla entera falle.
                    && exists(/databases/$(database)/documents/dailyQuizzes/$(request.resource.data.date))
                    && get(/databases/$(database)/documents/dailyQuizzes/$(request.resource.data.date)).data.active == true;

      // El cliente no toca sus respuestas una vez enviadas.
      allow update: if false;
      allow delete: if false;
    }

    // ======================================================
    // RANKING DE LA TRIVIA
    // ======================================================
    //
    // Un documento por periodo ('semanal', 'mensual',
    // 'historico') con un mapa `uid → cifras`. Lo escribe la
    // Cloud Function; el cliente solo lee. Sin ninguna rama de
    // escritura, un jugador no puede ponerse puntos ni salirse
    // de la tabla.
    match /triviaLeaderboard/{periodKey} {
      allow read: if true;
      allow write: if false;
    }

    // ======================================================
    // REPORTES DE CONTENIDO
    // ======================================================
    //
    // Lo que escribe un usuario al denunciar un comentario o un
    // hilo, y lo que encuentra el equipo en el panel.
    //
    // No reutiliza los tickets de soporte a propósito: un ticket
    // es "no me funciona el buscador, escribo desde
    // hola@example.com" y va suelto; un reporte apunta a un
    // contenido concreto y se resuelve con un borrado o sin
    // hacer nada. Meterlos en la misma cola obligaría a los
    // tickets a llevar un id de comentario y llenaría la cola
    // de soporte con quejas que no se pueden ordenar.
    //
    // ── Un reporte por persona y contenido ───────────────
    //
    // El id es `{tipo}_{id del contenido}_{uid}`, igual que en
    // las reacciones y los votos de la trivia. Al ser
    // determinista, un usuario no puede inundar la cola
    // denunciando lo mismo mil veces: el segundo intento choca
    // contra el documento que ya existe.
    //
    // ── Lo que el usuario NO puede escribir ─────────────
    //
    // El `estado`, el `resueltoPor` y la `accion` (qué se hizo
    // con el contenido) no salen del `hasOnly`. Es lo que
    // impide que alguien se auto-asigne el estado "resuelto"
    // para que su queja desaparezca de la cola.
    match /reports/{reportId} {
      // La cola es del equipo. Son DOS reglas y no una porque
      // hacen falta dos cosas distintas:
      //
      //   list → las consultas (las hace el panel). Solo el
      //          equipo, para que nadie sepa qué ha denunciado
      //          cada usuario.
      //   get  → abrir UN documento por su id. El equipo lo
      //          necesita, y el autor también, pero solo el
      //          suyo: para poder decirle "ya lo habías
      //          reportado" en vez de un error seco cuando
      //          repite la denuncia.
      //
      // Con una sola regla `read` no se puede hacer esa
      // diferencia, y un `get` abierto filtraría la cola entera
      // documento a documento (los ids son previsibles: son el
      // contenido y tu uid, y los dos los puede conocer quien
      // denuncia).
      allow get: if isAdmin() || isModerator()
                  || (isActive()
                      && resource.data.reportadoPor == request.auth.uid);
      allow list: if isAdmin() || isModerator();

      // Para escribir, hay que tener sesión, la cuenta no
      // puede estar baneada, y el contenido señalado tiene que
      // existir de verdad: sin esa última comprobación se
      // podrían crear miles de reportes de hilos que no
      // existen (o que ya están borrados).
      allow create: if isActive()
                    && request.resource.data.reportadoPor == request.auth.uid
                    && request.resource.data.estado == 'pendiente'
                    && request.resource.data.keys().hasOnly([
                         'targetType', 'targetId', 'reportadoPor',
                         'reportadoPorNombre', 'motivo', 'detalle',
                         'estado', 'createdAt',
                       ])
                    && request.resource.data.targetType in ['thread', 'comment']
                    && request.resource.data.targetId is string
                    && request.resource.data.targetId.size() > 0
                    && request.resource.data.targetId.size() <= 150
                    && request.resource.data.motivo in [
                         'spam', 'insulto', 'contenido-inapropiado',
                         'spoiler', 'otro'
                       ]
                    && (!('detalle' in request.resource.data)
                        || (request.resource.data.detalle is string
                            && request.resource.data.detalle.size() <= 500))
                    // Y el id tiene que ser el que compone el
                    // cliente: sin esto, un usuario podría
                    // escribir el reporte con el nombre de otro y
                    // justificar un borrado en su nombre.
                    && reportId ==
                       request.resource.data.targetType + '_'
                       + request.resource.data.targetId + '_'
                       + request.auth.uid
                    && (request.resource.data.targetType == 'thread'
                        ? exists(/databases/$(database)/documents/threads/$(request.resource.data.targetId))
                        : exists(/databases/$(database)/documents/comments/$(request.resource.data.targetId)));

      // Cerrar un reporte es trabajo del equipo, y solo puede
      // tocar el estado y lo que hizo con el contenido. No se
      // puede tocar el `reportadoPor` ni el `motivo`: un reporte
      // cerrado tiene que seguir contando lo mismo que cuando
      // se escribió.
      allow update: if (isAdmin() || isModerator())
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly([
                           'estado', 'resueltoPor', 'resueltoAt', 'accion'
                         ])
                    && request.resource.data.estado in
                       ['pendiente', 'resuelto', 'descartado']
                    && (!('accion' in request.resource.data)
                        || request.resource.data.accion in ['borrado', 'nada']);

      // El equipo puede limpiar la cola. El usuario solo puede
      // retirar SU reporte mientras siga pendiente, que es lo
      // que se le ofrece en el diálogo.
      allow delete: if isAdmin() || isModerator()
                    || (isActive()
                        && resource.data.reportadoPor == request.auth.uid
                        && resource.data.estado == 'pendiente');
    }

    // ======================================================
    // FORO
    // ======================================================
    /**
     * Una imagen de fanart.
     *
     * El SVG y los archivos ejecutables no llegan aquí: Storage
     * exige un content-type de imagen permitido antes de subirlos.
     * La regla solo comprueba la forma del documento y que la URL
     * sea https, para que no se cuele texto arbitrario.
     */
    function imagenFanartValida(img) {
      return img is map
             && img.keys().hasOnly(['url', 'width', 'height'])
             && img.url is string
             && img.url.size() > 0
             && img.url.size() <= 1000
             && img.url.matches('^https://.+$')
             && (!('width' in img)
                 || (img.width is int
                     && img.width > 0
                     && img.width <= 10000))
             && (!('height' in img)
                 || (img.height is int
                     && img.height > 0
                     && img.height <= 10000))
             && (('width' in img) == ('height' in img));
    }

    function imagenesFanartValidas(lista) {
      return lista is list
             && lista.size() >= 1
             && lista.size() <= 6
             && imagenFanartValida(lista[0])
             && (lista.size() < 2 || imagenFanartValida(lista[1]))
             && (lista.size() < 3 || imagenFanartValida(lista[2]))
             && (lista.size() < 4 || imagenFanartValida(lista[3]))
             && (lista.size() < 5 || imagenFanartValida(lista[4]))
             && (lista.size() < 6 || imagenFanartValida(lista[5]));
    }

    function fanartValido(f) {
      return f is map
             && f.keys().hasOnly(['source', 'original', 'medium'])
             && f.original is bool
             && f.medium in ['digital', 'traditional', 'mixed']
             && (!('source' in f)
                 || (f.source is string && f.source.size() <= 120));
    }

    match /threads/{threadId} {
      allow read: if true;

      // La imagen es opcional, pero si viene tiene que ser una
      // URL corta. Sin esto, el campo "imageUrl" serviría para
      // meter en un documento un texto de un megabyte y
      // colarse en la cuota de lectura de todo el mundo.
      //
      // Lo mismo con la encuesta: si viene, tiene que estar bien
      // formada (pregunta, entre 2 y 10 opciones...). La forma
      // exacta la exige `pollValido`.
      allow create: if isActive()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.body is string
                    && request.resource.data.body.size() <= 10000
                    && (!('imageUrl' in request.resource.data)
                        || (request.resource.data.imageUrl is string
                            && request.resource.data.imageUrl.size() <= 1000))
                    // El GIF es un adjunto aparte del texto. Se valida su ficha y
                    // no puede convivir con una imagen: una publicacion lleva texto
                    // + UNA imagen o UN GIF, igual que los comentarios. Tampoco vale
                    // en Fanart, que tiene su propia galeria.
                    && (!('gif' in request.resource.data)
                        || (request.resource.data.categoryId != 'fanarts'
                            && !('imageUrl' in request.resource.data)
                            && gifValido(request.resource.data.gif)))
                    // Fijar un hilo es una decisión de moderación. Si
                    // el autor pudiera nacer con `pinned: true`, se
                    // saltaría la restricción del `update`.
                    && (!('pinned' in request.resource.data)
                        || request.resource.data.pinned == false
                        || isAdmin()
                        || isModerator())
                    && (!('poll' in request.resource.data)
                        || pollValido(request.resource.data.poll))
                    // La tier list adjunta, si viene, con forma
                    // válida (id y título acotados). Solo forma:
                    // que exista y se pueda leer lo comprueba el
                    // cliente al pintarla.
                    && (!('tierList' in request.resource.data)
                        || tierRefValida(request.resource.data.tierList))
                    // Nadie se crea a sí mismo una encuesta ya
                    // cerrada: da igual, no hay forma de abrirla
                    // después.
                    && (!('reactionCounts' in request.resource.data))
                    && (!('reactionsTotal' in request.resource.data))
                    // Los contadores nacen en cero y los mueve solo
                    // la Cloud Function. Se admite que un cliente
                    // antiguo los mande, pero no que invente cifras.
                    && (!('likedBy' in request.resource.data)
                        || (request.resource.data.likedBy is list
                            && request.resource.data.likedBy.size() == 0))
                    && (!('likesCount' in request.resource.data)
                        || (request.resource.data.likesCount is number
                            && request.resource.data.likesCount == 0))
                    && (!('commentsCount' in request.resource.data)
                        || (request.resource.data.commentsCount is number
                            && request.resource.data.commentsCount == 0))
                    // Fanart: la categoría fija exige la ficha y las
                    // imágenes. Así un hilo normal no puede colarse
                    // en la pestaña Fanarts ni al revés.
                    && (request.resource.data.categoryId != 'fanarts'
                        || (request.resource.data.kind == 'fanart'
                            && 'fanart' in request.resource.data
                            && fanartValido(request.resource.data.fanart)
                            && 'images' in request.resource.data
                            && imagenesFanartValidas(request.resource.data.images)
                            && 'imageUrl' in request.resource.data
                            && request.resource.data.imageUrl
                               == request.resource.data.images[0].url
                            // La consulta de populares ordena por
                            // `likesCount`; el campo tiene que existir
                            // desde el primer día.
                            && 'likesCount' in request.resource.data
                            && request.resource.data.likesCount == 0
                            && 'commentsCount' in request.resource.data
                            && request.resource.data.commentsCount == 0
                            && 'likedBy' in request.resource.data
                            && request.resource.data.likedBy is list
                            && request.resource.data.likedBy.size() == 0))
                    && (request.resource.data.categoryId == 'fanarts'
                        || !('kind' in request.resource.data)
                        || request.resource.data.kind != 'fanart');

      allow update: if ((isAdmin() || isModerator())
                        && sinContadoresDeEngagement())
                    || (isActive()
                        && resource.data.authorId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             // `pinned` ya NO está aquí: fijar es
                             // cosa del equipo, no del autor.
                             .affectedKeys().hasOnly(['title', 'body', 'tags'])
                        // Los mismos límites que en `create`. Sin
                        // esto, editar era la puerta de atrás para
                        // saltarse los 200/10.000 caracteres.
                        && request.resource.data.title is string
                        && request.resource.data.title.size() > 0
                        && request.resource.data.title.size() <= 200
                        && request.resource.data.body is string
                        && request.resource.data.body.size() <= 10000)
                    // Cerrar (o reabrir) la encuesta propia.
                    //
                    // Se acepta tanto "poll.isClosed" como
                    // "poll" entero porque `affectedKeys()` no
                    // informa siempre igual, pero en el segundo
                    // caso `pollSoloCambiaIsClosed` comprueba que
                    // el resto de la encuesta sea idéntico: si no,
                    // el autor podría reescribir las opciones y
                    // dejar Votes apuntando a otro lado.
                    || (isActive()
                        && hayPoll(threadId)
                        && resource.data.authorId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['poll.isClosed', 'poll'])
                        && pollSoloCambiaIsClosed(threadId))
                    // Adjuntar (cambiar o quitar) la tier list del
                    // hilo propio. Solo la referencia: el contenido
                    // vive en su documento y lo gobiernan sus reglas.
                    || (isActive()
                        && resource.data.authorId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['tierList'])
                        && (!('tierList' in request.resource.data)
                            || request.resource.data.tierList == null
                            || tierRefValida(request.resource.data.tierList)));

      allow delete: if isAdmin() || isModerator()
                    || (isActive() && resource.data.authorId == request.auth.uid);

      // ── VOTOS DE LA ENCUESTA ────────────────────────
      //
      // Un documento por persona (el id es el uid), sin borrado
      // para nadie salvo el equipo. De ahí sale la garantía de
      // "un solo voto": no es que alguien lo compruebe, es que
      // no hay forma física de tener dos.
      //
      // El voto es PRIVADO: solo lo puede leer quien votó. Antes
      // `allow read` era `true` y cualquiera podía recorrer la
      // subcolección para saber quién votó qué. Los totales salen
      // de `pollStats/{threadId}`.
      match /pollVotes/{uid} {
        allow get: if isSelf(uid);
        allow list: if false;

        allow create: if isActive()
                      && request.auth.uid == uid
                      && pollAbierto(threadId)
                      && request.resource.data.optionId is string
                      && request.resource.data.optionId in pollDelHilo(threadId).options
                      && request.resource.data.keys().hasOnly(
                           ['userId', 'optionId', 'createdAt'])
                      && (!('userId' in request.resource.data)
                          || request.resource.data.userId == uid);

        // Cambiar de opinión, solo si el autor lo permitió.
        // Los votos ya escritos siguen siendo intocables en sus
        // campos de identification (uid, createdAt...).
        allow update: if isActive()
                      && request.auth.uid == uid
                      && pollAbierto(threadId)
                      && pollCambiaVotos(threadId)
                      && request.resource.data.optionId in pollDelHilo(threadId).options
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['optionId', 'updatedAt']);

        // Desvotar no existe: quien quiera cambiar, el autor lo
        // habilitó con `allowChangeVote`. El equipo sí puede
        // borrar un voto problemático (moderación), pero no
        // listarlo ni leerlo.
        allow delete: if isModerator();
      }

      // ── ME GUSTA DEL HILO ───────────────────────────
      //
      // Un documento por persona, con el uid como id. No hay
      // `update`: poner o quitar el "me gusta" es crear o borrar
      // este documento, nunca reescribir el de otra persona.
      //
      // El agregado (`likedBy`/`likesCount`) lo calcula la Cloud
      // Function desde esta subcolección. El cliente no lo toca.
      match /likes/{uid} {
        allow read: if true;

        allow create: if isActive()
                      && request.auth.uid == uid
                      && request.resource.data.userId == uid
                      && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
                      && (!('createdAt' in request.resource.data)
                          || request.resource.data.createdAt is timestamp)
                      && exists(/databases/$(database)/documents/threads/$(threadId));

        allow update: if false;

        // Un usuario baneado tampoco puede retirar su "me gusta":
        // el estado de la cuenta se comprueba en las dos direcciones.
        allow delete: if isActive()
                      && request.auth.uid == uid;
      }
    }

    // ======================================================
    // REACCIONES
    // ======================================================
    //
    // Colección PLANA, no subcolección: los comentarios de un
    // hilo, de un anime, de un episodio o de un personaje están
    // todos en `comments/`, igual que los mensajes de chat en
    // `chats/…/messages/`, así que una subcolección del hilo solo
    // alcanzaría a una cosa de cada clase. El id determinista
    // (`reac_<tipo>_<id>_<uid>`) es lo que impide las reacciones
    // duplicadas.
    //
    // La lectura NO es toda pública: hilos y comentarios sí, pero
    // las reacciones a mensajes privados exigen `chatId` y
    // pertenencia al chat. La consulta del cliente tiene que filtrar
    // por `targetType` y, en chats, por `chatId`; las reglas no son
    // un filtro.
    match /reactions/{reactionId} {
      // La barra de un hilo o de un comentario es pública, como el
      // propio hilo. La de un mensaje de chat NO: solo la lee quien
      // es miembro del chat, y para eso el documento tiene que decir
      // a qué chat pertenece.
      allow get: if reaccionPublica(resource.data)
                    || reaccionDeChatAutorizada(resource.data);
      allow list: if reaccionPublica(resource.data)
                     || reaccionDeChatAutorizada(resource.data);

      allow create: if isActive()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.targetType in
                       ['thread', 'comment', 'chat_message']
                    && request.resource.data.targetId is string
                    && request.resource.data.targetId.size() > 0
                    && request.resource.data.targetId.size() <= 150
                    && reaccionTieneChatIdCoherente(request.resource.data)
                    && request.resource.data.keys().hasOnly(
                         ['userId', 'targetType', 'targetId', 'type',
                          'userName', 'chatId', 'createdAt'])
                    && reactionDocDeUid(reactionId,
                                        request.auth.uid,
                                        request.resource.data.targetType,
                                        request.resource.data.targetId)
                    && reactionTypeValido(request.resource.data.type)
                    && objetivoExiste(request.resource.data.targetType,
                                      request.resource.data.targetId);

      // Solo se puede cambiar el TIPO. Tocar `userId`,
      // `targetType`, `targetId` o `chatId` aquí sería quedarse
      // con las reacciones de otra persona o moverlas de sitio.
      //
      // En mensajes de chat también se exige seguir siendo miembro
      // del chat y que el mensaje siga existiendo: una reacción no
      // puede sobrevivir por la puerta de atrás a una expulsión.
      allow update: if isActive()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['type', 'userName', 'createdAt'])
                    && reactionTypeValido(request.resource.data.type)
                    && (reaccionPublica(resource.data)
                        || reaccionDeChatAutorizada(resource.data));

      allow delete: if isActive()
                    && resource.data.userId == request.auth.uid
                    && (reaccionPublica(resource.data)
                        || reaccionDeChatAutorizada(resource.data));
    }

    // ======================================================
    // RESUMEN DE ENCUESTAS (lo escribe el servidor)
    // ======================================================
    //
    // Es la fuente de resultados de la tarjeta, no una simple
    // caché: el cliente ya no puede leer los votos ajenos. Por eso
    // aquí no escribe ni el cliente ni el equipo: solo la Cloud
    // Function `onPollVotesChanged`, con el Admin SDK, que es lo
    // único que se salta estas reglas.
    match /pollStats/{threadId} {
      allow read: if true;
      allow write: if false;
    }

    // ======================================================
    // LIBRO DE CONTADORES DE COMENTARIOS (lo escribe el servidor)
    // ======================================================
    //
    // Un documento por comentario. Sirve para que el trigger de alta
    // sepa si ya sumó y el de baja si ya restó: los triggers de
    // Firestore se entregan "al menos una vez" y sin este registro un
    // reintento dejaría `commentsCount` desfasado.
    //
    // El cliente no lo lee ni lo escribe: no le hace falta para nada.
    match /engagement_ledger/{commentId} {
      allow read, write: if false;
    }

    // ======================================================
    // COMENTARIOS (polimorficos: hilo, anime, episodio, personaje)
    // ======================================================
    match /comments/{commentId} {
      allow read: if true;

      // Un comentario puede no tener texto si lleva un GIF
      // ("respondió con un GIF"), pero tiene que llevar algo:
      // texto, imagen o GIF.
      allow create: if isActive()
                    && request.resource.data.authorId == request.auth.uid
                    // El tipo va en lista blanca y el objetivo TIENE
                    // que existir. Antes bastaba cualquier string:
                    // el comentario no se veía en ningún sitio, pero
                    // el trigger pagaba 5 XP y contaba para medallas.
                    && request.resource.data.targetType is string
                    && request.resource.data.targetType in
                       ['thread', 'anime', 'episode', 'character']
                    && request.resource.data.targetId is string
                    && objetivoDeComentarioExiste(
                         request.resource.data.targetType,
                         request.resource.data.targetId)
                    && request.resource.data.body is string
                    && request.resource.data.body.size() <= 5000
                    && (request.resource.data.body.size() > 0
                        || ('gif' in request.resource.data)
                        || ('imageUrl' in request.resource.data))
                    && (!('imageUrl' in request.resource.data)
                        || (request.resource.data.imageUrl is string
                            && request.resource.data.imageUrl.size() <= 1000))
                    && (!('gif' in request.resource.data)
                        || gifValido(request.resource.data.gif))
                    // Los recuentos de reacciones los lleva el
                    // servidor (ver `onReactionChanged`).
                    && (!('reactionCounts' in request.resource.data))
                    && (!('reactionsTotal' in request.resource.data))
                    // Los "me gusta" nacen en cero; su contador lo
                    // mantiene la Cloud Function.
                    && (!('likedBy' in request.resource.data)
                        || (request.resource.data.likedBy is list
                            && request.resource.data.likedBy.size() == 0))
                    && (!('likesCount' in request.resource.data)
                        || (request.resource.data.likesCount is number
                            && request.resource.data.likesCount == 0));

      allow update: if ((isAdmin() || isModerator())
                        && sinContadoresDeEngagement())
                    || (isActive()
                        && resource.data.authorId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['body'])
                        // El mismo límite que en `create`. Sin esto,
                        // publicar 10 caracteres y editarlos a un
                        // millón esquivaba el tope de 5.000.
                        && request.resource.data.body is string
                        && request.resource.data.body.size() <= 5000
                        && (request.resource.data.body.size() > 0
                            || ('gif' in request.resource.data)
                            || ('imageUrl' in request.resource.data)));

      allow delete: if isAdmin() || isModerator()
                    || (isActive() && resource.data.authorId == request.auth.uid);

      // ── ME GUSTA DEL COMENTARIO ─────────────────────
      //
      // Mismo patrón que el del hilo: un documento por persona con
      // su uid como id, sin `update`, y el agregado lo escribe la
      // Cloud Function. Se exige que el comentario exista para no
      // dejar "me gusta" colgando de un id inventado.
      match /likes/{uid} {
        allow read: if true;

        allow create: if isActive()
                      && request.auth.uid == uid
                      && request.resource.data.userId == uid
                      && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
                      && (!('createdAt' in request.resource.data)
                          || request.resource.data.createdAt is timestamp)
                      && exists(/databases/$(database)/documents/comments/$(commentId));

        allow update: if false;

        allow delete: if isActive()
                      && request.auth.uid == uid;
      }
    }

    // ======================================================
    // TIER LISTS
    // ======================================================
    //
    // Una clasificación visual por niveles. Vive en
    // `tierlists/{id}` y se comparte en hilos (campo
    // `tierList` del thread) y en chats (campo `tierList` del
    // mensaje): esos dos guardan solo `{tierListId, title}` y
    // la leen de aquí. Borrar un hilo o un mensaje NO borra la
    // tier list, porque puede estar publicada en otro sitio.
    //
    // Los niveles y elementos son MAPAS id → definición, y no
    // listas, por el mismo motivo que las opciones de las
    // encuestas: es lo único que las reglas saben comprobar.
    // Con un mapa, un voto tiene que ir a un nivel que existe
    // de verdad (`tierId in tiers`); con una lista no habría
    // forma de exigirlo.
    //
    // No se puede comprobar el contenido de cada nivel o
    // elemento (las reglas no recorren mapas), pero sí los
    // tamaños, que es lo que de verdad protege: sin tope, un
    // mapa con mil entradas se colaría en el documento.
    // ======================================================
    match /tierlists/{tierId} {
      // Públicas para cualquiera; de club solo para sus
      // miembros; las propias siempre para su autor. La lista
      // de "mis tier lists" filtra por `authorId`, que es la
      // misma condición de aquí: así la consulta no devuelve
      // listas ajenas.
      allow read: if resource.data.visibility == 'public'
                  || (isSignedIn() && resource.data.authorId == request.auth.uid)
                  || (isSignedIn() && resource.data.visibility == 'club'
                      && 'clubId' in resource.data
                      && esMiembroClub(resource.data.clubId));

      allow create: if isActive()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.authorName is string
                    && tierValido(request.resource.data);

      // Solo el autor (o un admin) toca su clasificación, y
      // sin cambiarle el dueño ni el origen. El resto de
      // campos editables van en el `hasOnly`.
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.authorId == request.auth.uid
                        && request.resource.data.authorId == resource.data.authorId
                        && tierValido(request.resource.data)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(
                               ['title', 'description', 'category',
                                'tiers', 'items', 'placement', 'poolOrder',
                                'coverUrl', 'visibility', 'clubId',
                                'voting', 'threadId', 'updatedAt']));

      // Borrar no arrastra hilos ni mensajes: esos pintan "ya
      // no disponible" en vez de romperse.
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.authorId == request.auth.uid);

      // ── VOTOS (nivel favorito) ──────────────────────
      //
      // Un documento por persona (el id es el uid), sin
      // borrado para nadie salvo el equipo. De ahí sale la
      // garantía de "un solo voto": no es que alguien lo
      // compruebe, es que no hay forma física de tener dos.
      // Cambiar de nivel solo si el autor lo permitió.
      match /votes/{uid} {
        // Solo quien puede ver la tier list ve sus votos: en
        // una de club, los resultados no salen de ahí.
        allow read: if tierLegible(tierId);

        // Votar exige poder verla: sin esto, cualquiera con el
        // id votaría a ciegas en una tier list de club.
        allow create: if isActive()
                      && request.auth.uid == uid
                      && tierLegible(tierId)
                      && tierVotable(tierId)
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.tierId is string
                      && request.resource.data.tierId in tiersDeTier(tierId)
                      && request.resource.data.keys().hasOnly(
                           ['userId', 'tierId', 'createdAt']);

        allow update: if isActive()
                      && request.auth.uid == uid
                      && tierLegible(tierId)
                      && tierVotable(tierId)
                      && tierPermiteCambio(tierId)
                      && request.resource.data.tierId in tiersDeTier(tierId)
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['tierId', 'updatedAt']);

        // Desvotar no existe, igual que en las encuestas. El
        // equipo sí puede borrar un voto problemático.
        allow delete: if isModerator();
      }
    }

    // ======================================================
    // CLUBES Y COMUNIDADES
    // ======================================================
    // Un club es un grupo temático con su propio chat
    // grupal. La ficha vive en `clubs/{clubId}` y los
    // mensajes en `chats/{chatId}/messages/`, reutilizando
    // el sistema de mensajería que ya tienen los chats
    // privados.
    //
    // La pertenencia está en TRES sitios, y las tres se
    // escriben juntas (ver `services/clubs.ts`):
    //
    //   clubs/{clubId}.members    -> mapa con el rol
    //   chats/{clubId}.memberIds  -> array para las consultas
    //   chats/{chatId}.memberIds  -> lo que comprueban las
    //                                 reglas de los mensajes
    //
    // Lo que más importa aquí es que el cliente NO pueda
    // decidir por sí solo quién es miembro: `memberIds` no
    // se puede tocar libremente, y entrar en un club
    // privado pasa por una solicitud que acepta un
    // moderador.
    // ======================================================

    function clubData(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)).data;
    }

    /**
     * Equipo del club: propietario + moderadores.
     *
     * Se usa para comprobar los canales restringidos (`mods`): el
     * chat de uno de esos canales solo puede tener exactamente a
     * esta gente. `concat` está disponible en el lenguaje de
     * reglas y evita tener que comparar el mapa `members`.
     */
    function equipoDeClub(c) {
      let moderadores = c.moderatorIds is list ? c.moderatorIds : [];
      return moderadores.concat([c.ownerId]);
    }

    function clubExiste(clubId) {
      return exists(/databases/$(database)/documents/clubs/$(clubId));
    }

    function clubChannelExiste(clubId, channelId) {
      return exists(/databases/$(database)/documents/clubs/$(clubId)/channels/$(channelId));
    }

    /**
     * Si un canal es restringido (solo propietario y moderadores).
     *
     * Se usa desde las reglas de `chats/` para que el auto-join
     * de clubes públicos NO sirva para colarse en un canal de
     * moderadores: sin esto, bastaba con añadir el id del chat
     * para leer lo que solo es del equipo del club.
     */
    function canalRestringido(clubSlug, channelId) {
      return channelId is string
             && channelId.size() > 0
             && clubExiste(clubSlug)
             && clubChannelExiste(clubSlug, channelId)
             && get(/databases/$(database)/documents/clubs/$(clubSlug)/channels/$(channelId))
                  .data.visibility == 'mods';
    }

    function esMiembroClub(clubId) {
      return isSignedIn()
             && clubExiste(clubId)
             && request.auth.uid in clubData(clubId).memberIds;
    }

    /**
     * Preferencias personales de una conversación (color, apodo,
     * avisos, favorito). Cada usuario guarda las suyas: cambiar
     * las propias no afecta a las de los demás.
     */
    function chatPrefsValida(p) {
      return p == null
              || (p is map
                  && (!('color' in p)
                      || (p.color is string
                          && p.color.size() == 7
                          && p.color.matches('^#[0-9a-fA-F]{6}$')))
                  && (!('nickname' in p)
                      || (p.nickname is string && p.nickname.size() <= 60))
                  && (!('notify' in p)
                      || p.notify in ['all', 'mentions', 'muted'])
                  && (!('muteUntil' in p)
                      || p.muteUntil in ['1h', '8h', '24h', 'until'])
                  && (!('favorite' in p)
                      || p.favorite is bool)
                  // El FONDO es por conversación: cada chat tiene el
                  // suyo, para que cambiar el de un club no toque el
                  // de los privados. `null` significa «este chat, sin
                  // fondo»; si la clave no está, es que nunca se
                  // tocó y se usa el general.
                  && (!('fondo' in p)
                      || p.fondo == null
                      || (p.fondo is map
                          && p.fondo.size() <= 5
                          && (!('preset' in p.fondo) || p.fondo.preset is string)
                          && (!('url' in p.fondo)
                              || (p.fondo.url is string
                                  && p.fondo.url.size() <= 500
                                  && (p.fondo.url == ''
                                      || p.fondo.url.matches('https://.*'))))
                          && (!('ajuste' in p.fondo)
                              || p.fondo.ajuste in ['cover', 'contain'])
                          && (!('position' in p.fondo)
                              || p.fondo.position in ['center', 'top', 'bottom'])
                          && (!('dim' in p.fondo)
                              || (p.fondo.dim is number
                                  && p.fondo.dim >= 0 && p.fondo.dim <= 80)))));
    }

    function esPropietarioClub(clubId) {
      return isSignedIn()
             && clubExiste(clubId)
             && clubData(clubId).ownerId == request.auth.uid;
    }

    /**
     * Moderador del club: está en `moderatorsIds` o es el
     * propietario.
     *
     * Es INDEPENDIENTE del rol global de geekapoo.es: ser
     * moderador de un club no concede ningún permiso en el
     * panel de administración ni sobre los hilos. Ahí sigue
     * mandando `users/{uid}.role`.
     *
     * La autoridad se lee de `moderatorIds`/`ownerId` y NO de
     * `members[uid].role` a propósito: las reglas pueden
     * comparar un array o un campo de primer nivel enteros,
     * pero no recorrer el mapa `members` clave a clave. Si la
     * autoridad estuviera en el mapa, un moderador podría
     * reescribir su propia ficha escalando sin que ninguna
     * condición pudiera notarlo. El `role` de la ficha se
     * mantiene solo para mostrarlo en la interfaz.
     */
    /**
     * Equipo del club con facultad de moderar: dueño, admin o
     * moderador.
     *
     * Los administradores entran aquí a propósito: según la
     * jerarquía están POR ENCIMA de los moderadores, así que si
     * no estuvieran en esta función no podrían ni quitar un
     * mensaje molesto ni aplicar una sanción (toda sanción
     * escribe además en el documento del club). Sin esta línea,
     * un admin no podría moderar, que es justo lo contrario de lo
     * que significa «admin».
     *
     * Lo que sigue SIN poder hacer un admin o un moderador es
     * tocar `ownerId`, `adminIds`, `moderatorIds` o `permisos`:
     * eso vive en otra rama del `allow update`, más restringida.
     *
     * `adminIds` no existe en los clubes anteriores a este
     * sistema, así que se comprueba con `('adminIds' in c)`.
     */
    function esModeradorClub(clubId) {
      let c = clubData(clubId);
      return esMiembroClub(clubId)
             && (c.ownerId == request.auth.uid
                 || request.auth.uid in c.moderatorIds
                 || ('adminIds' in c
                     && c.adminIds is list
                     && request.auth.uid in c.adminIds));
    }

    // ======================================================
    // MODERACIÓN DE CLUBES
    // ======================================================
    //
    // La jerarquía se lee de los ARRAYS de primer nivel
    // (`ownerId`, `adminIds`, `moderatorIds`) y nunca de
    // `members[uid].role`: ese campo lo puede escribir el
    // cliente y las reglas no podrían recorrer el mapa para
    // compararlo. Con arrays, comparar rangos es un `in`.
    //
    // `adminIds` no existe en los clubes anteriores a este
    // sistema, así que se comprueba con `('adminIds' in c)`
    // antes de usarlo: si la clave no está, leerla daría error de
    // evaluación y TODO lo que dependa de aquí se denegaría,
    // incluidos los clubes antiguos.
    function rangoDeClub(c, uid) {
      return c.ownerId == uid ? 3
           : ('adminIds' in c && c.adminIds is list && uid in c.adminIds) ? 2
           : uid in c.moderatorIds ? 1
           : 0;
    }

    /**
     * Un permiso delegable que está ENCENDIDO.
     *
     * Si el club no guarda ese permiso, el valor por defecto es
     * APAGADO: son capacidades que el propietario tiene que
     * conceder expresamente.
     */
    function permisoActivado(c, nombre) {
      return 'permisos' in c
             && c.permisos is map
             && (nombre in c.permisos)
             && c.permisos[nombre] == true;
    }

    /**
     * Un permiso delegable que viene ENCENDIDO de serie.
     *
     * La diferencia con `permisoActivado` es la clave que se
     * guarda: si NO está, se usa el valor por defecto (encendido);
     * si está en `false`, el propietario lo ha apagado a
     * propósito. Por eso aquí la ausencia NO significa `false`.
     */
    function permisoPorDefecto(c, nombre) {
      return !('permisos' in c)
             || !(c.permisos is map)
             || !(nombre in c.permisos)
             || c.permisos[nombre] == true;
    }

    /** Es administrador de ESTE club (no el admin global de la web). */
    function esAdminClub(c, uid) {
      return 'adminIds' in c
             && c.adminIds is list
             && uid in c.adminIds;
    }

    /**
     * Puede este usuario gestionar los canales del club.
     *
     * El dueño siempre. Un admin solo con `adminGestionaCanales`
     * y un moderador solo con `moderadorGestionaCanales`: los
     * canales son configuración del club y no vienen de serie.
     */
    function puedeGestionarCanales(clubId) {
      let c = clubData(clubId);
      let r = rangoDeClub(c, request.auth.uid);
      return esMiembroClub(clubId)
             && (r == 3
                 || (r == 2 && permisoActivado(c, 'adminGestionaCanales'))
                 || (r == 1 && permisoActivado(c, 'moderadorGestionaCanales')));
    }

    /**
     * Puede este usuario editar el ASPECTO del club (nombre,
     * descripción, icono, banner, normas).
     *
     * El dueño siempre; un admin solo con `adminEditaAspecto`.
     */
    function puedeEditarAspecto(clubId) {
      let c = clubData(clubId);
      return esMiembroClub(clubId)
             && (rangoDeClub(c, request.auth.uid) == 3
                 || (rangoDeClub(c, request.auth.uid) == 2
                     && permisoActivado(c, 'adminEditaAspecto')));
    }

    /**
     * Si la persona tiene ahora mismo una sanción que le impide
     * escribir en el club.
     *
     * El documento es `clubs/{clubId}/sancion/{uid}`, con el id
     * IGUAL al uid. Eso es lo que hace esto posible: las reglas
     * solo pueden consultar la ruta exacta de un documento
     * (`exists()` y `get()` no admiten `where`), y aquí siempre
     * se pregunta por una ruta que ya se conoce.
     *
     * La caducidad se compara contra `request.time` (la hora del
     * SERVIDOR), no contra la del navegador: por eso un silencio
     * caducado sigue caducado tras reiniciar la sesión, y un
     * reloj manipulado no lo alarga.
     */
    function sancionado(clubId, uid) {
      let ref = /databases/$(database)/documents/clubs/$(clubId)/sancion/$(uid);
      return exists(ref)
             && (get(ref).data.expira == null || request.time < get(ref).data.expira);
    }

    /**
     * Puede este usuario FIJAR un mensaje en ESTA conversación.
     *
     * En un chat de club, fijar es una decisión del club: el
     * dueño siempre, un admin con el permiso `adminFijaMensajes`
     * (encendido de serie) y un moderador solo si el propietario
     * se lo concede con `moderadorFijaMensajes`.
     *
     * En un privado o un grupo no hay club detrás: cada
     * conversación es de quienes están en ella, así que cualquier
     * miembro puede fijar.
     */
    /**
     * Los datos del club al que pertenece un chat de club.
     *
     * `null` si el chat no es de club, o si el club ya no
     * existe. Se usa con `null` porque el lenguaje de reglas no
     * tiene `if`: los `get()` sobre rutas que pueden no
     * existir darían error de evaluación.
     */
    function clubDataDeChat(chatId) {
      let c = chatData(chatId);
      return c.type == 'club'
             && c.slug is string
             && exists(/databases/$(database)/documents/clubs/$(c.slug))
             ? get(/databases/$(database)/documents/clubs/$(c.slug)).data
             : null;
    }

    /**
     * Puede este usuario FIJAR un mensaje en ESTA conversación.
     *
     * En un chat de club, fijar es una decisión del club: el
     * dueño siempre, un admin con el permiso `adminFijaMensajes`
     * (encendido de serie) y un moderador solo si el propietario
     * se lo concede con `moderadorFijaMensajes`.
     *
     * En un privado o un grupo no hay club detrás: cada
     * conversación es de quienes están en ella, así que cualquier
     * miembro puede fijar.
     */
    function puedeFijarEnChat(chatId) {
      let club = clubDataDeChat(chatId);
      return isChatMember(chatId)
             && (club == null
                 || (esMiembroClub(club.slug)
                     && (rangoDeClub(club, request.auth.uid) == 3
                         || (rangoDeClub(club, request.auth.uid) == 2
                             && permisoPorDefecto(club, 'adminFijaMensajes'))
                         || (rangoDeClub(club, request.auth.uid) == 1
                             && permisoActivado(club, 'moderadorFijaMensajes')))));
    }

    /**
     * Puede este usuario QUITAR un mensaje de los fijados.
     *
     * Tres vías: quien lo fijó, quien escribió el mensaje (puede
     * quitar su propio fijado) y quien puede fijar en general
     * (el equipo del club).
     */
    function puedeDesfijar(chatId, messageId) {
      let ref = /databases/$(database)/documents/chats/$(chatId)/fijados/$(messageId);
      return exists(ref)
             && (get(ref).data.fijadoPor == request.auth.uid
                 || get(ref).data.autorId == request.auth.uid
                 || puedeFijarEnChat(chatId));
    }
    /**
     * Puede este usuario RETIRAR un mensaje de otro en el chat
     * de un club.
     *
     * El dueño y los administradores siempre. Un moderador solo
     * con el permiso `moderadorRetiraMensajes`, que viene
     * encendido de serie pero el propietario puede apagarlo.
     *
     * Es una función aparte de `esModeradorClubDeChat` porque esa
     * se usa para más cosas (encuestas, canales restringidos) y
     * esta capacidad es la que se puede delegar.
     */
    function puedeRetirarMensajesDeChat(chatId) {
      // Sin `if`: el lenguaje de reglas solo admite expresiones.
      let c = chatData(chatId);
      let club = get(/databases/$(database)/documents/clubs/$(c.slug)).data;
      return isSignedIn()
             && c.type == 'club'
             && c.slug is string
             && exists(/databases/$(database)/documents/clubs/$(c.slug))
             && request.auth.uid in club.memberIds
             && (rangoDeClub(club, request.auth.uid) == 3
                 || rangoDeClub(club, request.auth.uid) == 2
                 || (rangoDeClub(club, request.auth.uid) == 1
                     && permisoPorDefecto(club, 'moderadorRetiraMensajes')));
    }
    /**
     * Puede este chat recibir un mensaje de quien lo escribe.
     *
     * Solo mira los chats de club: en un privado o en un grupo
     * normal no hay sanciones que aplicar. El bloqueo es POR
     * CLUB: silenciarse en uno no toca los demás chats.
     */
    function puedeEscribirEnChat(chatId) {
      // El lenguaje de reglas NO tiene `if` ni retornos tempranos:
      // una función es un `let` de expresiones y un `return`
      // final. Por eso la pregunta se encadena con `||`: si el
      // chat no es de club, o el club no existe, la respuesta es
      // «sí puede escribir» y se sale ahí.
      let c = chatData(chatId);
      return c.type != 'club'
             || !(c.slug is string)
             || !clubExiste(c.slug)
             || !sancionado(c.slug, request.auth.uid);
    }

    /**
     * Si `actor` puede abrir una sanción contra `objetivo`.
     *
     *   1. Que el actor sea del equipo (rango >= 1).
     *   2. Que no se sancione a sí mismo.
     *   3. Que el objetivo sea de rango ESTRICTAMENTE inferior:
     *      nadie toca a alguien de su rango ni de arriba. Así un
     *      moderador no toca a otro moderador, un admin no a otro
     *      admin, y el dueño solo a miembros y mods.
     *   4. Que el actor pueda aplicar ese TIPO: un moderador solo
     *      banea si el propietario lo habilitó, y nunca con
     *      baneo permanente salvo permiso explícito.
     */
    function puedeSancionarA(clubId, actor, objetivo, tipo, permanente) {
      let c = clubData(clubId);
      let rActor = rangoDeClub(c, actor);
      // Todas las barreras van encadenadas con `&&`, y la última
      // es la del tipo de sanción. Al no haber `if`, el orden
      // importa: lo barato va primero (es miembro, es del equipo)
      // y lo que necesita leer `c` va después.
      return esMiembroClub(clubId)
             && rActor >= 1
             && actor != objetivo
             // Rango estrictamente inferior: nadie toca a alguien
             // de su rango ni de arriba.
             && rActor > rangoDeClub(c, objetivo)
             // Un moderador solo banea si el propietario lo
             // habilitó, y el baneo permanente le queda a dueño y
             // admin. Para los demás, estas dos condiciones se
             // cumple siempre (`rActor == 1` es falso).
             && (rActor != 1
                 || (tipo != 'baneo'
                     || (permisoActivado(c, 'moderadorBanea') && !permanente)))
             // El baneo PERMANENTE es del dueño, y de los admins
             // solo si el propietario lo ha habilitado.
             && (rActor != 2
                 || (tipo != 'baneo' || !permanente
                     || permisoActivado(c, 'adminBaneaPermanente')));
    }

    /**
     * Si `actor` puede levantar (borrar) la sanción vigente de
     * `objetivo`.
     *
     * Nadie toca lo de alguien de rango igual o superior. El
     * dueño puede levantarlo todo, que es lo que hace falta para
     * deshacer un error.
     */
    function puedeLevantarDe(clubId, actor, objetivo) {
      let c = clubData(clubId);
      let rActor = rangoDeClub(c, actor);
      let ref = /databases/$(database)/documents/clubs/$(clubId)/sancion/$(objetivo);
      // Salidas válidas, encadenadas:
      //
      //   · no es del equipo → no puede;
      //   · levanta la suya, o la del club está vacía → sí;
      //   · levanta la que aplicaste TÚ, aunque sea del mismo
      //     rango: si has silenciado a alguien y te arrepientes,
      //     poder deshacerlo es lo mínimo. Sin esta línea, un
      //     moderador se quedaba sin poder quitar ni las
      //     sanciones que él mismo había puesto, y el botón
      //     del panel le mentía: el cliente lo daba por bueno y
      //     el servidor lo rechazaba.
      //   · si la puso alguien de rango superior, no;
      //   · si es del mismo rango y es moderador, hace falta el
      //     permiso del propietario.
      return esMiembroClub(clubId)
             && rActor >= 1
             && (actor == objetivo
                 || !exists(ref)
                 || (exists(ref) && actor == get(ref).data.aplicadaPor)
                 || (rActor > rangoDeClub(c, get(ref).data.aplicadaPor)
                     && (rActor != 2
                         || permisoActivado(c, 'adminLevanta')))
                 || (rActor == rangoDeClub(c, get(ref).data.aplicadaPor)
                     && rActor == 1
                     && permisoActivado(c, 'moderadorLevanta')));
    }

    /**
     * Forma del documento de sanción VIGENTE.
     *
     * Recalca `clubId` contra la ruta: si no, un moderador del
     * club A podría abrir `clubs/B/sancion/{uid}` con su club A
     * dentro y las reglas no se enterarían.
     */
    function sancionVigenteValida(s, clubId, objetivo) {
      return s is map
             && ('clubId' in s && s.clubId == clubId)
             && ('tipo' in s && s.tipo in ['silencio', 'baneo'])
             && ('objetivoUid' in s && s.objetivoUid == objetivo)
             && ('objetivoNombre' in s && s.objetivoNombre is string)
             && ('motivo' in s && s.motivo is string && s.motivo.size() >= 5
                 && s.motivo.size() <= 500)
             && ('inicio' in s)
             && ('expira' in s && (s.expira == null || s.expira is timestamp))
             && ('permanente' in s && s.permanente is bool)
             && ('aplicadaPor' in s && s.aplicadaPor == request.auth.uid)
             && ('aplicadaPorNombre' in s && s.aplicadaPorNombre is string)
             && ('aplicadaPorRango' in s
                 && s.aplicadaPorRango in ['owner', 'admin', 'moderator', 'member'])
             // `rolPrevio` guarda el cargo que tenía antes del
             // baneo, para devolverla al club tal cual estaba.
             && (!('rolPrevio' in s)
                 || s.rolPrevio in ['owner', 'admin', 'moderator', 'member'])
             // Un silencio NUNCA es permanente: sin fecha de
             // fin sería un baneo sin salir del club. Solo el
             // baneo lo admite, y solo el dueño o un admin.
             && (s.tipo != 'silencio' || (s.permanente == false && s.expira != null))
             && (s.permanente == false || s.expira == null);
    }

    /** Forma de una entrada del historial. */
    function sancionHistorialValida(s, clubId) {
      return s is map
             && ('clubId' in s && s.clubId == clubId)
             // 'advertencia' solo es válida en el historial: es un
             // aviso sin consecuencia, no una sanción.
             && ('tipo' in s && s.tipo in ['silencio', 'baneo', 'advertencia'])
             && (s.tipo != 'advertencia' || (s.fin == null && s.permanente == false))
             && ('objetivoUid' in s && s.objetivoUid is string)
             && ('objetivoNombre' in s && s.objetivoNombre is string)
             && ('motivo' in s && s.motivo is string && s.motivo.size() >= 5
                 && s.motivo.size() <= 500)
             && ('inicio' in s && s.inicio is string)
             && ('fin' in s && (s.fin == null || s.fin is string))
             && ('permanente' in s && s.permanente is bool)
             && ('aplicadaPor' in s && s.aplicadaPor == request.auth.uid)
             && ('aplicadaPorNombre' in s && s.aplicadaPorNombre is string)
             && ('aplicadaPorRango' in s
                 && s.aplicadaPorRango in ['owner', 'admin', 'moderator', 'member'])
             && ('retirada' in s && s.retirada is bool)
             // `rolPrevio` es el cargo que tenía la persona antes
             // del baneo: al desbanearla se le devuelve el club
             // con ese cargo, no con uno por defecto.
             && (!('rolPrevio' in s)
                 || s.rolPrevio in ['owner', 'admin', 'moderator', 'member'])
             && (s.tipo != 'silencio' || (s.permanente == false && s.fin != null));
    }

    /** Forma válida del mapa de miembros al crear el club. */
    function miembrosValidos(m) {
      return m is map
             && m.size() == 1
             // El creador tiene que estar dentro y ser
             // 'owner', y nadie más: el resto entra por
             // solicitud o por invitación del propietario.
             && request.auth.uid in m
             && m[request.auth.uid].role == 'owner';
    }

    /**
     * Si el mapa de miembros ha cambiado SOLO en claves
     * ajenas (nunca en la del que escribe).
     *
     * Ahora que los roles viven en `moderatorIds`/`ownerId`,
     * esta función sirve para que un moderador no se quite
     * un silencio a sí mismo: su propia ficha en `members`
     * (joinedAt, mutedUntil) no puede tocarla.
     */
    function soloAJenos() {
      let antes = resource.data.members;
      let despues = request.resource.data.members;
      let yo = request.auth.uid;
      let estaba = yo in antes.keys();

      // Ni me añado ni desaparezco, y si ya estaba mi ficha no cambia.
      return (estaba == (yo in despues.keys()))
             && (!estaba || antes[yo] == despues[yo]);
    }

    /**
     * Que el mapa de miembros solo pierde o gana gente, y que
     * NADIE cambia de rol.
     *
     * Es lo que reserva «nombrar moderadores» al propietario: un
     * moderador puede expulsar (quitar una clave) y silenciar
     * (cambiar `mutedUntil`), pero si pudiera tocar `role` se
     * haría propietario a sí mismo. Ver `esModeradorClub`.
     */

    /**
     * El propietario no puede quedarse fuera de su propio club.
     *
     * Si la propiedad sigue siendo suya, el dueño tiene que SEGUIR
     * en la lista de miembros y en el mapa de roles. Sin esto
     * podría borrarse a sí mismo de `members` y dejar el club sin
     * nadie que lo administre, que es justo el caso que la regla
     * de «salir del club» evita: para salir hay que transferir la
     * propiedad antes, y al transferirla otra persona ocupa su
     * sitio (el dueño anterior baja a moderador, no se va).
     */
    function duenoSigueDentro() {
      return request.resource.data.ownerId != resource.data.ownerId
             || (request.resource.data.ownerId in request.resource.data.memberIds
                 && request.resource.data.ownerId
                      in request.resource.data.members.keys());
    }

    /**
     * El cliente NO puede dar de alta a nadie en el club.
     *
     * Las altas pasan por `unirseClubPublico` o
     * `responderSolicitudClub`, que usan el Admin SDK y escriben la
     * ficha y los chats en una transacción. Si el propietario o un
     * moderador pudieran añadir desde el navegador, la persona
     * entraría sin consentimiento y el trigger de estadísticas le
     * daría la medalla de "club unido" sin haber hecho nada.
     *
     * La comprobación es de SUBCONJUNTO: la lista y el mapa nuevos
     * solo pueden conservar claves que ya estaban. Quitar gente
     * sigue permitido; añadirla, no.
     */
    function sinAltasDeMiembros() {
      return resource.data.memberIds is list
             && request.resource.data.memberIds is list
             && resource.data.members is map
             && request.resource.data.members is map
             && resource.data.memberIds.hasAll(request.resource.data.memberIds)
             && resource.data.members.keys()
                  .hasAll(request.resource.data.members.keys());
    }

    match /clubs/{clubId} {
      // ── Lectura ─────────────────────────────────────
      // Los clubes públicos y por solicitud son legibles
      // para cualquiera con sesión: es lo que permite la
      // galería de descubrimiento. Los privados solo los
      // ven sus miembros, igual que sus mensajes.
      //
      // El `resource == null` es para el `get` de un slug
      // que NO existe: sin él, `slugDisponible()` (que hace
      // `getDoc(clubs/slug)` para comprobar duplicados)
      // falla con PERMISSION_DENIED en lugar de devolver
      // "no existe", y el modal enseña el crudo "Missing or
      // insufficient permissions". Con el null, un slug libre
      // se puede leer (no hay nada que proteger) y un slug
      // privado ocupado sigue denegado (el cliente lo trata
      // como "ocupado").
      // Para `list` el `resource` nunca es null, así que la
      // galería sigue sin ver privados ajenos: `listarClubes`
      // filtra por accessType en la consulta.
      allow read: if isSignedIn()
                  && (resource == null
                      || resource.data.accessType in ['public', 'request']
                      || request.auth.uid in resource.data.memberIds);

      // ── Creación ────────────────────────────────────
      // Cualquier usuario con sesión puede crear un club, y al
      // crearlo queda como único miembro y propietario.
      //
      // `moderatorIds` tiene que venir vacío: si no, cualquiera
      // podría estrenar el club con moderadores inventados.
      allow create: if isActive()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.moderatorIds is list
                    && request.resource.data.moderatorIds.size() == 0
                    && request.resource.data.memberIds is list
                    && request.resource.data.memberIds.size() == 1
                    && request.auth.uid in request.resource.data.memberIds
                    && request.resource.data.members is map
                    && miembrosValidos(request.resource.data.members)
                    && request.resource.data.memberCount == 1
                    // El id del documento ES el slug.
                    && clubId == request.resource.data.slug
                    && request.resource.data.slug is string
                    && request.resource.data.slug.size() >= 3
                    && request.resource.data.slug.size() <= 40
                    && request.resource.data.slug.matches('^[a-z0-9-]+$')
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 3
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.description is string
                    && request.resource.data.description.size() >= 10
                    && request.resource.data.description.size() <= 500
                    && request.resource.data.rules is string
                    && request.resource.data.rules.size() <= 1000
                    && request.resource.data.accessType in ['public', 'private', 'request']
                    && request.resource.data.chatId is string
                    && request.resource.data.chatId.size() > 0
                    // El chat tiene que existir y ser EL chat de este
                    // club: del mismo dueño, con el mismo slug y con
                    // el creador como único miembro. Antes bastaba
                    // cualquier string: un baneado creaba clubes
                    // huérfanos o apuntando al chat de otra persona.
                    && chatExiste(request.resource.data.chatId)
                    && chatData(request.resource.data.chatId).type == 'club'
                    && chatData(request.resource.data.chatId).slug == clubId
                    && chatData(request.resource.data.chatId).ownerId
                         == request.auth.uid
                    && chatData(request.resource.data.chatId).memberIds is list
                    && chatData(request.resource.data.chatId).memberIds.size() == 1
                    && chatData(request.resource.data.chatId).memberIds
                         .hasOnly([request.auth.uid]);

      // ── Actualización ───────────────────────────────
      //
      // Reparto de permisos, y ninguno es "cualquier
      // miembro puede tocar lo que quiera":
      //
      //   · admin global   -> todo
      //   · propietario    -> configuración Y miembros Y
      //                       roles Y propiedad (transferirla)
      //   · moderador      -> la ficha de OTROS miembros
      //                       (expulsar o silenciar), pero NO
      //                       la configuración, ni los roles,
      //                       ni la propiedad
      //   · cualquier otro -> solo salirse o entrar (si el club
      //                       es público)
      //
      // LOS ROLES NO SE TOCAN DESDE LA FICHA DE MIEMBRO.
      // `affectedKeys()` sobre un mapa anidado solo devuelve la
      // clave de primer nivel ("members"), nunca el campo
      // concreto que cambió dentro, así que ninguna regla
      // podría distinguir «le han cambiado el rol» de «le han
      // cambiado el silencio». Por eso la autoridad vive en
      // `ownerId` y `moderatorIds` (arriba): cambiar un rol es
      // tocar uno de esos dos campos, y la rama del moderador
      // no los incluye entre las claves permitidas. No hace
      // falta ninguna función que compare mapas clave a clave
      // porque las reglas no saben hacerlo.
      //
      // `soloAJenos` impide que un moderador escriba su propia
      // ficha (por ejemplo para quitarse un silencio él solo).
      // `duenoSigueDentro` impide que el propietario se borre
      // a sí mismo y deje el club sin nadie al mando; en la
      // rama del moderador hace lo mismo con el dueño: un
      // moderador tampoco puede expulsar al propietario.
      allow update: if isActive()
                    && (isAdmin()
                    // El dueño: configuración, roles, altas y bajas.
                    // La puerta P0 es `isActive()`: un dueño baneado
                    // ya no puede añadir ni echar a nadie (C3/C4).
                    // Que un dueño ACTIVO pueda dar de alta sin el
                    // consentimiento del otro sigue siendo un asunto
                    // de producto/estadísticas (P1), no de esta regla.
                    || (esPropietarioClub(clubId)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(
                               ['name', 'description', 'coverUrl', 'iconUrl',
                                'rules', 'accessType', 'members', 'memberIds',
                                'memberCount', 'moderatorIds', 'adminIds',
                                'ownerId', 'permisos', 'updatedAt'])
                        && duenoSigueDentro()
                        && sinAltasDeMiembros()
                        && request.resource.data.memberCount
                             == request.resource.data.memberIds.size())
                    // El ASPECTO del club, para un admin con el
                    // permiso 'adminEditaAspecto' concedido. Solo
                    // eso: ni los roles, ni los miembros, ni la
                    // propiedad.
                    || (puedeEditarAspecto(clubId)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(
                               ['name', 'description', 'coverUrl', 'iconUrl',
                                'rules', 'updatedAt'])
                        && duenoSigueDentro())
                    // El equipo que no es el dueño (admins y
                    // moderadores): la ficha de OTROS miembros.
                    //
                    //   · silenciar   → los dos, siempre.
                    //   · expulsar    → solo un admin con
                    //                     'adminExpulsa'. Se
                    //                     distingue porque
                    //                     expulsar cambia la
                    //                     lista de miembros
                    //                     ('memberIds'), y
                    //                     silenciar no.
                    //   · nada más: ni roles, ni permisos, ni
                    //     propiedad, ni configuración.
                    || (esModeradorClub(clubId)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(
                               ['members', 'memberIds', 'memberCount', 'updatedAt'])
                        && soloAJenos()
                        && duenoSigueDentro()
                        && sinAltasDeMiembros()
                        && request.resource.data.memberCount
                             == request.resource.data.memberIds.size()
                        && ((request.resource.data.memberIds.size()
                                  == resource.data.memberIds.size()
                              && request.resource.data.memberIds.hasAll(resource.data.memberIds)
                              && resource.data.memberIds.hasAll(request.resource.data.memberIds))
                            // AÑADIR a alguien ya NO se hace desde el
                            // cliente: aceptar una solicitud es cosa de
                            // `responderSolicitudClub`, que añade a la
                            // persona al club y a todos sus chats en una
                            // transacción. Si el equipo pudiera tocar
                            // `memberIds` desde aquí, se podría aceptar
                            // sin solicitud y sin pasar por los chats.
                            // EXPULSAR a alguien (quitándolo) es otra
                            // cosa: solo un admin con el permiso. El
                            // dueño tiene su propia rama más arriba.
                            || (request.resource.data.memberIds.size()
                                 == resource.data.memberIds.size() - 1
                                && esAdminClub(clubData(clubId), request.auth.uid)
                                && permisoActivado(clubData(clubId), 'adminExpulsa')))));

      // Salir del club: quitarse a uno mismo de las tres
      // listas. Exactamente una persona menos, y soy yo.
      //
      // El propietario NO puede usar esta vía: si no, un
      // club se quedaría sin nadie que lo administre. Tiene
      // que transferir la propiedad o borrarlo antes.
      allow update: if isActive()
                    && esMiembroClub(clubId)
                    && resource.data.ownerId != request.auth.uid
                    && request.resource.data.memberIds is list
                    && !(request.auth.uid in request.resource.data.memberIds)
                    && request.resource.data.memberIds.size()
                         == resource.data.memberIds.size() - 1
                    && !(request.auth.uid in request.resource.data.members.keys())
                    && request.resource.data.members.size()
                         == resource.data.members.size() - 1
                    && resource.data.members.keys()
                         .hasAll(request.resource.data.members.keys())
                    && request.resource.data.memberCount
                         == request.resource.data.memberIds.size()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['members', 'memberIds', 'memberCount', 'updatedAt']);

      // Entrar en un club PÚBLICO ya NO se hace desde el cliente.
      // Lo hace `unirseClubPublico`, que añade a la persona al club
      // y a todos sus chats en una sola transacción. Si el cliente
      // pudiera tocar `memberIds`, entraría sin pasar por los chats
      // (y el trigger de estadísticas le contaría el club).

      // ── Borrado ─────────────────────────────────────
      // Solo el propietario (o un admin global). Borrar un
      // club se lleva por delante el acceso al chat de
      // todos sus miembros, y eso no lo decide un moderador.
      allow delete: if isActive()
                    && (esPropietarioClub(clubId) || isAdmin());

      // ── Solicitudes de acceso ───────────────────────
      //
      // Un documento por persona y club: el id es
      // `{slug}_{uid}`. Al ser determinista, repetir la
      // solicitud no crea un documento nuevo, así que nadie
      // puede inundar el club pidiendo cien veces.
      //
      //   · crear: cualquier usuario activo que no sea ya
      //     miembro, y solo para un club que admita
      //     solicitudes.
      //   · leer: quien la envió, o un moderador del club.
      //   · aceptar/rechazar: moderador o propietario.
      //     Aceptar NO crea la membresía aquí: eso se hace
      //     en el documento del club, cuyas reglas ya
      //     comprueban quién puede tocar `members`.
      match /requests/{requestId} {
        allow read: if isSignedIn()
                    && (resource.data.fromId == request.auth.uid
                        || esModeradorClub(clubId));

        allow create: if isActive()
                      && request.resource.data.fromId == request.auth.uid
                      && request.resource.data.clubId == clubId
                      && request.resource.data.status == 'pending'
                      && request.resource.data.keys().hasOnly(
                           ['clubId', 'clubName', 'fromId', 'fromName',
                            'fromAvatar', 'status', 'createdAt'])
                      && !esMiembroClub(clubId)
                      && clubExiste(clubId)
                      && clubData(clubId).accessType != 'public'
                      // Con un baneo vigente tampoco se puede
                      // PEDIR entrar: la solicitud no se
                      // aceptaría, y dejarla pasar solo
                      // genera ruido.
                      && !sancionado(clubId, request.auth.uid)
                      && requestId == request.resource.data.clubId
                                      + '_' + request.auth.uid;

        // Quien la envió puede CANCELARLA, y también puede
        // volver a pulsar «Solicitar acceso» sin que falle: el
        // documento es el mismo (id determinista) y solo cambia
        // la fecha. Sin esta segunda rama, un segundo clic daba
        // permission-denied y parecía un fallo de la web.
        //
        // ACEPTAR o RECHAZAR ya no se hace desde el cliente: lo
        // hace la Cloud Function `responderSolicitudClub`, que
        // comprueba el rango del que responde y añade al miembro
        // a TODOS los chats del club en la misma transacción. Si
        // el cliente pudiera escribir `accepted`, se estaría
        // aceptando su propia solicitud y el estado dejaría de
        // ser fiable.
        allow update: if isActive()
                      && resource.data.fromId == request.auth.uid
                      && (
                        (request.resource.data.status == 'cancelled'
                          && request.resource.data.diff(resource.data)
                               .affectedKeys().hasOnly(
                                 ['status', 'respondedAt', 'respondedBy']))
                        || (request.resource.data.status == 'pending'
                          && request.resource.data.diff(resource.data)
                               .affectedKeys().hasOnly(['createdAt']))
                      );

        allow delete: if isActive()
                      && (isAdmin() || esModeradorClub(clubId));
      }

      // ── Sanciones vigentes ────────────────────────────
      //
      // `clubs/{clubId}/sancion/{uid}`: UNA sanción viva por
      // persona. El id del documento es su uid a propósito, para
      // que las reglas puedan consultarla con `exists()`/`get()`
      // (que solo aceptan la ruta exacta de un documento) y así
      // bloquear el envío de mensajes en el chat del club.
      //
      //   · crear/editar: el equipo, y solo contra alguien de
      //     rango estrictamente inferior (`puedeSancionarA`).
      //     Editar cubre el caso de renewar una sanción caducada
      //     que sigue ahí sin borrar.
      //   · leer: la persona sancionada (para ver su aviso con el
      //     motivo) y el equipo del club (para el panel). NO el
      //     resto de miembros: los motivos no son públicos.
      //   · borrar: quien pueda levantarla.
      match /sancion/{uid} {
        allow read: if esModeradorClub(clubId)
                    || (isSignedIn() && request.auth.uid == uid);

        allow create, update: if isActive()
                              && puedeSancionarA(
                                  clubId,
                                  request.auth.uid,
                                  uid,
                                  request.resource.data.tipo,
                                  request.resource.data.permanente == true)
                              && sancionVigenteValida(request.resource.data, clubId, uid);

        allow delete: if isActive()
                      && puedeLevantarDe(clubId, request.auth.uid, uid);
      }

      // ── Historial de sanciones ───────────────────────
      //
      // Un documento por acción (silencio, baneo, retirada o
      // cambio de rango). SOLO SE CREA: ni se edita ni se borra
      // desde el cliente, ni siquiera siendo el propietario. Es la
      // traza que se consulta si hay una disputa entre miembros, y
      // por eso tiene que ser inalterable una vez escrita.
      match /sanciones/{sancionId} {
        allow read: if esModeradorClub(clubId)
                    || (isSignedIn() && resource.data.objetivoUid == request.auth.uid);

        allow create: if isActive()
                      && esModeradorClub(clubId)
                      && sancionHistorialValida(request.resource.data, clubId);

        allow update, delete: if false;
      }

      // ── Canales temáticos ─────────────────────────────
      //
      // Un canal es una ficha en `clubs/{clubId}/channels/{id}`
      // con su historial en `chats/{chatId}/messages/`. El `id`
      // es un slug estable e inmutable (es el id del documento):
      // renombrar cambia `name`, nunca `id`, para no romper los
      // mensajes ya asociados.
      //
      //   · leer: cualquier miembro del club. La lista incluye
      //     los metadatos de los restringidos (como en Discord,
      //     que enseña los candados); su CONTENIDO lo protegen
      //     las reglas de los mensajes, no esta lista.
      //   · crear/editar/ordenar/eliminar: propietario o
      //     moderador DEL CLUB (nunca global, nunca de otro
      //     club). El `general` no se puede borrar ni
      //     restringir: es la conversación principal.
      //   · migración: cualquier miembro puede crear SOLO el
      //     `general` apuntando al chat histórico del club, para
      //     que los clubes anteriores a los canales no pierdan
      //     su historial. No concede nada: ese chat ya era
      //     legible para él.
      match /channels/{channelId} {
        // Lectura: la LISTA la ve cualquier miembro, y también
        // quien pueda descubrir el club (públicos o por
        // solicitud), porque para unirse hay que saber qué
        // canales hay. Los clubes privados no se listan desde
        // fuera.
        //
        // La lista incluye los metadatos de los restringidos
        // (como en Discord, que enseña los candados); su
        // CONTENIDO lo protegen el `get` de aquí y las reglas
        // de los mensajes, no esta lista.
        allow get: if esMiembroClub(clubId)
                   && (resource == null
                       || resource.data.visibility == 'all'
                       || esModeradorClub(clubId));
        allow list: if esMiembroClub(clubId)
                    || (clubExiste(clubId)
                        && clubData(clubId).accessType in ['public', 'request']);

        allow create: if isActive()
                      && (puedeGestionarCanales(clubId) || isAdmin())
                      && request.resource.data.id == channelId
                      && request.resource.data.clubId == clubId
                      && request.resource.data.chatId is string
                      && request.resource.data.chatId.size() > 0
                      && request.resource.data.name is string
                      && request.resource.data.name.size() >= 1
                      && request.resource.data.name.size() <= 40
                      && request.resource.data.description is string
                      && request.resource.data.description.size() <= 280
                      && request.resource.data.type == 'text'
                      && request.resource.data.visibility in ['all', 'mods']
                      && request.resource.data.spoiler is bool
                      && request.resource.data.order is number
                      && request.resource.data.createdBy == request.auth.uid
                      // El chat al que apunta el canal tiene que ser
                      // EXACTAMENTE el suyo: del mismo club, con el
                      // mismo `channelId` y con la lista de miembros
                      // que corresponde a su visibilidad. Sin esto,
                      // el equipo podía enlazar un chat cualquiera
                      // (por ejemplo uno privado con gente de fuera)
                      // y convertirlo en canal del club.
                      && chatExiste(request.resource.data.chatId)
                      && chatData(request.resource.data.chatId).type == 'club'
                      && chatData(request.resource.data.chatId).slug == clubId
                      && chatData(request.resource.data.chatId).channelId == channelId
                      && chatData(request.resource.data.chatId).memberIds is list
                      && clubData(clubId).memberIds is list
                      && (
                        (request.resource.data.visibility == 'all'
                          && chatData(request.resource.data.chatId).memberIds.hasAll(
                               clubData(clubId).memberIds)
                          && chatData(request.resource.data.chatId).memberIds.hasOnly(
                               clubData(clubId).memberIds))
                        // `mods`: solo el equipo, sin outsiders.
                        // No se exige `hasAll` porque puede haber
                        // moderadores antiguos en `moderatorIds` que
                        // ya no son miembros; el chat del canal se
                        // crea con los activos. El dueño sí tiene
                        // que estar.
                        || (request.resource.data.visibility == 'mods'
                          && chatData(request.resource.data.chatId).memberIds.hasOnly(
                               equipoDeClub(clubData(clubId)))
                          && clubData(clubId).ownerId
                               in chatData(request.resource.data.chatId).memberIds)
                      )
                      && (!('chatFondo' in request.resource.data)
                          || request.resource.data.chatFondo == null
                          || (request.resource.data.chatFondo is map
                              && (!('preset' in request.resource.data.chatFondo)
                                  || request.resource.data.chatFondo.preset is string)
                              && (!('url' in request.resource.data.chatFondo)
                                  || (request.resource.data.chatFondo.url is string
                                      && request.resource.data.chatFondo.url.size() <= 500
                                      && (request.resource.data.chatFondo.url == ''
                                          || request.resource.data.chatFondo.url
                                               .matches('https://.*'))))
                              && (!('position' in request.resource.data.chatFondo)
                                  || request.resource.data.chatFondo.position
                                       in ['center', 'top', 'bottom'])
                              && (!('dim' in request.resource.data.chatFondo)
                                  || (request.resource.data.chatFondo.dim is number
                                      && request.resource.data.chatFondo.dim >= 0
                                      && request.resource.data.chatFondo.dim <= 80))))
                      && (!('chatApariencia' in request.resource.data)
                          || request.resource.data.chatApariencia == null
                          || (request.resource.data.chatApariencia is map
                              && (!('tema' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.tema is string)
                              && (!('colorPropio' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.colorPropio == null
                                  || (request.resource.data.chatApariencia.colorPropio is string
                                      && request.resource.data.chatApariencia.colorPropio
                                           .matches('^#[0-9a-fA-F]{6}$')))
                              && (!('colorRecibido' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.colorRecibido == null
                                  || (request.resource.data.chatApariencia.colorRecibido is string
                                      && request.resource.data.chatApariencia.colorRecibido
                                           .matches('^#[0-9a-fA-F]{6}$')))
                              && (!('textoPropio' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.textoPropio == null
                                  || (request.resource.data.chatApariencia.textoPropio is string
                                      && request.resource.data.chatApariencia.textoPropio
                                           .matches('^#[0-9a-fA-F]{6}$')))
                              && (!('textoRecibido' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.textoRecibido == null
                                  || (request.resource.data.chatApariencia.textoRecibido is string
                                      && request.resource.data.chatApariencia.textoRecibido
                                           .matches('^#[0-9a-fA-F]{6}$')))
                              && (!('fondo' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.fondo == null
                                  || (request.resource.data.chatApariencia.fondo is map
                                      && (!('preset'
                                              in request.resource.data.chatApariencia.fondo)
                                          || request.resource.data.chatApariencia.fondo.preset
                                               is string)
                                      && (!('dim'
                                            in request.resource.data.chatApariencia.fondo)
                                          || (request.resource.data.chatApariencia.fondo.dim
                                              is number
                                              && request.resource.data.chatApariencia.fondo.dim
                                                   >= 0
                                              && request.resource.data.chatApariencia.fondo.dim
                                                   <= 80))))
                              && (!('forma' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.forma is string)
                              && (!('estilo' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.estilo is string)
                              && (!('letra' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.letra is string)
                              && (!('espaciado' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.espaciado is string)
                              && (!('ancho' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.ancho is string)
                              && (!('reducirMovimiento'
                                    in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.reducirMovimiento
                                       is bool)))
                      // El `id` es un slug interno: minúsculas,
                      // números y guiones, sin espacios.
                      && channelId.size() >= 1
                      && channelId.size() <= 30
                      && channelId.matches('^[a-z0-9-]+$');

        // Migración del `general` en clubes antiguos: el chat ya
        // existe y ya era legible, así que crearlo no abre nada.
        // Va clavado al `chatId` histórico del club, con
        // visibilidad pública y sin spoilers.
        allow create: if isActive()
                      && esMiembroClub(clubId)
                      && channelId == 'general'
                      && !clubChannelExiste(clubId, channelId)
                      && request.resource.data.id == 'general'
                      && request.resource.data.clubId == clubId
                      && request.resource.data.chatId == clubData(clubId).chatId
                      && request.resource.data.name is string
                      && request.resource.data.name.size() >= 1
                      && request.resource.data.name.size() <= 40
                      && request.resource.data.description is string
                      && request.resource.data.description.size() <= 280
                      && request.resource.data.type == 'text'
                      && request.resource.data.visibility == 'all'
                      && request.resource.data.spoiler == false
                      && request.resource.data.order is number
                      // El `general` migrado reutiliza el chat del
                      // propietario y la medalla se la lleva él. Si
                      // cualquier miembro pudiera poner otro uid,
                      // inflaría las estadísticas de un tercero.
                      && request.resource.data.createdBy
                           == clubData(clubId).ownerId;

        // Editar: nombre, descripción, visibilidad, spoilers y
        // orden. El `id`, el `clubId`, el `chatId`, el creador y
        // la creación no se tocan nunca. El `general` sigue
        // público siempre.
        allow update: if isActive()
                      && (puedeGestionarCanales(clubId) || isAdmin())
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(
                             ['name', 'description',
                              'spoiler', 'order', 'chatFondo', 'chatApariencia', 'updatedAt'])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() >= 1
                      && request.resource.data.name.size() <= 40
                      && request.resource.data.description is string
                      && request.resource.data.description.size() <= 280
                      && request.resource.data.visibility in ['all', 'mods']
                      && request.resource.data.spoiler is bool
                      && request.resource.data.order is number
                      && (!('chatFondo' in request.resource.data)
                          || request.resource.data.chatFondo == null
                          || (request.resource.data.chatFondo is map
                              && (!('preset' in request.resource.data.chatFondo)
                                  || request.resource.data.chatFondo.preset is string)
                              && (!('url' in request.resource.data.chatFondo)
                                  || (request.resource.data.chatFondo.url is string
                                      && request.resource.data.chatFondo.url.size() <= 500
                                      && (request.resource.data.chatFondo.url == ''
                                          || request.resource.data.chatFondo.url
                                               .matches('https://.*'))))
                              && (!('position' in request.resource.data.chatFondo)
                                  || request.resource.data.chatFondo.position
                                       in ['center', 'top', 'bottom'])
                              && (!('dim' in request.resource.data.chatFondo)
                                  || (request.resource.data.chatFondo.dim is number
                                      && request.resource.data.chatFondo.dim >= 0
                                      && request.resource.data.chatFondo.dim <= 80))))
                      && (!('chatApariencia' in request.resource.data)
                          || request.resource.data.chatApariencia == null
                          || (request.resource.data.chatApariencia is map
                              && (!('tema' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.tema is string)
                              && (!('colorPropio' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.colorPropio == null
                                  || (request.resource.data.chatApariencia.colorPropio is string
                                      && request.resource.data.chatApariencia.colorPropio
                                           .matches('^#[0-9a-fA-F]{6}$')))
                              && (!('colorRecibido' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.colorRecibido == null
                                  || (request.resource.data.chatApariencia.colorRecibido is string
                                      && request.resource.data.chatApariencia.colorRecibido
                                           .matches('^#[0-9a-fA-F]{6}$')))
                              && (!('textoPropio' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.textoPropio == null
                                  || (request.resource.data.chatApariencia.textoPropio is string
                                      && request.resource.data.chatApariencia.textoPropio
                                           .matches('^#[0-9a-fA-F]{6}$')))
                              && (!('textoRecibido' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.textoRecibido == null
                                  || (request.resource.data.chatApariencia.textoRecibido is string
                                      && request.resource.data.chatApariencia.textoRecibido
                                           .matches('^#[0-9a-fA-F]{6}$')))
                              && (!('fondo' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.fondo == null
                                  || (request.resource.data.chatApariencia.fondo is map
                                      && (!('preset'
                                              in request.resource.data.chatApariencia.fondo)
                                          || request.resource.data.chatApariencia.fondo.preset
                                               is string)
                                      && (!('dim'
                                            in request.resource.data.chatApariencia.fondo)
                                          || (request.resource.data.chatApariencia.fondo.dim
                                              is number
                                              && request.resource.data.chatApariencia.fondo.dim
                                                   >= 0
                                              && request.resource.data.chatApariencia.fondo.dim
                                                   <= 80))))
                              && (!('forma' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.forma is string)
                              && (!('estilo' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.estilo is string)
                              && (!('letra' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.letra is string)
                              && (!('espaciado' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.espaciado is string)
                              && (!('ancho' in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.ancho is string)
                              && (!('reducirMovimiento'
                                    in request.resource.data.chatApariencia)
                                  || request.resource.data.chatApariencia.reducirMovimiento
                                       is bool)))
                      && (channelId != 'general'
                          || request.resource.data.visibility == 'all');

        // Borrar: todo menos el `general`. El historial se va
        // con el canal (el cliente vacía antes el chat para que
        // no quede legible por rutas antiguas).
        //
        // La única excepción es borrar el club entero: el
        // `general` desaparece en el MISMO lote que el documento
        // del club (`getAfter` lo ve nulo). Así no queda un canal
        // huérfano y nadie puede quitarlo por separado, ni
        // siquiera el propietario.
        allow delete: if isActive()
                      && (puedeGestionarCanales(clubId) || isAdmin())
                      && (channelId != 'general'
                          || getAfter(/databases/$(database)/documents/clubs/$(clubId)) == null);
      }
    }

    // ======================================================
    // RAMAS DE ACTUALIZACIÓN DE UN CHAT
    // ======================================================
    //
    // Las capacidades de `chats/{chatId}` se reparten en varias
    // reglas `allow update` y funciones auxiliares. Cada regla pasa
    // por `isActive()` y evalúa solo su tipo de chat: antes todas
    // las ramas compartían una única expresión y las operaciones
    // legítimas agotaban el límite de 1.000 expresiones de Firestore.
    //
    // El comentario de cada rama explica su capacidad.
    //
    // La semántica es la misma que la de las ramas anteriores:
    //   · admin → todo;
    //   · miembro → vista previa, recibos, ocultar y vaciar SU copia;
    //   · equipo del club → expulsar a uno o meter a un miembro del
    //     equipo en un canal restringido;
    //   · propietario del club → vaciar cualquier chat de su club;
    //   · quien gestiona canales → vaciar un canal temático;
    //   · dueño de grupo → metadatos, expulsar a uno y transferir;
    //   · miembro → salir;
    //   · miembro del club → entrar en un club público.
    //
    // Actualizaciones de un chat de GRUPO. Se sacan a su propia
    // función para que una operación de grupo no evalúe las ramas
    // de club (y no agote el límite de expresiones de Firestore).
    function actualizacionDeChatGrupoPermitida(chatId) {
      let d = request.resource.data;
      let r = resource.data;
      let cambios = d.diff(r).affectedKeys();
      let mismoTipo = d.type == r.type;
      let mismoDueno = d.ownerId == r.ownerId;
      let mismosMiembros = d.memberIds == r.memberIds;
      let esDueno = isChatOwner(chatId);

      // Metadatos del grupo: solo el dueño.
      return (esDueno
              && mismoTipo
              && mismoDueno
              && mismosMiembros
              // `lastMessage*` y las marcas personales (readAt,
              // clearedAt, hiddenFor) ya no se tocan desde aquí:
              // la vista previa la escribe el trigger y cada
              // persona mueve solo la suya.
              && cambios.hasOnly(
                   ['name', 'avatar', 'coverUrl', 'category', 'code']))

          // Expulsar a UN miembro del grupo (el dueño no puede
          // expulsarse a sí mismo: para irse, primero transfiere).
          || (esDueno
              && mismoTipo
              && mismoDueno
              && d.memberIds is list
              && d.memberIds.size() == r.memberIds.size() - 1
              && d.memberIds.hasOnly(r.memberIds)
              // El dueño sigue dentro (y el actor es el dueño), así
              // que no puede expulsarse a sí mismo. No hace falta
              // una comprobación negada, que disparaba el límite de
              // expresiones de Firestore.
              && r.ownerId in d.memberIds
              && cambios.hasOnly(['memberIds', 'hiddenFor']))

          // Transferir la propiedad del grupo a otro miembro.
          || (esDueno
              && mismoTipo
              && d.ownerId != r.ownerId
              && d.ownerId in r.memberIds
              && mismosMiembros
              && cambios.hasOnly(['ownerId']))

          // Salir de un grupo: exactamente una persona menos, y soy
          // yo. El dueño no puede usar esta vía (dejaría el grupo
          // sin administrador); primero transfiere.
          || (isChatMember(chatId)
              && r.ownerId != request.auth.uid
              && mismoTipo
              && mismoDueno
              && d.memberIds is list
              && !(request.auth.uid in d.memberIds)
              && d.memberIds.size() == r.memberIds.size() - 1
              && d.memberIds.hasOnly(r.memberIds)
              && cambios.hasOnly(['memberIds', 'hiddenFor'])
              // Al salir, ocultar solo su propia copia.
              && (!cambios.hasAny(['hiddenFor'])
                  || chatHiddenForSoloCambiaSuUid()));
    }

    // Actualizaciones de un chat de CLUB. Cada capacidad tiene su
    // propia función para no sumar todas las ramas al límite de
    // expresiones.
    //
    // Altas en un chat de club: meter a un miembro del EQUIPO en un
    // canal restringido, o entrar uno mismo en el chat de un club
    // público. La comprobación de campos modificados va al final para
    // que una operación que no sea de alta no pague su coste.
    function actualizacionDeChatClubAltasPermitida(chatId) {
      let d = request.resource.data;
      let r = resource.data;

      return r.type == 'club'
             && d.type == r.type
             && d.ownerId == r.ownerId
             && d.memberIds is list
             && d.memberIds.size() == r.memberIds.size() + 1
             && (
               // Meter a un miembro del EQUIPO en un canal restringido
               // (`mods`). La lista resultante solo puede contener al
               // propietario y a los moderadores: ni un miembro normal
               // puede colarse, ni el equipo puede meter a un tercero.
               (esModeradorClubDeChat(chatId)
                && r.slug is string
                && clubExiste(r.slug)
                && clubData(r.slug).memberIds is list
                && r.memberIds.hasOnly(d.memberIds)
                && d.memberIds.hasOnly(equipoDeClub(clubData(r.slug)))
                && canalRestringido(r.slug, r.channelId))

               // Entrar en el chat de un CLUB PÚBLICO: añadirse a sí
               // mismo. La condición clave es que YA sea miembro del
               // club: antes bastaba con ser un usuario con sesión para
               // meterse en el chat de cualquier club público y leer su
               // historial sin haberse unido.
               //
               // NUNCA en un canal restringido (`mods`), y el canal
               // tiene que existir de verdad. Los chats sin `channelId`
               // son el general histórico, siempre público.
               || (r.slug is string
                   && clubExiste(r.slug)
                   && request.auth.uid in clubData(r.slug).memberIds
                   && clubData(r.slug).accessType == 'public'
                   && (!('channelId' in r)
                       || (r.channelId is string
                           && clubChannelExiste(r.slug, r.channelId)
                           && !canalRestringido(r.slug, r.channelId)))
                   && !(request.auth.uid in r.memberIds)
                   && request.auth.uid in d.memberIds
                   && r.memberIds.hasOnly(d.memberIds))
             )
             && d.diff(r).affectedKeys().hasOnly(['memberIds', 'hiddenFor']);
    }

    // Expulsar a UN miembro de un chat de club. Solo el equipo del
    // club puede hacerlo y el propietario del club no se puede tocar.
    // El tamaño se comprueba antes que el rol y el diff para no gastar
    // expresiones en operaciones que claramente no son una expulsión.
    function actualizacionDeChatClubExpulsionPermitida(chatId) {
      let d = request.resource.data;
      let r = resource.data;

      return r.type == 'club'
             && d.type == r.type
             && d.ownerId == r.ownerId
             && d.memberIds is list
             && d.memberIds.size() == r.memberIds.size() - 1
             && esModeradorClubDeChat(chatId)
             && r.slug is string
             && d.memberIds.hasOnly(r.memberIds)
             && clubData(r.slug).ownerId in d.memberIds
             && d.diff(r).affectedKeys().hasOnly(['memberIds', 'hiddenFor']);
    }

    // Vaciar un chat de club: el propietario al eliminar el club, o
    // quien gestiona canales al eliminar un canal temático.
    function actualizacionDeChatClubVaciadoPermitida() {
      let d = request.resource.data;
      let r = resource.data;

      return r.type == 'club'
             && d.type == r.type
             && d.ownerId == r.ownerId
             && d.memberIds is list
             && d.memberIds.size() == 0
             && (
               (r.slug is string && esPropietarioClub(r.slug))
               || (r.slug is string
                   && r.channelId is string
                   && puedeGestionarCanales(r.slug))
             )
             && d.diff(r).affectedKeys().hasOnly(['memberIds', 'hiddenFor']);
    }

    // Aspecto del chat de club: nombre, avatar y portada. Al editar
    // la ficha se reflejan también en el documento del chat, que es
    // el que pinta la lista de conversaciones. Sin esta rama,
    // `actualizarClub` escribía la ficha y después fallaba al tocar
    // el chat, dejando la lista con el nombre viejo.
    function actualizacionDeChatClubAspectoPermitida() {
      let d = request.resource.data;
      let r = resource.data;

      return r.type == 'club'
             && d.type == r.type
             && d.ownerId == r.ownerId
             && d.memberIds == r.memberIds
             && r.slug is string
             && puedeEditarAspecto(r.slug)
             && d.diff(r).affectedKeys().hasOnly(['name', 'avatar', 'coverUrl']);
    }

    /**
     * Un mapa personal del chat (`readAt`, `clearedAt`) solo puede
     * cambiar en la clave de quien escribe.
     *
     * El cliente escribe el mapa ENTERO (no una ruta anidada), así
     * que no basta con mirar `affectedKeys()` del documento: hay que
     * comparar el mapa con el anterior. Así se conservan las marcas
     * de los demás y solo se mueve la propia. Antes, cualquier
     * miembro podía marcar como leído, limpiar u ocultar el chat a
     * otra persona.
     */
    function chatMapaSoloCambiaSuClave(campo) {
      let d = request.resource.data;
      let r = resource.data;

      return campo in d
             && d[campo] is map
             && request.auth.uid in d[campo]
             && d[campo][request.auth.uid] is timestamp
             && (
               !(campo in r)
               ? d[campo].keys().hasOnly([request.auth.uid])
               : (r[campo] is map
                  && d[campo].diff(r[campo])
                       .affectedKeys().hasOnly([request.auth.uid]))
             );
    }

    /**
     * `hiddenFor` solo puede añadir o quitar el uid de quien escribe.
     *
     * Se compara con la lista anterior en los dos sentidos: para
     * ocultar tiene que conservar todo y añadir solo su uid; para
     * volver a mostrarla, conservar todo y quitar solo su uid.
     */
    function chatHiddenForSoloCambiaSuUid() {
      let d = request.resource.data.hiddenFor;
      let r = resource.data;

      return d is list
             && (
               !('hiddenFor' in r)
               ? d.hasOnly([request.auth.uid])
               : (r.hiddenFor is list
                  && (
                    (d.size() == r.hiddenFor.size() + 1
                     && !(request.auth.uid in r.hiddenFor)
                     && d.hasAll(r.hiddenFor)
                     && d.hasOnly(r.hiddenFor.concat([request.auth.uid])))
                    ||
                    (d.size() == r.hiddenFor.size() - 1
                     && request.auth.uid in r.hiddenFor
                     && r.hiddenFor.hasAll(d)
                     && r.hiddenFor.hasOnly(d.concat([request.auth.uid])))
                  ))
             );
    }

    /**
     * El fijado copia al pie de la letra el mensaje real.
     *
     * Antes solo se comprobaba que el mensaje existiera: el autor,
     * el nombre, el texto y el tipo los ponía el cliente, así que
     * se podía fijar un mensaje citando a un administrador con un
     * texto que nunca escribió. Ahora los campos derivados se
     * contrastan con el documento `messages/{messageId}`.
     *
     * `mensajeCreadoEn` se guarda como texto ISO y las reglas no
     * pueden formatear un Timestamp para compararlo. Por eso el
     * cliente guarda además `mensajeCreadoEnMs`, que la regla sí
     * puede contrastar con `createdAt.toMillis()`. En mensajes
     * antiguos cuyo `createdAt` ya era texto, se compara el texto
     * exacto (la regla no puede convertirlo a milisegundos).
     */
    function fijadoCoincideConMensaje(chatId, messageId) {
      let m = get(/databases/$(database)/documents/chats/$(chatId)/messages/$(messageId)).data;
      let d = request.resource.data;
      let cuerpo = ('body' in m && m.body is string) ? m.body.trim() : '';
      let autorNombre = ('senderName' in m && m.senderName is string)
                        ? m.senderName : '';
      let autorAvatar = ('senderAvatar' in m && m.senderAvatar is string)
                        ? m.senderAvatar : '';
      let fechaOk = (m.createdAt is timestamp
                     ? d.mensajeCreadoEnMs is number
                       && d.mensajeCreadoEnMs == m.createdAt.toMillis()
                       && d.mensajeCreadoEn is string
                       && d.mensajeCreadoEn.size() <= 40
                     : (m.createdAt is string
                        ? d.mensajeCreadoEn == m.createdAt
                          && d.mensajeCreadoEn.size() <= 40
                          && d.mensajeCreadoEnMs is number
                        : false));

      return d.autorId == m.senderId
             && d.autorNombre == autorNombre
             && d.autorAvatar == autorAvatar
             && fechaOk
             && (
               ('gif' in m
                && m.gif is map
                && d.tipo == 'gif'
                && d.texto == (cuerpo.size() > 0 ? cuerpo : 'GIF')
                && (!('gifUrl' in d)
                    || ('url' in m.gif && d.gifUrl == m.gif.url)))
               ||
               ('imageUrl' in m
                && m.imageUrl is string
                && d.tipo == 'image'
                && d.texto == (cuerpo.size() > 0 ? cuerpo : 'Imagen')
                && (!('imagenUrl' in d) || d.imagenUrl == m.imageUrl))
               ||
               (!('gif' in m)
                && !('imageUrl' in m)
                && d.tipo in ['text', 'link']
                // Texto exacto. Antes solo se comparaba el autor y
                // se aceptaba cualquier resumen de hasta 300
                // caracteres, así que un mensaje largo se podía
                // fijar con una frase inventada.
                && d.texto == (cuerpo.size() == 0 ? 'Mensaje sin texto' : cuerpo))
             );
    }

    /**
     * Actualización personal de un chat: recibos, ocultar y vaciar
     * la copia propia. No toca miembros, metadatos ni la vista
     * previa (esa la escribe el servidor).
     */
    function actualizacionPersonalDeChatPermitida() {
      let d = request.resource.data;
      let r = resource.data;
      let cambios = d.diff(r).affectedKeys();

      return r.memberIds.hasAll([request.auth.uid])
             && d.memberIds.size() == r.memberIds.size()
             && cambios.hasOnly(['readAt', 'hiddenFor', 'clearedAt'])
             && (!cambios.hasAny(['readAt'])
                 || chatMapaSoloCambiaSuClave('readAt'))
             && (!cambios.hasAny(['clearedAt'])
                 || chatMapaSoloCambiaSuClave('clearedAt'))
             && (!cambios.hasAny(['hiddenFor'])
                 || chatHiddenForSoloCambiaSuUid());
    }

    // ======================================================
    // CHATS PRIVADOS Y GRUPALES
    // ======================================================
    match /chats/{chatId} {
      // IMPORTANTE: la lectura usa una forma deliberadamente
      // simple, sin condiciones alternativas.
      //
      // Firestore solo puede PROBAR que una consulta es segura si
      // la regla se limita exactamente al campo por el que se
      // filtra. Con "request.auth.uid in resource.data.memberIds"
      // el analizador puede comprobar que
      // "where('memberIds','array-contains', uid)" nunca devuelve
      // conversaciones ajenas, y acepta la consulta.
      //
      // Si esta regla tuviera varias condiciones unidas con "||"
      // (por ejemplo un exists() como alternativa), el analizador
      // no podría probarla y rechazaría la consulta entera con
      // "Missing or insufficient permissions", aunque no hubiera
      // datos privados en juego.
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      // ── Crear un chat ────────────────────────────────
      //
      // Solo hay dos formas legítimas de crear un chat desde
      // el cliente:
      //
      //   · group: nace con UNA sola persona (su creador). Los
      //     demás entran por solicitud o invitación aceptada,
      //     que es lo que hace la Cloud Function.
      //   · club: o se está creando el club (el chat va antes
      //     que la ficha y el club todavía no existe), o es un
      //     canal de un club existente y lo crea el equipo con
      //     permiso de canales.
      //
      // Un chat `direct` NO se crea desde el cliente: lo crea
      // la Cloud Function al aceptar una solicitud. Antes
      // bastaba con escribir el uid de otra persona en
      // `memberIds` para abrirle una conversación sin permiso.
      allow create: if isActive()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.memberIds is list
                    && request.auth.uid in request.resource.data.memberIds
                    && request.resource.data.type in ['group', 'club']
                    // La vista previa y las marcas personales no
                    // pueden nacer falseadas: el emisor es quien
                    // crea, la fecha es la del servidor y `readAt`
                    // solo puede traer su propia clave. Los mensajes
                    // reales mueven la vista previa desde el trigger
                    // `onChatMessageCreated`.
                    && (!('lastMessage' in request.resource.data)
                        || (request.resource.data.lastMessage is string
                            && request.resource.data.lastMessage.size() <= 500))
                    && (!('lastMessageAt' in request.resource.data)
                        || request.resource.data.lastMessageAt == request.time)
                    && (!('lastMessageSenderId' in request.resource.data)
                        || request.resource.data.lastMessageSenderId
                             == request.auth.uid)
                    && (!('hiddenFor' in request.resource.data)
                        || (request.resource.data.hiddenFor is list
                            && request.resource.data.hiddenFor.size() == 0))
                    && (!('readAt' in request.resource.data)
                        || (request.resource.data.readAt is map
                            && request.resource.data.readAt.keys()
                                 .hasOnly([request.auth.uid])
                            && (!(request.auth.uid in request.resource.data.readAt)
                                || request.resource.data.readAt[request.auth.uid]
                                     is timestamp)))
                    && !('clearedAt' in request.resource.data)
                    && (
                      // Grupo normal: solo su creador.
                      (request.resource.data.type == 'group'
                        && request.resource.data.memberIds.size() == 1
                        && !('slug' in request.resource.data)
                        && !('channelId' in request.resource.data))
                      // Chat de club.
                      || (request.resource.data.type == 'club'
                        && request.resource.data.slug is string
                        && request.resource.data.slug.size() >= 3
                        && request.resource.data.slug.size() <= 40
                        && request.resource.data.slug.matches('^[a-z0-9-]+$')
                        && (
                          // Club nuevo: el chat se crea antes que la
                          // ficha, así que el club aún no existe. Solo
                          // puede llevar a su creador.
                          (!clubExiste(request.resource.data.slug)
                            && request.resource.data.memberIds.size() == 1
                            && !('channelId' in request.resource.data))
                          // Canal de un club existente: lo crea el
                          // equipo con permiso de canales. Los
                          // miembros iniciales tienen que ser O todos
                          // los del club (canal público) O exactamente
                          // el equipo (canal `mods`). Nunca una lista
                          // inventada con gente de fuera.
                          || (clubExiste(request.resource.data.slug)
                            && request.resource.data.channelId is string
                            && request.resource.data.channelId.size() >= 1
                            && request.resource.data.channelId.size() <= 30
                            && request.resource.data.channelId.matches('^[a-z0-9-]+$')
                            && puedeGestionarCanales(request.resource.data.slug)
                            && clubData(request.resource.data.slug).memberIds is list
                            && (
                              (request.resource.data.memberIds.hasAll(
                                 clubData(request.resource.data.slug).memberIds)
                               && request.resource.data.memberIds.hasOnly(
                                 clubData(request.resource.data.slug).memberIds))
                              // `mods`: solo el equipo. No se exige
                              // `hasAll` porque `moderatorIds` puede
                              // conservar moderadores antiguos que ya
                              // no están en `memberIds`; el cliente
                              // filtra a los activos. `hasOnly` sigue
                              // impidiendo meter a cualquier miembro
                              // normal o a un tercero, y el dueño
                              // tiene que estar dentro.
                              || (request.resource.data.memberIds.hasOnly(
                                    equipoDeClub(clubData(request.resource.data.slug)))
                                  && clubData(request.resource.data.slug).ownerId
                                       in request.resource.data.memberIds)
                            ))
                        ))
                    );

      // ── Actualizar el chat ──────────────────────────
      // Cada capacidad tiene su propia regla: así Firestore no suma
      // todas las ramas en un único límite de 1.000 expresiones.
      // TODAS pasan por `isActive()`: un baneado global no puede
      // tocar metadatos, miembros, vista previa, prefs ni salir.
      //
      // Un moderador/administrador de club silenciado sigue
      // pasando: `isActive()` es la puerta GLOBAL, no la sanción
      // del club.
      //
      // 1) Admin global: cualquier chat. `isAdmin()` ya exige
      // `isActive()`: un admin baneado no pasa.
      allow update: if isAdmin();

      // 1b) Salir de un chat de club: el miembro se quita a sí mismo.
      // Va antes de la regla de miembro para no gastar el presupuesto
      // de expresiones en su `diff` de campos personales y en las
      // ramas de equipo. El `diff` de aquí ya impide tocar type,
      // ownerId o cualquier otro campo.
      //
      // El `type == 'club'` va ANTES de `isActive()`: así una
      // actualización de un grupo no paga esta comprobación en las
      // cuatro ramas de club. Sin ese orden, las operaciones de
      // grupo agotaban el límite de 1.000 expresiones.
      allow update: if resource.data.type == 'club'
                    && isActive()
                    && request.resource.data.memberIds is list
                    && resource.data.memberIds.hasAll([request.auth.uid])
                    && !(request.auth.uid in request.resource.data.memberIds)
                    && request.resource.data.memberIds.size()
                         == resource.data.memberIds.size() - 1
                    && request.resource.data.memberIds.hasOnly(resource.data.memberIds)
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['memberIds', 'hiddenFor'])
                    // Al salir solo puede ocultarse el chat a sí
                    // mismo, no a los demás miembros.
                    && (!request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['hiddenFor'])
                        || chatHiddenForSoloCambiaSuUid());

      // 1c) Altas en un chat de club: el equipo mete a un miembro del
      // equipo en un canal restringido, o un miembro del club entra en
      // el chat público. Va antes de la regla de miembro y de las
      // ramas de expulsión/vaciado.
      allow update: if resource.data.type == 'club'
                    && isActive()
                    && actualizacionDeChatClubAltasPermitida(chatId);

      // 1d) Expulsar a UN miembro de un chat de club.
      allow update: if resource.data.type == 'club'
                    && isActive()
                    && actualizacionDeChatClubExpulsionPermitida(chatId);

      // 1e) Vaciar un chat de club (propietario o gestor de canales).
      allow update: if resource.data.type == 'club'
                    && isActive()
                    && actualizacionDeChatClubVaciadoPermitida();

      // 1f) Aspecto del chat de club (nombre, avatar y portada). Lo
      // hace `actualizarClub` al guardar la configuración, para que
      // la lista de conversaciones no se quede con los datos viejos.
      allow update: if resource.data.type == 'club'
                    && isActive()
                    && actualizacionDeChatClubAspectoPermitida();

      // 2) Miembro: recibos, ocultar y vaciar SU copia. También cubre
      // al dueño/miembro de un grupo (metadatos, expulsar, transferir,
      // salir). Una sola evaluación de `isActive()` para las dos
      // capacidades: antes cada rama la repetía y una transferencia
      // de grupo agotaba el límite de 1.000 expresiones.
      //
      // La vista previa (`lastMessage*`) ya NO está aquí: la escribe
      // el trigger desde el mensaje real. Antes, un miembro podía
      // falsear el remitente o el texto para todos.
      allow update: if isActive()
                    && (actualizacionPersonalDeChatPermitida()
                        || (resource.data.type == 'group'
                            && actualizacionDeChatGrupoPermitida(chatId)));

      // Borrar el documento del chat. Un grupo lo puede borrar su
      // dueño (es lo que hace el borrado de cuenta). Un privado,
      // NO: borrarlo le quitaría el historial a la otra persona;
      // para eso está `hiddenFor`. Los chats de club los borra
      // solo el propietario del club.
      allow delete: if isActive()
                    && (isAdmin()
                        || (resource.data.type == 'group' && isChatOwner(chatId))
                        || (resource.data.type == 'club'
                            && resource.data.slug is string
                            && esPropietarioClub(resource.data.slug)));

      // La subcolección `members` es histórica y no la usa el
      // cliente actual. Se deja solo para el personal: antes
      // cualquier usuario con sesión podía leer la lista de
      // miembros de CUALQUIER chat conociendo su id.
      match /members/{uid} {
        allow read: if isChatMember(chatId) || isAdmin();
        allow create, update, delete: if isActive() && isAdmin();
      }

      // ── Preferencias personales por conversación ─────
      //
      // `chats/{chatId}/prefs/{uid}` guarda el color, apodo y
      // avisos que el usuario ve SOLO en su pantalla. No es
      // compartido: cada participante tiene sus prefs en su
      // propio doc, y lo que pinta sale de las suyas.
      //
      //   · leer: cualquier miembro del chat (solo ve la suya).
      //   · escribir: solo el dueño del doc (isSelf), y solo
      //     campos con formato válido.
      match /prefs/{uid} {
        allow read: if isSignedIn() && isSelf(uid);
        // En create, resource.data es null: no se puede diff().
        allow create: if isActive()
                      && isSelf(uid)
                      && chatPrefsValida(request.resource.data);
        // En update, resource.data existe: diff() indica qué campos
        // cambiaron. hasAny permite tocar solo los de prefs.
        allow update: if isActive()
                      && isSelf(uid)
                      && request.resource.data.diff(resource.data)
                           .affectedKeys()
                           .hasAny(['color', 'nickname', 'notify', 'muteUntil', 'favorite',
                                       'fondo'])
                      && chatPrefsValida(request.resource.data);
        allow delete: if isActive() && isSelf(uid);
      }

      // ── Mensajes fijados ──────────────────────────────
      //
      // `chats/{chatId}/fijados/{messageId}`: un documento por
      // mensaje fijado, con el id del MENSAJE. Por eso no se
      // puede fijar dos veces el mismo (el documento ya
      // existiría) y por eso las reglas pueden comprobar la
      // ruta exacta sin hacer ninguna consulta.
      //
      // El texto se copia aquí, así el panel se pinta sin
      // descargar el historial del chat.
      match /fijados/{messageId} {
        allow read: if isChatMember(chatId);

        allow create: if isChatMember(chatId)
                      && isActive()
                      && puedeFijarEnChat(chatId)
                      && request.resource.data.chatId == chatId
                      && request.resource.data.messageId == messageId
                      // No se puede inventar quién lo fijó.
                      && request.resource.data.fijadoPor == request.auth.uid
                      && request.resource.data.fijadoPorNombre is string
                      && request.resource.data.autorId is string
                      && request.resource.data.autorNombre is string
                      && request.resource.data.autorAvatar is string
                      && request.resource.data.texto is string
                      // Como máximo, el mismo tamaño que un mensaje
                      // (`body <= 4000`). Se guarda el texto entero
                      // para poder compararlo con el original.
                      && request.resource.data.texto.size() <= 4000
                      && request.resource.data.tipo is string
                      && request.resource.data.mensajeCreadoEn is string
                      // Y el mensaje tiene que existir de verdad:
                      // no se puede fijar algo que no está.
                      && exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(messageId))
                      // Autor, texto y tipo se copian del mensaje
                      // real, no de lo que diga el cliente.
                      && fijadoCoincideConMensaje(chatId, messageId);

        // Quitar es borrar el documento: el historial de lo
        // que se fijó no hace falta conservarlo, y así no
        // hay forma de reescribir un fijado.
        allow delete: if isActive() && puedeDesfijar(chatId, messageId);

        // No se edita: para cambiar un fijado se quita y se
        // vuelve a fijar.
        allow update: if false;
      }
      match /messages/{messageId} {
        allow read: if isChatMember(chatId);

        // Un mensaje puede no tener texto si lleva un GIF (un
        // "respondió con un GIF" es un meme más viejo que los
        // chats), pero tiene que llevar algo. Lo mismo vale para
        // una encuesta: un mensaje puede ser SOLO la encuesta.
        //
        // El GIF no se sube a Storage: se guarda su ficha y el
        // archivo se sigue sirviendo desde el CDN del proveedor,
        // así que `gifValido` comprueba que las URLs sean de
        // verdad de media.giphy.com o media.tenor.com. Sin eso,
        // el campo serviría para colgar cualquier URL.
        //
        // `tieneAlgo` recoge los cinco tipos de adjunto. Se usa una
        // función en vez de repetir la condición porque son cinco
        // ramas y el motivo de cada una ya está commented en la
        // definición.
        allow create: if isChatMember(chatId)
                      && isActive()
                      && puedeEscribirEnChat(chatId)
                      && !bloqueoEnDirecto(chatId)
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.body is string
                      && request.resource.data.body.size() <= 4000
                      && tieneAlgo(request.resource.data)
                      && (!('gif' in request.resource.data)
                          || gifValido(request.resource.data.gif))
                      && (!('location' in request.resource.data)
                          || ubicacionValida(request.resource.data.location))
                      // La encuesta viaja dentro del mensaje. Se
                      // exige forma válida (`pollValido`, la misma
                      // que en los hilos) para que no sirva para
                      // colar datos arbitrarios en el documento.
                      && (!('poll' in request.resource.data)
                          || pollValido(request.resource.data.poll))
                      // La tier list viaja igual: solo id y título
                      // acotados. El contenido vive en su documento.
                      && (!('tierList' in request.resource.data)
                          || tierRefValida(request.resource.data.tierList))
                      // La cita es una foto fija del citado. Antes solo
                      // se validaba la forma, así que se podía citar un
                      // mensaje inexistente, atribuírselo a otro y
                      // ponerle el texto que quisieras. Ahora se lee el
                      // mensaje REAL de este chat y se comparan autor y
                      // texto canónico completo.
                      && (!('replyTo' in request.resource.data)
                          || (request.resource.data.replyTo is map
                              && request.resource.data.replyTo.messageId is string
                              && citaCoincideConMensaje(
                                   chatId, request.resource.data.replyTo)));

        // Los mensajes solo los toca el servidor (borrado para
        // todos vía `eliminarMensajeParaTodos`, que comprueba
        // autoría y 2 horas con su reloj).
        //
        // Antes el autor podía actualizar y borrar lo suyo sin más
        // checks. Eso permitía reescribir el texto sin dejar rastro,
        // borrar físicamente sin control de plazo y, peor, marcar
        // `deletedForEveryone` a mano saltándose la ventana de 2
        // horas. Por eso actualizar y destruir quedan en manos del
        // admin (la Function usa el Admin SDK y no pasa por aquí).
        //
        // LA EXCEPCIÓN ES LA MODERACIÓN DE UN CLUB: un moderador
        // del club al que pertenece el chat puede retirar el
        // contenido de un mensaje. Solo eso, y con condiciones:
        //
        //   · no puede restaurarlo (el contenido se VACÍA, no se
        //     rellena: `body` pasa a '' y se pone
        //     `deletedByMod` en true);
        //   · no puede tocar el autor ni la fecha de creación;
        //   · solo los cuatro campos del marcador.
        //
        // Sin esta rama, el botón de "eliminar mensaje" del
        // moderador daría permission-denied y el club no podría
        // mantener el orden del grupo.
        allow update: if isActive()
                             && (isAdmin()
                                 || (puedeRetirarMensajesDeChat(chatId)
                                     // El `diff` va ANTES de leer `body`:
                                     // en una actualización de encuesta
                                     // esa clave no existe y el acceso
                                     // directo lanzaba un error de
                                     // evaluación en vez de un simple
                                     // «no».
                                     && request.resource.data.diff(resource.data)
                                          .affectedKeys().hasOnly(
                                            ['body', 'deletedForEveryone', 'deletedAt',
                                             'deletedBy', 'deletedByMod'])
                                     && request.resource.data.body == ''
                                     && request.resource.data.deletedForEveryone == true
                                     && request.resource.data.createdAt == resource.data.createdAt
                                     && request.resource.data.senderId == resource.data.senderId));

        // Borrar el documento es solo del equipo global: la
        // moderación de club VACÍA el mensaje (update), no lo
        // destruye, para no romper las citas ni los contadores.
        allow delete: if isActive() && isAdmin();

        // Cerrar (o reabrir) la encuesta del mensaje.
        //
        // Lo puede hacer el AUTOR del mensaje y, en chats de
        // club, un moderador del club. Solo cambia `isClosed`:
        // `pollMensajeSoloCambiaIsClosed` comprueba que la
        // pregunta, las opciones, la caducidad y el cambio de
        // voto queden idénticos, igual que en los hilos.
        //
        // Autor del mensaje. Se comprueba el `diff` antes de
        // resolver la membresía: es barato y descarta cualquier
        // actualización que no sea el cierre de la encuesta.
        allow update: if isActive()
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['poll.isClosed', 'poll'])
                      && resource.data.senderId == request.auth.uid
                      && isChatMember(chatId)
                      && pollMensajeSoloCambiaIsClosed();

        // Moderador del club (dueño, moderadores y adminIds).
        allow update: if isActive()
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['poll.isClosed', 'poll'])
                      && esModeradorClubDeChat(chatId)
                      && pollMensajeSoloCambiaIsClosed();

        // ── VOTOS DE LA ENCUESTA ────────────────────────
        //
        // Un documento por persona (el id es el uid), igual que
        // en los hilos: no hay forma física de tener dos votos.
        // Solo vota quien es miembro del chat, y la opción tiene
        // que existir en la encuesta del mensaje.
        //
        // El voto es PRIVADO: solo lo lee quien votó. Los totales
        // salen de `pollStats/summary`, que mantiene la Cloud
        // Function. Antes lo leía cualquier miembro del chat.
        match /pollVotes/{uid} {
          allow get: if isChatMember(chatId) && isSelf(uid);
          allow list: if false;

          allow create: if isChatMember(chatId)
                        && isActive()
                        && request.auth.uid == uid
                        && pollMensajeAbierto(chatId, messageId)
                        && request.resource.data.userId == request.auth.uid
                        && request.resource.data.optionId is string
                        && request.resource.data.optionId
                             in pollDelMensaje(chatId, messageId).options
                        && request.resource.data.keys().hasOnly(
                             ['userId', 'optionId', 'createdAt']);

          // Cambiar de opción, solo si el autor lo permitió. Los
          // campos de identification (userId, createdAt) son
          // intocables.
          allow update: if isChatMember(chatId)
                        && isActive()
                        && request.auth.uid == uid
                        && pollMensajeAbierto(chatId, messageId)
                        && pollMensajeCambiaVotos(chatId, messageId)
                        && request.resource.data.optionId
                             in pollDelMensaje(chatId, messageId).options
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['optionId', 'updatedAt']);

          // Desvotar no existe, igual que en los hilos. Borrar un
          // voto es moderación: el admin global o un moderador
          // del club. No lo pueden LEER, pero sí borrar un
          // documento cuyo id ya conozcan.
          allow delete: if isActive()
                        && (isAdmin() || esModeradorClubDeChat(chatId));
        }

        // ── RESUMEN DE LA ENCUESTA DEL MENSAJE ─────────
        //
        // Lo escribe SOLO la Cloud Function
        // `onChatPollVotesChanged`. El cliente lo lee para pintar
        // resultados, pero no puede modificarlo. El id es siempre
        // `summary`; no se permite listar la subcolección.
        match /pollStats/{statsId} {
          allow get: if statsId == 'summary'
                      && (isChatMember(chatId) || isAdmin());
          allow list: if false;
          allow write: if false;
        }
      }

      // Recibos de lectura: se guardan en un mapa "readAt" DENTRO
      // del propio chat (chats/{id}.readAt = { uid: Timestamp }).
      // No hay subcolección. Así no hace falta una suscripción
      // por conversación para saber cuáles están sin leer, porque
      // el documento del chat ya se descarga entero.
      //
      // Consecuencia: un miembro puede escribir la clave de otro
      // dentro de readAt, es decir, falsear que ha leído. Solo
      // afecta a los ticks de sus propios mensajes, y el impacto
      // es cosmético. Impedirlo exigiría comparar mapas clave a
      // clave, que las reglas no saben hacer.
    }

    // ======================================================
    // CONTENIDO EDITABLE DEL SITIO
    // ======================================================
    // Textos y logo que el admin/moderador cambia sin tocar código. Un
    // único documento en vez de una colección entera de
    // ajustes, porque solo hay unos pocos valores.
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isModerator();
    }

    // "Obras de la semana": lo que se destaca en la portada.
    match /weeklyWorks/{workId} {
      allow read: if true;
      allow write: if isAdmin() || isModerator();
    }

    // ======================================================
    // TICKETS DE SOPORTE
    // ======================================================
    match /support_tickets/{ticketId} {
      allow create: if isActive()
                    && request.resource.data.category in
                       ['bug', 'suggestion', 'account', 'report']
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() > 0
                    && request.resource.data.subject.size() <= 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isModerator();
    }

    // ======================================================
    // METADATOS INTERNOS (control de la siembra de datos)
    // ======================================================
    match /meta/{docId} {
      allow read, write: if isAdmin();
    }

    // ======================================================
    // GAMIFICACION
    // ======================================================
    // Un unico documento con la curva de niveles, el valor de cada
    // recompensa y los ids de anime de las medallas tematicas.
    //
    // Se lee desde el cliente para pintar los rangos y las barras,
    // y desde las funciones para conceder el XP. Que sea legible
    // por cualquiera es a proposito: no hay nada secreto en el y
    // asi el panel puede leerlo sin pedir permiso.
    //
    // Se escribe por el panel, que lo hace con una Cloud Function
    // callable (ver `configurarGamificacion`). Aqui se deja el
    // permiso al admin por si hay que corregirlo a mano desde la
    // consola, pero el camino normal es la funcion, que valida los
    // numeros antes de guardarlos.
    match /gamification/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Cualquier otra ruta queda bloqueada por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
