{
  "indexes": [
    {
      "_comment": "Barra pública de reacciones: un hilo o comentario se consulta por targetType + targetId in.",
      "collectionGroup": "reactions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "targetType", "order": "ASCENDING" },
        { "fieldPath": "targetId", "order": "ASCENDING" }
      ]
    },
    {
      "_comment": "Reacciones de mensajes privados: se consultan por chat y tipo; la regla exige pertenencia al chat.",
      "collectionGroup": "reactions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "targetType", "order": "ASCENDING" },
        { "fieldPath": "chatId", "order": "ASCENDING" },
        { "fieldPath": "targetId", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "comments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "targetType", "order": "ASCENDING" },
        { "fieldPath": "targetId", "order": "ASCENDING" }
      ]
    },
    {
      "_comment": "Comentarios del hilo/episodio/personaje abierto: los 50 más recientes.",
      "collectionGroup": "comments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "targetType", "order": "ASCENDING" },
        { "fieldPath": "targetId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "Actividad de comentarios de un perfil, de la más reciente a la más antigua.",
      "collectionGroup": "comments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "authorId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "Perfil: suma de reacciones de todos los comentarios de un autor.",
      "collectionGroup": "comments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "authorId", "order": "ASCENDING" },
        { "fieldPath": "reactionsTotal", "order": "ASCENDING" }
      ]
    },
    {
      "_comment": "Comentarios que le gustaron a un perfil.",
      "collectionGroup": "comments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "likedBy", "arrayConfig": "CONTAINS" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "comments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "targetType", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "comments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "targetId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "threads",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "categoryId", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "collectionGroup": "threads",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "poll.isClosed", "order": "ASCENDING" },
        { "fieldPath": "poll.expiresAt", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "episodes",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "animeId", "order": "ASCENDING" },
        { "fieldPath": "number", "order": "ASCENDING" }
      ]
    },
    {
      "_comment": "Ficha paginada: episodios de una serie filtrados por temporada y ordenados por número.",
      "collectionGroup": "episodes",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "animeId", "order": "ASCENDING" },
        { "fieldPath": "seasonId", "order": "ASCENDING" },
        { "fieldPath": "number", "order": "ASCENDING" }
      ]
    },
    {
      "_comment": "Ficha: personajes de una serie filtrados por temporada. Incluye los compartidos con '*'.",
      "collectionGroup": "characters",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "animeId", "order": "ASCENDING" },
        { "fieldPath": "seasonKeys", "arrayConfig": "CONTAINS" }
      ]
    },
    {
      "_comment": "Dónde verla: la wiki pide solo la obra y la región seleccionadas.",
      "collectionGroup": "streamingAvailability",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "animeId", "order": "ASCENDING" },
        { "fieldPath": "region", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "chats",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "memberIds", "arrayConfig": "CONTAINS" },
        { "fieldPath": "lastMessageAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "Descubrir clubes por categoría, ordenados por número de miembros (popularidad).",
      "collectionGroup": "clubs",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "category", "order": "ASCENDING" },
        { "fieldPath": "memberCount", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "Descubrir clubes públicos/por solicitud, ordenados por popularidad. Lo exige el where accessType in + orderBy memberCount de listarClubes.",
      "collectionGroup": "clubs",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "accessType", "order": "ASCENDING" },
        { "fieldPath": "memberCount", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "Descubrir clubes por categoría dentro de públicos/por solicitud. Lo exige el where accessType in + where category == + orderBy memberCount.",
      "collectionGroup": "clubs",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "accessType", "order": "ASCENDING" },
        { "fieldPath": "category", "order": "ASCENDING" },
        { "fieldPath": "memberCount", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "Solicitudes de acceso a un club: las pendientes, de la más nueva a la más antigua.",
      "collectionGroup": "requests",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "_comment": "Mis tier lists: las del autor, de la más reciente a la más antigua. Lo exige el where authorId == + orderBy updatedAt de subscribeMisTierLists.",
      "collectionGroup": "tierlists",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "authorId", "order": "ASCENDING" },
        { "fieldPath": "updatedAt", "order": "DESCENDING" }
      ]
    }
  ],
  "fieldOverrides": [
    {
      "_comment": "Recalculo: collectionGroup(channels).where(createdBy==). Un solo campo no va en indexes[], sino aqui.",
      "collectionGroup": "channels",
      "fieldPath": "createdBy",
      "indexes": [
        { "order": "ASCENDING", "queryScope": "COLLECTION" },
        { "order": "ASCENDING", "queryScope": "COLLECTION_GROUP" },
        { "order": "DESCENDING", "queryScope": "COLLECTION" },
        { "order": "DESCENDING", "queryScope": "COLLECTION_GROUP" }
      ]
    },
    {
      "_comment": "Recalculo: collectionGroup(messages).where(senderId==). Un solo campo no va en indexes[], sino aqui.",
      "collectionGroup": "messages",
      "fieldPath": "senderId",
      "indexes": [
        { "order": "ASCENDING", "queryScope": "COLLECTION" },
        { "order": "ASCENDING", "queryScope": "COLLECTION_GROUP" },
        { "order": "DESCENDING", "queryScope": "COLLECTION" },
        { "order": "DESCENDING", "queryScope": "COLLECTION_GROUP" }
      ]
    }
  ]
}